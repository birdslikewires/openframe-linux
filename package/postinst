#!/bin/sh

# openframe-scripts postinst
#  The kernel hooks now come from this package, in /usr/share/kernel. Older images put
#  copies in /etc/kernel, which would override them, so those are removed.
#
#  Then, once per system, the kernel is switched to booting directly through its EFI
#  stub, which saves around ten seconds per boot. Anyone who later runs
#  'of-settings efistub disable' keeps GRUB, because the marker stops this repeating.
#  An image build writes its own boot.nsh (of-imgcreate.sh), and the image's first
#  boot rewrites it for the unit (of-identifier).
#  Systems on the internal memory had to keep GRUB until the firmware's MMC driver
#  could be worked around (of-bootnsh); once per system they switch now too.
#
#  Every update then tidies the boot volume so the next initrd rebuild fits, and
#  rewrites boot.nsh, which boots the kernel without its initrd once the kernel can
#  (of-bootnsh). The initrd used to check the root filesystem at every boot, so
#  once per system systemd is set to do it instead.
#
#  Also once per system, for power cuts (which on an OpenFrame are normal): an ext2
#  root gets a journal, becoming ext4; /boot is mounted read-only (dpkg and the
#  scripts make it writable while they write) and checked at boot; and a service
#  finishes package operations a cut interrupted.

set -e

MARKER="/var/lib/openframe-scripts/efistub-default"
FSCKMARKER="/var/lib/openframe-scripts/root-fsck-default"
JOURNALMARKER="/var/lib/openframe-scripts/root-journal-default"
BOOTROMARKER="/var/lib/openframe-scripts/boot-ro-default"
RECOVERMARKER="/var/lib/openframe-scripts/dpkg-recover-default"
DIRSYNCMARKER="/var/lib/openframe-scripts/boot-dirsync-default"
MMCMARKER="/var/lib/openframe-scripts/mmc-stub-default"
FWREPOMARKER="/var/lib/openframe-scripts/firmware-repo-default"
MACGATEMARKER="/var/lib/openframe-scripts/mac-gate-default"
SLIMMARKER="/var/lib/openframe-scripts/slim-default"
IFUPDOWNMARKER="/var/lib/openframe-scripts/ifupdown-default"
I2CMARKER="/var/lib/openframe-scripts/i2c-open-default"
BACKLIGHTMARKER="/var/lib/openframe-scripts/backlight-service-default"
UNUSEDMARKER="/var/lib/openframe-scripts/unused-default"
SETTINGSMARKER="/var/lib/openframe-scripts/settings-folder-default"
FLASHMARKER="/var/lib/openframe-scripts/flash-service-default"
SSHKEYSMARKER="/var/lib/openframe-scripts/ssh-keys-service-default"
SSHSETTINGSMARKER="/var/lib/openframe-scripts/ssh-settings-default"
REGDBMARKER="/var/lib/openframe-scripts/regdb-upstream-default"
UPDATESMARKER="/var/lib/openframe-scripts/auto-updates-default"
TESTSETTINGSMARKER="/var/lib/openframe-scripts/test-settings-default"
UPDATETIMEMARKER="/var/lib/openframe-scripts/update-time-default"
NAMEMARKER="/var/lib/openframe-scripts/name-default"
AUDIOMARKER="/var/lib/openframe-scripts/audio-default"

# True inside a chroot, as when an image is being built.
in_chroot() {
	systemd-detect-virt -q --chroot 2>/dev/null
}

case "$1" in
	configure)

		rm -f /etc/kernel/preinst.d/openframe-boot-prep /etc/kernel/postinst.d/openframe-grub-update

		# An image build can't tell what firmware will start the image (on the internal
		# memory that matters, see of-bootnsh): of-imgcreate.sh writes the image's
		# boot.nsh, and first boot (of-identifier) rewrites it. The marker still goes in,
		# so this doesn't switch an image's system back after 'of-settings efistub disable'.
		if [ ! -e "$MARKER" ] && in_chroot; then
			mkdir -p "${MARKER%/*}"
			touch "$MARKER"
		elif [ ! -e "$MARKER" ] && [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			if /usr/local/sbin/of-bootnsh stub; then
				mkdir -p "${MARKER%/*}"
				touch "$MARKER"
				grep -q vmlinuz /boot/boot.nsh &&
					echo "OpenFrame now boots the kernel through its EFI stub. To go back to GRUB, run 'sudo of-settings efistub disable'."
			else
				echo "Could not switch to EFI stub boot; GRUB boot is unchanged."
			fi
		fi

		# Systems on the internal memory were kept on GRUB, because the firmware loaded
		# the kernel corrupted from there. of-bootnsh now starts it directly when the
		# firmware is fixed or BlwMmcFix.efi can fix it, and keeps GRUB when not. Once
		# per system; an image's first boot chooses for itself.
		if [ ! -e "$MMCMARKER" ]; then
			if ! in_chroot && [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ] && ! grep -q vmlinuz /boot/boot.nsh; then
				BOOTSRC=$(findmnt -n -o SOURCE --target /boot 2>/dev/null || true)
				if [ -b "$BOOTSRC" ] && lsblk -n -o PKNAME "$BOOTSRC" 2>/dev/null | head -1 | grep -q '^mmcblk'; then
					/usr/local/sbin/of-bootnsh stub >/dev/null 2>&1 || true
					grep -q vmlinuz /boot/boot.nsh &&
						echo "OpenFrame now boots the kernel from its internal memory through its EFI stub. To go back to GRUB, run 'sudo of-settings efistub disable'."
				fi
			fi
			mkdir -p "${MMCMARKER%/*}"
			touch "$MMCMARKER"
		fi

		# Without an initrd nothing checks the root filesystem before it's mounted, so
		# let systemd check it (fsck pass 1). ext2 has no journal: after a power cut it
		# needs the check. Only an ext2/3/4 root still at 0, and only once, so a later
		# choice of 0 stays.
		if [ ! -e "$FSCKMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext[234][[:space:]]/ s/([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\11/' /etc/fstab
			mkdir -p "${FSCKMARKER%/*}"
			touch "$FSCKMARKER"
		fi

		# Give an ext2 root a journal, making it ext4. After a power cut a journaled
		# filesystem replays its last few seconds in a moment; ext2 needs a full check,
		# which can stop at a prompt nobody will answer. tune2fs adds the journal to the
		# mounted filesystem, and fstab and grub.cfg name it ext4 from the next boot.
		if [ ! -e "$JOURNALMARKER" ] && ! in_chroot; then
			ROOTDEV=$(findmnt -n -o SOURCE /)
			if [ "$(findmnt -n -o FSTYPE /)" = ext2 ] && [ -b "$ROOTDEV" ] &&
			   awk '$2 == "/" && $3 == "ext2" { f = 1 } END { exit !f }' /etc/fstab; then
				echo "Adding a journal to the root filesystem (ext2 to ext4)..."
				if tune2fs -j -J size=32 "$ROOTDEV" >/dev/null; then
					sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext2[[:space:]]/ s/^([^[:space:]]+[[:space:]]+\/[[:space:]]+)ext2/\1ext4/' /etc/fstab
					# A synced copy renamed over the old one: FAT has no journal.
					[ -f /boot/grub.cfg ] && sed 's/rootfstype=ext2/rootfstype=ext4/' /boot/grub.cfg > /boot/grub.cfg.new &&
						sync && mv -f /boot/grub.cfg.new /boot/grub.cfg
					sync
				else
					echo "Could not add the journal; the root filesystem stays ext2."
				fi
			fi
			mkdir -p "${JOURNALMARKER%/*}"
			touch "$JOURNALMARKER"
		fi

		# /boot read-only (dpkg and our scripts make it writable while they write),
		# checked at boot, and no access-time writes: a power cut can then only catch it
		# during an update. dirsync puts each directory change (a new file, a rename, a
		# removal) on disk at once, so a cut mid-update can't leave a name pointing at
		# clusters something else has since reused. Takes effect at the next boot. Only
		# a /boot line still at 'defaults 0 0', so a different choice stays.
		if [ ! -e "$BOOTROMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]+vfat[[:space:]]/ s/([[:space:]]+vfat[[:space:]]+)defaults([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\1ro,noatime,dirsync\22/' /etc/fstab
			mkdir -p "${BOOTROMARKER%/*}"
			touch "$BOOTROMARKER"
		fi

		# Systems that took the read-only /boot before it gained dirsync (26.11.17) get
		# it too, from the next boot. Only a /boot line at exactly 'ro,noatime'.
		if [ ! -e "$DIRSYNCMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]+vfat[[:space:]]/ s/([[:space:]]+vfat[[:space:]]+)ro,noatime([[:space:]])/\1ro,noatime,dirsync\2/' /etc/fstab
			mkdir -p "${DIRSYNCMARKER%/*}"
			touch "$DIRSYNCMARKER"
		fi

		# Finish package operations a power cut interrupted, at every boot.
		if [ ! -e "$RECOVERMARKER" ]; then
			systemctl enable --quiet of-dpkg-recover.service 2>/dev/null || true
			mkdir -p "${RECOVERMARKER%/*}"
			touch "$RECOVERMARKER"
		fi

		# Hold the login prompt and any UI while the unit reboots to store its MAC in
		# NVRAM (of-mac-gate, see of-bootnsh). Once per system, so disabling it sticks.
		if [ ! -e "$MACGATEMARKER" ]; then
			systemctl enable --quiet of-mac-gate.service 2>/dev/null || true
			mkdir -p "${MACGATEMARKER%/*}"
			touch "$MACGATEMARKER"
		fi

		# Images built before March 2026 put an old Go yq (2.1.1) in /usr/local/bin, ahead
		# of Debian's yq in PATH; of-netplan is written for Debian's. Remove it, but only
		# if it's exactly the one those images shipped, so a yq someone installed stays.
		if [ -f /usr/local/bin/yq ] &&
		   [ "$(md5sum < /usr/local/bin/yq | cut -d' ' -f1)" = aa1a350d3760a4c7d1abe014c07978f5 ]; then
			rm -f /usr/local/bin/yq
		fi

		# Once per system, make room the way new images do (November 2026). apt keeps its
		# lists small from now on (apt.conf.d/50openframe-slim); this comments out the
		# deb-src lines images had in sources.list (about 110 MB of source lists and
		# cache, for 'apt source', which nobody runs here), drops the source package
		# cache, and removes translated program messages (about 57 MB), which dpkg leaves
		# out from now on (dpkg.cfg.d/openframe-nolocale). The next 'apt update' clears
		# the lists nothing uses any more. Uncommenting deb-src afterwards keeps it.
		if [ ! -e "$SLIMMARKER" ] && ! in_chroot; then
			if [ -f /etc/apt/sources.list ] && grep -q '^deb-src ' /etc/apt/sources.list; then
				sed 's/^deb-src /# deb-src /' /etc/apt/sources.list > /etc/apt/sources.list.new &&
					mv -f /etc/apt/sources.list.new /etc/apt/sources.list
			fi
			rm -f /var/cache/apt/srcpkgcache.bin
			find /usr/share/locale -path '*/LC_MESSAGES/*.mo' -delete 2>/dev/null || true
			mkdir -p "${SLIMMARKER%/*}"
			touch "$SLIMMARKER"
		fi

		# Once per system: images used to come with ifupdown, whose networking.service costs
		# about 1.8 s of every boot while netplan and systemd-networkd do the actual work.
		# New images leave it out; here it's only switched off, and only if its files
		# configure nothing but loopback. Enabling it again keeps it.
		if [ ! -e "$IFUPDOWNMARKER" ] && ! in_chroot; then
			if systemctl is-enabled --quiet networking.service 2>/dev/null &&
			   ! cat /etc/network/interfaces /etc/network/interfaces.d/* 2>/dev/null |
			     awk '($1 == "auto" || $1 ~ /^allow-/) { for (i = 2; i <= NF; i++) if ($i != "lo") f = 1 }
			          $1 == "iface" && $2 != "lo" { f = 1 }
			          END { exit !f }'; then
				systemctl disable --quiet networking.service 2>/dev/null || true
			fi
			mkdir -p "${IFUPDOWNMARKER%/*}"
			touch "$IFUPDOWNMARKER"
		fi

		# Once per system: images used to open every i2c bus to every user
		# (/etc/udev/rules.d/70-i2c.rules), so the old readlightsensor ran without
		# root. The light sensor now has a kernel driver anyone can read, so the buses go
		# back to Debian's default: root and the i2c group. Only our exact rule is
		# removed; an edited one is someone's choice and stays.
		if [ ! -e "$I2CMARKER" ] && ! in_chroot; then
			I2CRULE=/etc/udev/rules.d/70-i2c.rules
			if [ -f "$I2CRULE" ] && [ "$(tr -d ' \t\n' < "$I2CRULE")" = 'KERNEL=="i2c-[0-9]*",MODE="0666"' ]; then
				rm -f "$I2CRULE"
				udevadm control --reload 2>/dev/null || true
				udevadm trigger --action=change --subsystem-match=i2c-dev 2>/dev/null || true
			fi
			mkdir -p "${I2CMARKER%/*}"
			touch "$I2CMARKER"
		fi

		# Once per system: the backlight service (of-backlight.service), which does the
		# fades, fixed levels and automatic brightness for 'of-backlight'. It keeps the
		# level a system already has until someone asks for another or for 'auto'.
		# Disabling the service afterwards sticks.
		if [ ! -e "$BACKLIGHTMARKER" ]; then
			systemctl enable --quiet of-backlight.service 2>/dev/null || true
			in_chroot || systemctl start of-backlight.service 2>/dev/null || true
			mkdir -p "${BACKLIGHTMARKER%/*}"
			touch "$BACKLIGHTMARKER"
		fi

		# Once per system: the settings folder on the boot volume (OF-BOOT/settings), which
		# holds what anyone may edit from any computer, as new images have it. backlight.txt
		# moves into it from the root: the one first shipped (1:26.11.50) becomes the
		# shorter one, an edited one moves as it is (of-backlight reads either), and a
		# system without one gets one. network.yaml is of-netplan's to move, at the next
		# boot (it becomes wifi.txt, or settings/network.yaml). setup.txt works in either
		# place, so it stays where it is. A Mac's companion file (._backlight.txt) goes with
		# the original.
		if [ ! -e "$SETTINGSMARKER" ] && [ -d /boot ]; then
			SETDIR=/boot/settings
			SETSRC=/usr/lib/openframe/settings
			if mkdir -p "$SETDIR" 2>/dev/null; then
				if [ -f /boot/backlight.txt ] && [ ! -e "$SETDIR/backlight.txt" ]; then
					if [ "$(md5sum < /boot/backlight.txt | cut -d' ' -f1)" = "a9fbd024efc113901643947f5346febb" ] &&
					   [ -f "$SETSRC/backlight.txt" ]; then
						cp "$SETSRC/backlight.txt" "$SETDIR/backlight.txt.new"
					else
						cp /boot/backlight.txt "$SETDIR/backlight.txt.new"
					fi && sync && mv -f "$SETDIR/backlight.txt.new" "$SETDIR/backlight.txt" && sync &&
						rm -f /boot/backlight.txt /boot/._backlight.txt && sync
				elif [ ! -e "$SETDIR/backlight.txt" ] && [ -f "$SETSRC/backlight.txt" ]; then
					cp "$SETSRC/backlight.txt" "$SETDIR/backlight.txt.new" && sync &&
						mv -f "$SETDIR/backlight.txt.new" "$SETDIR/backlight.txt" && sync
				fi
				mkdir -p "${SETTINGSMARKER%/*}"
				touch "$SETTINGSMARKER"
			fi
		fi

		# Once per system, as new images have it: no firmware for drivers our kernel doesn't
		# build (dpkg.cfg.d/openframe-unused-firmware leaves it out from now on), unless an
		# installed kernel does have the driver; and Debian's D-Bus wpa_supplicant.service
		# off unless NetworkManager, which it's for, is installed (netplan runs its own
		# wpa_supplicant for each Wi-Fi interface). Enabling it again afterwards sticks.
		if [ ! -e "$UNUSEDMARKER" ]; then
			if [ -d /usr/lib/firmware/rtw89 ] &&
			   [ -z "$(ls -d /usr/lib/modules/*/kernel/drivers/net/wireless/realtek/rtw89 2>/dev/null)" ]; then
				rm -rf /usr/lib/firmware/rtw89
			fi
			if [ ! -e /usr/sbin/NetworkManager ] && systemctl is-enabled --quiet wpa_supplicant.service 2>/dev/null; then
				systemctl disable --quiet wpa_supplicant.service 2>/dev/null || true
				in_chroot || systemctl stop wpa_supplicant.service 2>/dev/null || true
			fi
			mkdir -p "${UNUSEDMARKER%/*}"
			touch "$UNUSEDMARKER"
		fi

		# The image copy a flash stick carries lives in /usr/lib/openframe/flash, beside
		# OpenFrame Flash; the first release with it had it in /usr/lib/openframe/install.
		# Moved across, so such a stick can still flash.
		if [ -f /usr/lib/openframe/install/image.img.gz ] && [ ! -e /usr/lib/openframe/flash/image.img.gz ]; then
			mkdir -p /usr/lib/openframe/flash
			mv /usr/lib/openframe/install/image.img.gz /usr/lib/openframe/install/image.info \
				/usr/lib/openframe/flash/ 2>/dev/null || true
			rmdir /usr/lib/openframe/install 2>/dev/null || true
		fi

		# Once per system: OpenFrame Flash's boot service (of-flash.service), which on a
		# flash stick (flash=yes in OF-BOOT/settings/flash.txt) installs the system onto
		# an OpenFrame 1's internal memory, and otherwise does nothing in a moment.
		# Disabling it afterwards sticks. (It was of-installer.service for a day; that
		# one's link goes, as the unit has.)
		if [ ! -e "$FLASHMARKER" ]; then
			rm -f /etc/systemd/system/multi-user.target.wants/of-installer.service
			systemctl enable --quiet of-flash.service 2>/dev/null || true
			mkdir -p "${FLASHMARKER%/*}"
			touch "$FLASHMARKER"
		fi

		# Once per system: the services that make this unit's own SSH host keys when it
		# has none (of-ssh-keys.service before the SSH server, of-ssh-keys-rsa.service
		# once the system is up). Images ship without host keys from now on; a system
		# that already has keys keeps them, and the services do nothing there.
		if [ ! -e "$SSHKEYSMARKER" ]; then
			systemctl enable --quiet of-ssh-keys.service of-ssh-keys-rsa.service 2>/dev/null || true
			mkdir -p "${SSHKEYSMARKER%/*}"
			touch "$SSHKEYSMARKER"
		fi

		# Once per system: the service that applies OF-BOOT/settings/ssh.txt (a password and
		# keys for logging in as "of") at each start, with a template ssh.txt if there isn't
		# one. The password stays as it is; new images give "of" none, rather than the one
		# every unit had.
		if [ ! -e "$SSHSETTINGSMARKER" ]; then
			systemctl enable --quiet of-ssh-settings.service 2>/dev/null || true
			if [ -d /boot/settings ] && [ ! -e /boot/settings/ssh.txt ] && [ -f /usr/lib/openframe/settings/ssh.txt ]; then
				cp /usr/lib/openframe/settings/ssh.txt /boot/settings/ssh.txt.new && sync &&
					mv -f /boot/settings/ssh.txt.new /boot/settings/ssh.txt && sync || true
			fi
			mkdir -p "${SSHSETTINGSMARKER%/*}"
			touch "$SSHSETTINGSMARKER"
		fi

		# Once per system: the service that applies OF-BOOT/settings/test.txt at each start
		# (testing=yes makes a test unit, taking OpenBeak's updates before they're released),
		# with a template test.txt (testing=no) if there isn't one.
		if [ ! -e "$TESTSETTINGSMARKER" ]; then
			systemctl enable --quiet of-test-settings.service 2>/dev/null || true
			if [ -d /boot/settings ] && [ ! -e /boot/settings/test.txt ] && [ -f /usr/lib/openframe/settings/test.txt ]; then
				cp /usr/lib/openframe/settings/test.txt /boot/settings/test.txt.new && sync &&
					mv -f /boot/settings/test.txt.new /boot/settings/test.txt && sync || true
			fi
			mkdir -p "${TESTSETTINGSMARKER%/*}"
			touch "$TESTSETTINGSMARKER"
		fi

		# Once per system: automatic updates (of-update, through unattended-upgrades): at the
		# owner's quiet time (restarting then when an update needs it), and after a start when
		# the last was over 20 hours ago. apt's own daily timers are off (52openframe-updates turns
		# their jobs off too). Disabling of-update's timers afterwards sticks.
		if [ ! -e "$UPDATESMARKER" ]; then
			systemctl disable --quiet apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
			systemctl enable --quiet of-update-night.timer of-update-catchup.timer 2>/dev/null || true
			if ! in_chroot; then
				systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
				systemctl start of-update-night.timer 2>/dev/null || true
			fi
			mkdir -p "${UPDATESMARKER%/*}"
			touch "$UPDATESMARKER"
		fi

		# Once per system: the owner picks the time of the updates (OF-BOOT/settings/updates.txt,
		# read at each start; a template if there isn't one). The night run restarts by itself
		# now, so the separate 04:00 restart timer of 26.11.122-26.11.129 goes.
		if [ ! -e "$UPDATETIMEMARKER" ]; then
			systemctl enable --quiet of-update-schedule.service 2>/dev/null || true
			if [ -d /boot/settings ] && [ ! -e /boot/settings/updates.txt ] && [ -f /usr/lib/openframe/settings/updates.txt ]; then
				cp /usr/lib/openframe/settings/updates.txt /boot/settings/updates.txt.new && sync &&
					mv -f /boot/settings/updates.txt.new /boot/settings/updates.txt && sync || true
			fi
			rm -f /etc/systemd/system/timers.target.wants/of-update-reboot.timer
			# (stopped before the reload forgets it, or it's left behind as a failed unit)
			if ! in_chroot; then
				systemctl stop of-update-reboot.timer 2>/dev/null
				systemctl daemon-reload 2>/dev/null
				systemctl reset-failed of-update-reboot.timer of-update-reboot.service 2>/dev/null
				/usr/local/sbin/of-update schedule 2>/dev/null
			fi || true
			mkdir -p "${UPDATETIMEMARKER%/*}"
			touch "$UPDATETIMEMARKER"
		fi

		# Once per system: the unit's name (OF-BOOT/settings/name.txt, applied at each start;
		# a template, name= for openframe, if there isn't one).
		if [ ! -e "$NAMEMARKER" ]; then
			systemctl enable --quiet of-name-settings.service 2>/dev/null || true
			if [ -d /boot/settings ] && [ ! -e /boot/settings/name.txt ] && [ -f /usr/lib/openframe/settings/name.txt ]; then
				cp /usr/lib/openframe/settings/name.txt /boot/settings/name.txt.new && sync &&
					mv -f /boot/settings/name.txt.new /boot/settings/name.txt && sync || true
			fi
			mkdir -p "${NAMEMARKER%/*}"
			touch "$NAMEMARKER"
		fi

		# Once per system: where the sound goes (OF-BOOT/settings/audio.txt, a template if
		# there isn't one), of-audio writing ALSA's default from it as sound cards come and go
		# (70-of-audio.rules). It takes over the asound.conf images had, and leaves one of
		# someone's own be; a DAC in now becomes the output, as one plugged in later would.
		if [ ! -e "$AUDIOMARKER" ]; then
			if [ -d /boot/settings ] && [ ! -e /boot/settings/audio.txt ] && [ -f /usr/lib/openframe/settings/audio.txt ]; then
				cp /usr/lib/openframe/settings/audio.txt /boot/settings/audio.txt.new && sync &&
					mv -f /boot/settings/audio.txt.new /boot/settings/audio.txt && sync || true
			fi
			if ! in_chroot; then
				udevadm control --reload 2>/dev/null
				OF_AUDIO_SETTLE=0 /usr/local/sbin/of-audio hotplug 2>/dev/null
			fi || true
			mkdir -p "${AUDIOMARKER%/*}"
			touch "$AUDIOMARKER"
		fi

		# The clock's floor: systemd moves the clock forward to /usr/lib/clock-epoch's time
		# as the system starts. OpenFrames have no clock battery, so they lose the time
		# whenever they're off; this keeps a new system from starting months out (and
		# naming a flash stick's backup folder after the wrong month) before the network
		# puts it right. Brought up
		# to now whenever this package is installed and the clock is known to be right:
		# in an image build, or once it's synchronised.
		if in_chroot || [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ]; then
			touch /usr/lib/clock-epoch 2>/dev/null || true
		fi

		# Write changed data out within ten seconds (usr/lib/sysctl.d), from now on.
		in_chroot || sysctl -q -p /usr/lib/sysctl.d/60-openframe-writeback.conf 2>/dev/null || true

		# The OpenFrame apt repositories (kernel., linux. and firmware.openbeak.net) are
		# signed with one key, which this package ships. On every update, each of their
		# keyrings in /etc/apt/keyrings is set to it: until 2026-11 linux.openbeak.net had
		# a key of its own, and it signs with both while systems move over.
		APTKEY=/usr/share/keyrings/openframe-apt.gpg
		for KR in /etc/apt/keyrings/openframe-kernel.gpg /etc/apt/keyrings/openframe-linux.gpg /etc/apt/keyrings/openframe-firmware.gpg; do
			if [ -f "$APTKEY" ] && [ -f "$KR" ] && ! cmp -s "$APTKEY" "$KR"; then
				install -m 644 "$APTKEY" "$KR.new" && mv -f "$KR.new" "$KR"
			fi
		done

		# Once per system, add the firmware repository (firmware.openbeak.net), whose
		# openframe-firmware package keeps the OpenFrame 1's firmware up to date. A later
		# openframe-scripts depends on that package; apt can only resolve it once systems
		# know the repository. Removing the list afterwards keeps it removed.
		if [ ! -e "$FWREPOMARKER" ]; then
			FWLIST=/etc/apt/sources.list.d/openframe-firmware.list
			if [ ! -e "$FWLIST" ] && [ -f "$APTKEY" ] && [ -d /etc/apt/sources.list.d ]; then
				mkdir -p /etc/apt/keyrings
				install -m 644 "$APTKEY" /etc/apt/keyrings/openframe-firmware.gpg
				CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-trixie}")
				echo "deb [signed-by=/etc/apt/keyrings/openframe-firmware.gpg] https://firmware.openbeak.net/ ${CODENAME} main" > "$FWLIST"
			fi
			mkdir -p "${FWREPOMARKER%/*}"
			touch "$FWREPOMARKER"
		fi

		# Once per system, the wireless regulatory database the kernel can read. wireless-regdb
		# picks Debian's copy, signed with Debian's key, which only Debian's kernels carry; ours
		# trusts the upstream signature (CFG80211_USE_KERNEL_REGDB_KEYS), so it said "loaded
		# regulatory.db is malformed or signature is missing/invalid" and every Wi-Fi card kept
		# to the world rules (in the UK, no channels 12 and 13). Choosing the upstream copy
		# (its .p7s follows) puts the alternative in manual mode, so wireless-regdb updates keep
		# it; anyone who sets it back keeps theirs, as this runs once.
		if [ ! -e "$REGDBMARKER" ]; then
			if [ -e /lib/firmware/regulatory.db-upstream ]; then
				update-alternatives --quiet --set regulatory.db /lib/firmware/regulatory.db-upstream || true
			fi
			mkdir -p "${REGDBMARKER%/*}"
			touch "$REGDBMARKER"
		fi

		# Refresh the boot volume on every update, keeping the current mode. This gives
		# systems already in stub mode the empty vmlinuz-<version> that lets
		# update-initramfs find the kernel. It also clears what blocks a rebuild:
		# System.map, and backups left when a rebuild ran out of space.
		if [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			/usr/local/sbin/of-bootnsh >/dev/null || true
			rm -f /boot/System.map-* /boot/initrd.img-*.dpkg-bak
		fi

	;;
esac

exit 0
