#!/bin/sh

# openframe-scripts postinst
#  The kernel hooks now come from this package, in /usr/share/kernel. Older images put
#  copies in /etc/kernel, which would override them, so those are removed.
#
#  Then, once per system, the kernel is switched to booting directly through its EFI
#  stub, which saves around ten seconds per boot. Anyone who later runs
#  'of-settings efistub disable' keeps GRUB, because the marker stops this repeating.
#
#  Every update then tidies the boot volume so the next initrd rebuild fits, and
#  rewrites boot.nsh, which boots the kernel without its initrd once the kernel can
#  (of-bootnsh). The initrd used to check the root filesystem at every boot, so
#  once per system systemd is set to do it instead.
#
#  Also once per system, for power cuts (which on an OpenFrame are normal): an ext2
#  root gets a journal, becoming ext4; /boot is mounted read-only (dpkg and the
#  scripts make it writable while they write) and checked at boot; and a service
#  finishes package operations a cut interrupted.

set -e

MARKER="/var/lib/openframe-scripts/efistub-default"
FSCKMARKER="/var/lib/openframe-scripts/root-fsck-default"
JOURNALMARKER="/var/lib/openframe-scripts/root-journal-default"
BOOTROMARKER="/var/lib/openframe-scripts/boot-ro-default"
RECOVERMARKER="/var/lib/openframe-scripts/dpkg-recover-default"

# True inside a chroot, as when an image is being built.
in_chroot() {
	systemd-detect-virt -q --chroot 2>/dev/null
}

case "$1" in
	configure)

		rm -f /etc/kernel/preinst.d/openframe-boot-prep /etc/kernel/postinst.d/openframe-grub-update

		if [ ! -e "$MARKER" ] && [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			if /usr/local/sbin/of-bootnsh stub; then
				mkdir -p "${MARKER%/*}"
				touch "$MARKER"
				echo "OpenFrame now boots the kernel through its EFI stub. To go back to GRUB, run 'sudo of-settings efistub disable'."
			else
				echo "Could not switch to EFI stub boot; GRUB boot is unchanged."
			fi
		fi

		# Without an initrd nothing checks the root filesystem before it's mounted, so
		# let systemd check it (fsck pass 1). ext2 has no journal: after a power cut it
		# needs the check. Only an ext2/3/4 root still at 0, and only once, so a later
		# choice of 0 stays.
		if [ ! -e "$FSCKMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext[234][[:space:]]/ s/([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\11/' /etc/fstab
			mkdir -p "${FSCKMARKER%/*}"
			touch "$FSCKMARKER"
		fi

		# Give an ext2 root a journal, making it ext4. After a power cut a journaled
		# filesystem replays its last few seconds in a moment; ext2 needs a full check,
		# which can stop at a prompt nobody will answer. tune2fs adds the journal to the
		# mounted filesystem, and fstab and grub.cfg name it ext4 from the next boot.
		if [ ! -e "$JOURNALMARKER" ] && ! in_chroot; then
			ROOTDEV=$(findmnt -n -o SOURCE /)
			if [ "$(findmnt -n -o FSTYPE /)" = ext2 ] && [ -b "$ROOTDEV" ] &&
			   awk '$2 == "/" && $3 == "ext2" { f = 1 } END { exit !f }' /etc/fstab; then
				echo "Adding a journal to the root filesystem (ext2 to ext4)..."
				if tune2fs -j -J size=32 "$ROOTDEV" >/dev/null; then
					sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext2[[:space:]]/ s/^([^[:space:]]+[[:space:]]+\/[[:space:]]+)ext2/\1ext4/' /etc/fstab
					[ -f /boot/grub.cfg ] && sed -i 's/rootfstype=ext2/rootfstype=ext4/' /boot/grub.cfg
					sync
				else
					echo "Could not add the journal; the root filesystem stays ext2."
				fi
			fi
			mkdir -p "${JOURNALMARKER%/*}"
			touch "$JOURNALMARKER"
		fi

		# /boot read-only (dpkg and our scripts make it writable while they write),
		# checked at boot, and no access-time writes: a power cut can then only catch it
		# during an update. Takes effect at the next boot. Only a /boot line still at
		# 'defaults 0 0', so a different choice stays.
		if [ ! -e "$BOOTROMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]+vfat[[:space:]]/ s/([[:space:]]+vfat[[:space:]]+)defaults([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\1ro,noatime\22/' /etc/fstab
			mkdir -p "${BOOTROMARKER%/*}"
			touch "$BOOTROMARKER"
		fi

		# Finish package operations a power cut interrupted, at every boot.
		if [ ! -e "$RECOVERMARKER" ]; then
			systemctl enable --quiet of-dpkg-recover.service 2>/dev/null || true
			mkdir -p "${RECOVERMARKER%/*}"
			touch "$RECOVERMARKER"
		fi

		# Write changed data out within ten seconds (usr/lib/sysctl.d), from now on.
		in_chroot || sysctl -q -p /usr/lib/sysctl.d/60-openframe-writeback.conf 2>/dev/null || true

		# Refresh the boot volume on every update, keeping the current mode. This gives
		# systems already in stub mode the empty vmlinuz-<version> that lets
		# update-initramfs find the kernel. It also clears what blocks a rebuild:
		# System.map, and backups left when a rebuild ran out of space.
		if [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			/usr/local/sbin/of-bootnsh >/dev/null || true
			rm -f /boot/System.map-* /boot/initrd.img-*.dpkg-bak
		fi

	;;
esac

exit 0
