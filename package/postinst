#!/bin/sh

# openframe-scripts postinst
#  The kernel hooks now come from this package, in /usr/share/kernel. Older images put
#  copies in /etc/kernel, which would override them, so those are removed.
#
#  Then, once per system, the kernel is switched to booting directly through its EFI
#  stub, which saves around ten seconds per boot. Anyone who later runs
#  'of-settings efistub disable' keeps GRUB, because the marker stops this repeating.
#  An image build writes its own boot.nsh (of-imgcreate.sh), and the image's first
#  boot rewrites it for the unit (of-identifier).
#  Systems on the internal memory had to keep GRUB until the firmware's MMC driver
#  could be worked around (of-bootnsh); once per system they switch now too.
#
#  Every update then tidies the boot volume so the next initrd rebuild fits, and
#  rewrites boot.nsh, which boots the kernel without its initrd once the kernel can
#  (of-bootnsh). The initrd used to check the root filesystem at every boot, so
#  once per system systemd is set to do it instead.
#
#  Also once per system, for power cuts (which on an OpenFrame are normal): an ext2
#  root gets a journal, becoming ext4; /boot is mounted read-only (dpkg and the
#  scripts make it writable while they write) and checked at boot; and a service
#  finishes package operations a cut interrupted.

set -e

MARKER="/var/lib/openframe-scripts/efistub-default"
FSCKMARKER="/var/lib/openframe-scripts/root-fsck-default"
JOURNALMARKER="/var/lib/openframe-scripts/root-journal-default"
BOOTROMARKER="/var/lib/openframe-scripts/boot-ro-default"
RECOVERMARKER="/var/lib/openframe-scripts/dpkg-recover-default"
DIRSYNCMARKER="/var/lib/openframe-scripts/boot-dirsync-default"
MMCMARKER="/var/lib/openframe-scripts/mmc-stub-default"
FWREPOMARKER="/var/lib/openframe-scripts/firmware-repo-default"
MACGATEMARKER="/var/lib/openframe-scripts/mac-gate-default"

# True inside a chroot, as when an image is being built.
in_chroot() {
	systemd-detect-virt -q --chroot 2>/dev/null
}

case "$1" in
	configure)

		rm -f /etc/kernel/preinst.d/openframe-boot-prep /etc/kernel/postinst.d/openframe-grub-update

		# An image build can't tell what firmware will start the image (on the internal
		# memory that matters, see of-bootnsh): of-imgcreate.sh writes the image's
		# boot.nsh, and first boot (of-identifier) rewrites it. The marker still goes in,
		# so this doesn't switch an image's system back after 'of-settings efistub disable'.
		if [ ! -e "$MARKER" ] && in_chroot; then
			mkdir -p "${MARKER%/*}"
			touch "$MARKER"
		elif [ ! -e "$MARKER" ] && [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			if /usr/local/sbin/of-bootnsh stub; then
				mkdir -p "${MARKER%/*}"
				touch "$MARKER"
				grep -q vmlinuz /boot/boot.nsh &&
					echo "OpenFrame now boots the kernel through its EFI stub. To go back to GRUB, run 'sudo of-settings efistub disable'."
			else
				echo "Could not switch to EFI stub boot; GRUB boot is unchanged."
			fi
		fi

		# Systems on the internal memory were kept on GRUB, because the firmware loaded
		# the kernel corrupted from there. of-bootnsh now starts it directly when the
		# firmware is fixed or BlwMmcFix.efi can fix it, and keeps GRUB when not. Once
		# per system; an image's first boot chooses for itself.
		if [ ! -e "$MMCMARKER" ]; then
			if ! in_chroot && [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ] && ! grep -q vmlinuz /boot/boot.nsh; then
				BOOTSRC=$(findmnt -n -o SOURCE --target /boot 2>/dev/null || true)
				if [ -b "$BOOTSRC" ] && lsblk -n -o PKNAME "$BOOTSRC" 2>/dev/null | head -1 | grep -q '^mmcblk'; then
					/usr/local/sbin/of-bootnsh stub >/dev/null 2>&1 || true
					grep -q vmlinuz /boot/boot.nsh &&
						echo "OpenFrame now boots the kernel from its internal memory through its EFI stub. To go back to GRUB, run 'sudo of-settings efistub disable'."
				fi
			fi
			mkdir -p "${MMCMARKER%/*}"
			touch "$MMCMARKER"
		fi

		# Without an initrd nothing checks the root filesystem before it's mounted, so
		# let systemd check it (fsck pass 1). ext2 has no journal: after a power cut it
		# needs the check. Only an ext2/3/4 root still at 0, and only once, so a later
		# choice of 0 stays.
		if [ ! -e "$FSCKMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext[234][[:space:]]/ s/([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\11/' /etc/fstab
			mkdir -p "${FSCKMARKER%/*}"
			touch "$FSCKMARKER"
		fi

		# Give an ext2 root a journal, making it ext4. After a power cut a journaled
		# filesystem replays its last few seconds in a moment; ext2 needs a full check,
		# which can stop at a prompt nobody will answer. tune2fs adds the journal to the
		# mounted filesystem, and fstab and grub.cfg name it ext4 from the next boot.
		if [ ! -e "$JOURNALMARKER" ] && ! in_chroot; then
			ROOTDEV=$(findmnt -n -o SOURCE /)
			if [ "$(findmnt -n -o FSTYPE /)" = ext2 ] && [ -b "$ROOTDEV" ] &&
			   awk '$2 == "/" && $3 == "ext2" { f = 1 } END { exit !f }' /etc/fstab; then
				echo "Adding a journal to the root filesystem (ext2 to ext4)..."
				if tune2fs -j -J size=32 "$ROOTDEV" >/dev/null; then
					sed -i -E '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]+ext2[[:space:]]/ s/^([^[:space:]]+[[:space:]]+\/[[:space:]]+)ext2/\1ext4/' /etc/fstab
					# A synced copy renamed over the old one: FAT has no journal.
					[ -f /boot/grub.cfg ] && sed 's/rootfstype=ext2/rootfstype=ext4/' /boot/grub.cfg > /boot/grub.cfg.new &&
						sync && mv -f /boot/grub.cfg.new /boot/grub.cfg
					sync
				else
					echo "Could not add the journal; the root filesystem stays ext2."
				fi
			fi
			mkdir -p "${JOURNALMARKER%/*}"
			touch "$JOURNALMARKER"
		fi

		# /boot read-only (dpkg and our scripts make it writable while they write),
		# checked at boot, and no access-time writes: a power cut can then only catch it
		# during an update. dirsync puts each directory change (a new file, a rename, a
		# removal) on disk at once, so a cut mid-update can't leave a name pointing at
		# clusters something else has since reused. Takes effect at the next boot. Only
		# a /boot line still at 'defaults 0 0', so a different choice stays.
		if [ ! -e "$BOOTROMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]+vfat[[:space:]]/ s/([[:space:]]+vfat[[:space:]]+)defaults([[:space:]]+0[[:space:]]+)0[[:space:]]*$/\1ro,noatime,dirsync\22/' /etc/fstab
			mkdir -p "${BOOTROMARKER%/*}"
			touch "$BOOTROMARKER"
		fi

		# Systems that took the read-only /boot before it gained dirsync (26.11.17) get
		# it too, from the next boot. Only a /boot line at exactly 'ro,noatime'.
		if [ ! -e "$DIRSYNCMARKER" ] && [ -f /etc/fstab ]; then
			sed -i -E '/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]+vfat[[:space:]]/ s/([[:space:]]+vfat[[:space:]]+)ro,noatime([[:space:]])/\1ro,noatime,dirsync\2/' /etc/fstab
			mkdir -p "${DIRSYNCMARKER%/*}"
			touch "$DIRSYNCMARKER"
		fi

		# Finish package operations a power cut interrupted, at every boot.
		if [ ! -e "$RECOVERMARKER" ]; then
			systemctl enable --quiet of-dpkg-recover.service 2>/dev/null || true
			mkdir -p "${RECOVERMARKER%/*}"
			touch "$RECOVERMARKER"
		fi

		# Hold the login prompt and any UI while the unit reboots to store its MAC in
		# NVRAM (of-mac-gate, see of-bootnsh). Once per system, so disabling it sticks.
		if [ ! -e "$MACGATEMARKER" ]; then
			systemctl enable --quiet of-mac-gate.service 2>/dev/null || true
			mkdir -p "${MACGATEMARKER%/*}"
			touch "$MACGATEMARKER"
		fi

		# Images built before March 2026 put an old Go yq (2.1.1) in /usr/local/bin, ahead
		# of Debian's yq in PATH; of-netplan is written for Debian's. Remove it, but only
		# if it's exactly the one those images shipped, so a yq someone installed stays.
		if [ -f /usr/local/bin/yq ] &&
		   [ "$(md5sum < /usr/local/bin/yq | cut -d' ' -f1)" = aa1a350d3760a4c7d1abe014c07978f5 ]; then
			rm -f /usr/local/bin/yq
		fi

		# Write changed data out within ten seconds (usr/lib/sysctl.d), from now on.
		in_chroot || sysctl -q -p /usr/lib/sysctl.d/60-openframe-writeback.conf 2>/dev/null || true

		# The OpenFrame apt repositories (kernel., linux. and firmware.openbeak.net) are
		# signed with one key, which this package ships. On every update, each of their
		# keyrings in /etc/apt/keyrings is set to it: until 2026-11 linux.openbeak.net had
		# a key of its own, and it signs with both while systems move over.
		APTKEY=/usr/share/keyrings/openframe-apt.gpg
		for KR in /etc/apt/keyrings/openframe-kernel.gpg /etc/apt/keyrings/openframe-linux.gpg /etc/apt/keyrings/openframe-firmware.gpg; do
			if [ -f "$APTKEY" ] && [ -f "$KR" ] && ! cmp -s "$APTKEY" "$KR"; then
				install -m 644 "$APTKEY" "$KR.new" && mv -f "$KR.new" "$KR"
			fi
		done

		# Once per system, add the firmware repository (firmware.openbeak.net), whose
		# openframe-firmware package keeps the OpenFrame 1's firmware up to date. A later
		# openframe-scripts depends on that package; apt can only resolve it once systems
		# know the repository. Removing the list afterwards keeps it removed.
		if [ ! -e "$FWREPOMARKER" ]; then
			FWLIST=/etc/apt/sources.list.d/openframe-firmware.list
			if [ ! -e "$FWLIST" ] && [ -f "$APTKEY" ] && [ -d /etc/apt/sources.list.d ]; then
				mkdir -p /etc/apt/keyrings
				install -m 644 "$APTKEY" /etc/apt/keyrings/openframe-firmware.gpg
				CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME:-trixie}")
				echo "deb [signed-by=/etc/apt/keyrings/openframe-firmware.gpg] https://firmware.openbeak.net/ ${CODENAME} main" > "$FWLIST"
			fi
			mkdir -p "${FWREPOMARKER%/*}"
			touch "$FWREPOMARKER"
		fi

		# Refresh the boot volume on every update, keeping the current mode. This gives
		# systems already in stub mode the empty vmlinuz-<version> that lets
		# update-initramfs find the kernel. It also clears what blocks a rebuild:
		# System.map, and backups left when a rebuild ran out of space.
		if [ -f /boot/grub.cfg ] && [ -f /boot/boot.nsh ]; then
			/usr/local/sbin/of-bootnsh >/dev/null || true
			rm -f /boot/System.map-* /boot/initrd.img-*.dpkg-bak
		fi

	;;
esac

exit 0
