[Unit]
Description=OpenFrame root filesystem expansion
DefaultDependencies=no
ConditionPathExists=/etc/firstboot
# After /boot is checked and mounted: on older images growpart writes the 4 KB that
# /boot's FAT starts in.
After=systemd-remount-fs.service local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/of-expand
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
