[Unit]
Description=OpenFrame first-boot software provisioning
ConditionPathExists=|/boot/settings/setup.txt
ConditionPathExists=|/boot/setup.txt
# Keep after getty@tty1: of-mac-gate holds the getty while the unit restarts to store
# its MAC in NVRAM, so provisioning waits for the boot after (see of-provision).
After=of-identifier.service network-online.target time-sync.target getty@tty1.service
Wants=network-online.target time-sync.target

# Not tty1's: a getty (re)starting there hangs tty1 up, which would kill us if it were
# our controlling terminal. With a project to install, of-provision writes to tty1
# itself (the getty is held back then); otherwise it never touches tty1.
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/of-provision
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
