# OpenFrame: /boot is mounted read-only, so a power cut can't corrupt it. Let dpkg
# (and the kernel and initramfs-tools hooks it runs) write to it, then put it back.
# /usr/lib/openframe/bootrw does nothing in a chroot (an image build) or when /boot
# isn't mounted read-only, and keeps it writable while another writer needs it.
pre-invoke=if [ -x /usr/lib/openframe/bootrw ]; then /usr/lib/openframe/bootrw open; fi; true
post-invoke=if [ -x /usr/lib/openframe/bootrw ]; then /usr/lib/openframe/bootrw close; fi; true
