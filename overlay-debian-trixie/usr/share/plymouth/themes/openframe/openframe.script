// The OpenFrame's boot splash (openframe-scripts): the pecking bird exactly where the firmware
// drew it (bird.png is the firmware's own image, 204x82 at 274,199 on the 800x480 panel, white
// on black), so the change from the firmware to Linux doesn't show; under it, a short bar that
// fills as the start goes on. Shutting down and restarting, just the bird.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// The panel's 800x480; any other screen has it in the middle
ox = Window.GetX() + Math.Int((Window.GetWidth() - 800) / 2);
oy = Window.GetY() + Math.Int((Window.GetHeight() - 480) / 2);

bird.sprite = Sprite(Image("bird.png"));
bird.sprite.SetPosition(ox + 274, oy + 199, 1);

// The bar: 160x4, centred under the bird (which the firmware centres by its mass, on x 400),
// with round ends like Sprite's home pill: a dim track, and white filling it from the left. The
// fill is its two round ends and the stretch between them, so the ends stay round as it grows
// (an image scaled would squash them).
bar.w = 160;
bar.h = 4;
bar.x = ox + 400 - bar.w / 2;
bar.y = oy + 330;
bar.mid = Image("fill.png");
bar.tracked = 0;
bar.shown = 0;

fun progress_cb(duration, progress) {
	if (Plymouth.GetMode() != "boot") return;
	w = Math.Int(progress * bar.w);
	if (w > bar.w) w = bar.w;
	if (!bar.tracked) {
		bar.track = Sprite(Image("track.png"));
		bar.track.SetPosition(bar.x, bar.y, 2);
		bar.tracked = 1;
	}
	if (w < 5) return; // the fill: its two ends and at least a pixel between
	if (!bar.shown) {
		bar.left = Sprite(Image("fill-left.png"));
		bar.left.SetPosition(bar.x, bar.y, 3);
		bar.done = Sprite();
		bar.done.SetPosition(bar.x + 2, bar.y, 3);
		bar.right = Sprite(Image("fill-right.png"));
		bar.shown = 1;
	}
	bar.done.SetImage(bar.mid.Scale(w - 4, bar.h));
	bar.right.SetPosition(bar.x + w - 2, bar.y, 3);
}
Plymouth.SetBootProgressFunction(progress_cb);
