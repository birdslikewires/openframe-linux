#!/bin/sh
# openframe-boot-prep
#  Removes kernel files from /boot before installation.
#  Required because /boot is FAT16, which does not support hard links,
#  causing dpkg's backup mechanism to fail on reinstall.
#  Also removes old openframe kernel files to prevent /boot from filling up.

VERSION="$1"
RUNNING=$(uname -r)

# Remove /boot files for the version being installed (reinstall case). Not its
# initrd: the package doesn't contain one, so dpkg never backs it up, and
# update-initramfs replaces it with a rename once the new one is complete. Removing
# it first left nothing to boot if the power went in between.
for f in \
  /boot/vmlinuz-$VERSION \
  /boot/System.map-$VERSION \
  /boot/config-$VERSION
do
  [ -f "$f" ] && rm -f "$f"
done

# Remove /boot files for old openframe kernels, preserving only the running kernel.
# Found by config file, because in EFI stub mode of-bootnsh renames the kernel itself
# to vmlinuz.efi (which the next kernel install replaces).
for config in /boot/config-*-openframe; do
  [ -f "$config" ] || continue
  kver="${config#/boot/config-}"
  [ "$kver" = "$VERSION" ] && continue
  [ "$kver" = "$RUNNING" ] && continue
  rm -f \
    "/boot/vmlinuz-${kver}" \
    "/boot/System.map-${kver}" \
    "/boot/config-${kver}" \
    "/boot/initrd.img-${kver}"
done

# Put the removals on disk before dpkg writes the new kernel. FAT writes its metadata
# in no particular order, so without this a power cut could leave a removed file's
# old directory entry pointing at clusters the new kernel has since overwritten.
# (Mounted dirsync, as fstab now has it, removals go straight to disk anyway.)
sync

exit 0
