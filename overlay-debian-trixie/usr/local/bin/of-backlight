#!/usr/bin/env bash

## of-backlight v26.11.9 (15th November 2026) by Andrew Davison
##  Backlight control with fading for OpenFrame, and automatic brightness from the
##  light sensor. None of it needs root.
##
##    of-backlight          prints the backlight level (0-100).
##    of-backlight 0-100    a fixed level: fades to it, and returns at once.
##    of-backlight auto     automatic brightness from the light sensor (999 does the same).
##    of-backlight status   says which it is, and the level.
##  Whichever was asked for last is kept across reboots. A fresh system stays at the
##  level it has until someone asks for one or for auto.
##
##  The work is done by the of-backlight service (of-backlight.service: this script as
##  'daemon', running as a user of its own). The commands above only pass the request
##  on, through /run/of-backlight/control, so fades never overlap and nothing has to
##  be stopped first; changes it makes are in its journal ('journalctl -u of-backlight').
##  Without the service, a fixed level is still set, here; automatic brightness needs
##  it. 'debug' after a level or auto, with the service stopped, runs that here in the
##  foreground and says what it's doing.
##
##  Automatic brightness reads the light sensor every couple of seconds. A reading out
##  of step with the two before it is ignored (the median of the last three is used),
##  and what's left is smoothed, so the backlight follows the room rather than one
##  reading. Brightness follows a curve close to how eyes see it: (reading / full)^0.4,
##  full brightness at a reading of 600 by default (the sensor reads about 20 in a lit
##  room, 0-2 covered, 800 with a torch on it), and by night 75% of that. It's changed
##  only when that moves far enough (by night it dims more readily than it brightens),
##  and the screen goes off in the dark and back on once there's a little light again.
##  backlight.txt in the settings folder on the boot volume (OF-BOOT/settings) can
##  change most of that (see the notes in it); edits there apply within about 10
##  seconds. Systems that haven't had it moved there yet keep it in the root.

usage() {
	echo "Usage: $0 [0-100 | auto | status] [debug]"
	echo
	echo "  A backlight level in the range 0-100, or 'auto' (or 999) for automatic backlight."
	echo "  Running with no arguments returns the current backlight value."
	echo
	exit 1
}


BLIF="/sys/class/backlight/openframe-bl/brightness"
BLPOWER="/sys/class/backlight/openframe-bl/bl_power"
BLMAX=32
CONF="/boot/settings/backlight.txt"
OLDCONF="/boot/backlight.txt"
# Seconds between light sensor readings in automatic brightness.
INTERVAL=2
SERVICE="of-backlight.service"
RUNDIR="/run/of-backlight"
CTL="$RUNDIR/control"
STATUS="$RUNDIR/status"


## Whether we can switch the screen off and on through X (display :0.0, by name: from a
## service or over SSH there's no DISPLAY set). Asked when it's needed, since X may
## start after the service does.
XSETBIN=$(command -v xset)
xset_ok() {
	[ -n "$XSETBIN" ] && [[ "$($XSETBIN -display :0.0 q 2>&1)" =~ "DPMS is Enabled" ]]
}

## The backlight as a percentage, in CRNTBL; 0 when its power is off.
getbl() {
	local b p=0
	read -r b < "$BLIF"
	read -r p 2>/dev/null < "$BLPOWER"
	(( p == 0 )) || b=0
	CRNTBL=$(( b * 100 / BLMAX ))
}

## The hardware level (0-32) for $1 percent, in LEVEL: above 0% is never fully off.
level_for() {
	(( LEVEL = ($1 * BLMAX + 50) / 100 ))
	(( LEVEL > BLMAX )) && LEVEL=$BLMAX
	(( LEVEL == 0 && $1 > 0 )) && LEVEL=1
	return 0
}

## Wait $1 seconds (default 15 ms) without starting a 'sleep': reading an empty pipe
## with a timeout is built into bash.
pause() {
	[ -n "$PAUSEFD" ] || exec {PAUSEFD}<> <(:)
	read -r -t "${1:-0.015}" -u "$PAUSEFD" || :
}

## Fade to $1 percent ($2: 'debug'). 0 turns the screen off; anything above wakes it.
setbl() {

	local pref="$1" b dir=1
	getbl

	if [ "$2" = "debug" ]; then
		echo "Using interface: $BLIF"
		echo "Current backlight level: $CRNTBL"
		echo "Set backlight level to:  $pref"
	fi

	# Turning up: power the backlight and the display first.
	if (( pref > 0 )); then
		echo 0 > "$BLPOWER" 2>/dev/null
		xset_ok && $XSETBIN -display :0.0 dpms force on
	fi

	# Fade one hardware level at a time (the hardware has 33, 0-32). 15 ms a level
	# makes a full fade about half a second.
	read -r b < "$BLIF"
	level_for "$pref"
	(( LEVEL < b )) && dir=-1
	while (( b != LEVEL )); do
		(( b += dir ))
		[ "$2" != "debug" ] || echo "$b"
		echo "$b" > "$BLIF" 2>/dev/null
		pause
	done

	# Off: the backlight's own power too, and the display if X will let us.
	if (( pref == 0 )); then
		echo 4 > "$BLPOWER" 2>/dev/null
		xset_ok && $XSETBIN -display :0.0 dpms force off
	fi

}


## Automatic brightness settings: the defaults, then whatever backlight.txt sets (lines
## of setting=number; anything else is ignored). It's read with bash alone, never
## run, so nothing in it can do harm.
## Read every time it's needed, but only worked through when it has changed.
CONF_SEEN="-"
conf() {
	local lines=() line k v all f="$CONF"
	[ -r "$f" ] || f="$OLDCONF"
	[ -r "$f" ] && mapfile -t lines 2>/dev/null < "$f"
	all="${lines[*]}"
	[ "$all" = "$CONF_SEEN" ] && return 0
	CONF_SEEN="$all"
	C_full=600 C_night=75 C_min=0 C_max=100 C_off_below=1
	C_night_start=22 C_night_end=6
	for line in "${lines[@]}"; do
		[[ "$line" == *=* ]] || continue
		k="${line%%=*}"
		v="${line#*=}"
		v="${v%%#*}"
		k="${k//[[:space:]]/}"
		v="${v//[[:space:]]/}"
		[[ "$k" =~ ^[a-z_]+$ ]] && [[ "$v" =~ ^[0-9]{1,5}$ ]] || continue
		case "$k" in
			full|night|min|max|off_below|night_start|night_end)
				printf -v "C_$k" '%d' "$(( 10#$v ))" ;;
		esac
	done
	(( C_full < 1 )) && C_full=1
	(( C_night > 100 )) && C_night=100
	(( C_max > 100 )) && C_max=100
	(( C_min > C_max )) && C_min=$C_max
	return 0
}

## Brightness in hundredths of a percent, in CURVE, for a reading given in sixteenths
## ($1): 100 * (reading / full)^0.4, from a table (within 1.5% of it).
CURVE_R=(0 10 20 50 100 200 500 1000 2000 5000 10000 20000 50000 100000)
CURVE_P=(0 251 331 478 631 833 1201 1585 2091 3017 3981 5253 7579 10000)
curve() {
	local r i=1
	(( r = $1 * 100000 / (16 * C_full) ))
	if (( r >= 100000 )); then CURVE=10000; return; fi
	while (( r > CURVE_R[i] )); do (( i++ )); done
	(( CURVE = CURVE_P[i-1] + (CURVE_P[i] - CURVE_P[i-1]) * (r - CURVE_R[i-1]) / (CURVE_R[i] - CURVE_R[i-1]) ))
}

## The light sensor's reading, in LIGHT (empty if there isn't one). From the kernel
## driver (openframe-als), found once and again if it goes; else through readlightsensor.
SENSOR=""
read_light() {
	local d n
	LIGHT=""
	if [ -z "$SENSOR" ]; then
		for d in /sys/bus/iio/devices/iio:device*; do
			n=""
			read -r n 2>/dev/null < "$d/name"
			[ "$n" = "openframe-als" ] && SENSOR="$d/in_illuminance_raw" && break
		done
	fi
	if [ -n "$SENSOR" ]; then
		read -r LIGHT 2>/dev/null < "$SENSOR" || SENSOR=""
	else
		LIGHT=$(readlightsensor 2>/dev/null)
	fi
	[[ "$LIGHT" =~ ^[0-9]+$ ]] || LIGHT=""
}

## Automatic brightness, one reading ($1: 'debug'), with the settings conf last read.
## Keeps its smoothing in A_r1, A_r2 and A_ema between readings.
A_r1="" A_r2="" A_ema=""
auto_step() {

	local med hour night want applied hysup hysdown delta

	read_light
	if [[ -z $LIGHT ]]; then
		[[ $1 == debug ]] && echo "No light sensor reading."
		return
	fi

	# From here on it's all bash arithmetic, (( )): LIGHT has been checked to be a
	# number (read_light), as have the settings (conf). Never let anything unchecked in:
	# (( )) works out what a variable holds as an expression of its own.

	# The median of the last three readings, then smoothed (in sixteenths).
	[[ -z $A_r1 ]] && A_r1=$LIGHT A_r2=$LIGHT
	(( med = LIGHT < A_r1 ? (A_r1 < A_r2 ? A_r1 : (LIGHT < A_r2 ? A_r2 : LIGHT))
	                      : (LIGHT < A_r2 ? LIGHT : (A_r1 < A_r2 ? A_r2 : A_r1)) ))
	A_r2=$A_r1 A_r1=$LIGHT
	if [[ -z $A_ema ]]; then (( A_ema = med * 16 )); else (( A_ema = (A_ema + med * 16) / 2 )); fi

	# Night is from night_start until night_end (it may run past midnight). A comparison
	# in (( )) is 1 when true and 0 when not, so it can be stored as it is.
	printf -v hour '%(%H)T' -1
	(( hour = 10#$hour ))
	if (( C_night_start > C_night_end )); then
		(( night = hour >= C_night_start || hour < C_night_end ))
	else
		(( night = hour >= C_night_start && hour < C_night_end ))
	fi

	# Compared with what the backlight really is now, not what was last set: something
	# else may have set it since (systemd restores the level saved at shutdown).
	getbl
	applied=$CRNTBL

	# What the backlight should be. Dark: off below off_below, and back on only at 2
	# more than that, so a dark room's readings (0-2) can't flicker it.
	if (( C_off_below > 0 && (A_ema < C_off_below * 16 ||
	      (applied == 0 && A_ema < (C_off_below + 2) * 16)) )); then
		want=0
	else
		curve "$A_ema"
		(( night )) && (( CURVE = CURVE * C_night / 100 ))
		(( want = (CURVE + 50) / 100 ))
		(( want < C_min )) && want=$C_min
		(( want > C_max )) && want=$C_max
		(( want < 1 )) && want=1
	fi

	# By night it dims more readily than it brightens; by day changes either way must
	# be a little bigger. Off and on happen at once.
	if (( night )); then hysup=-4 hysdown=2; else hysup=-3 hysdown=3; fi
	(( delta = applied - want ))

	if [[ $1 == debug ]]; then
		echo "Mode: $( (( night )) && echo Night || echo Day)   reading $LIGHT, median $med, smoothed $(( (A_ema + 8) / 16 ))"
		echo "Backlight % should be $want, is $applied (delta $delta)"
	fi

	if (( (want == 0 && applied != 0) || (applied == 0 && want != 0) ||
	      delta <= hysup || delta > hysdown )); then
		if [[ $1 == debug ]]; then
			echo "Altering to: $want"
		else
			echo "auto: light $(( (A_ema + 8) / 16 )), backlight $applied% -> $want%"
		fi
		setbl "$want" "$1"
	fi
	[[ $1 == debug ]] && echo
	return 0

}


## The service: takes requests ('auto' or a level) from $CTL, keeps the mode in its state
## directory for the next boot, and in between runs automatic brightness or holds the
## fixed level (putting it back if something else changes it).
daemon() {

	local state="${STATE_DIRECTORY:-/var/lib/of-backlight}/mode" mode req hw pw

	mkdir -p "$RUNDIR"
	rm -f "$CTL"
	mkfifo -m 0666 "$CTL" || exit 1
	# Open both ways, so a request never waits for a reader and the pipe never closes.
	exec {CTLFD}<> "$CTL"

	# The mode from last time: 'auto' or a level. None yet: the level the backlight has.
	mode=""
	read -r mode 2>/dev/null < "$state"
	if [[ $mode != auto ]] && ! { [[ $mode =~ ^[0-9]{1,3}$ ]] && (( 10#$mode <= 100 )); }; then
		getbl
		mode=$CRNTBL
	elif [[ $mode != auto ]]; then
		(( mode = 10#$mode ))
	fi
	echo "Starting in $([ "$mode" = auto ] && echo "automatic brightness" || echo "fixed level $mode%")."

	local said="" passes=0 since_conf=0 wait
	while true; do

		# The mode, for 'of-backlight status': written when it changes. A change also has
		# the settings read again straight away.
		if [ "$mode" != "$said" ]; then
			echo "$mode" > "$STATUS"
			said="$mode"
			since_conf=0
		fi

		# The settings: read on the first pass and then every fifth (in auto, every 10 s
		# or so), so an edit takes effect without bash working through the file each time.
		(( since_conf % 5 == 0 )) && conf
		(( since_conf++, passes++ ))

		if [ "$mode" = "auto" ]; then
			auto_step
		else
			# Hold the fixed level: set it again if anything else has changed it. Off is
			# right with the power off or the level at 0; on, with power on and the level.
			level_for "$mode"
			read -r hw < "$BLIF"
			pw=0
			read -r pw 2>/dev/null < "$BLPOWER"
			if (( (mode == 0 && !(pw != 0 || hw == 0)) ||
			      (mode > 0 && !(pw == 0 && hw == LEVEL)) )); then
				echo "Putting back fixed level $mode% (something else changed it)."
				setbl "$mode"
			fi
		fi

		# Wait for a request: in auto, until the next reading. At a fixed level up to 30 s,
		# since only a change behind its back needs looking for (a request still comes in
		# at once); but every reading for the first 15, while systemd may still be putting
		# back the level saved at shutdown.
		wait="$INTERVAL"
		[[ $mode != auto ]] && (( passes > 15 )) && wait=30
		if read -r -t "$wait" -u "$CTLFD" req; then
			if [ "$req" = "auto" ] || [ "$req" = "999" ]; then
				[ "$mode" != "auto" ] && echo "Request: automatic brightness."
				mode="auto"
			elif [[ $req =~ ^[0-9]{1,3}$ ]] && (( 10#$req <= 100 )); then
				mode=$(( 10#$req ))
				echo "Request: fixed level $mode%."
				setbl "$mode"
			else
				echo "Ignored a request that isn't 'auto' or 0-100."
				continue
			fi
			echo "$mode" > "$state.new" 2>/dev/null && mv -f "$state.new" "$state" 2>/dev/null
		fi

	done

}


## Passes request $1 to the service. False if there's no service to take it.
request() {
	systemctl is-active --quiet "$SERVICE" 2>/dev/null || return 1
	# Just started: its pipe follows within moments.
	local i=0
	while [[ ! -p $CTL ]] && (( i < 20 )); do
		pause 0.1
		(( i++ ))
	done
	[ -p "$CTL" ] || return 1
	# The service holds the pipe open, so this doesn't wait; the timeout is in case it
	# has just died.
	timeout 2 bash -c 'printf "%s\n" "$1" > "$2"' _ "$1" "$CTL"
}


## The service itself.
if [ "$1" = "daemon" ]; then
	daemon
	exit 0
fi

## 'auto' is 999. Otherwise we're expecting an integer, or status.
[ "$1" = "auto" ] && set -- 999 "${@:2}"
# The pattern is checked first: only a number may go into the arithmetic after it.
# Then it's made plain decimal, since in (( )) a leading 0 means octal (050 is 40).
RE='^[0-9]{1,3}$'
if (( $# > 0 )) && [[ $1 != status ]] && { [[ ! $1 =~ $RE ]] || (( 10#$1 > 100 && 10#$1 != 999 )); }; then
	usage
fi
[[ $1 =~ $RE ]] && set -- "$(( 10#$1 ))" "${@:2}"

## Check whether we can access the backlight.
if [ -e "$BLIF" ]; then
	if [ ! -w "$BLIF" ]; then
		echo "Permissions do not currently allow you to set the backlight level."
		echo "You can allow this by creating a udev rule."
	fi
else
	echo "No known backlight interface found."
	exit 1
fi


if (( $# == 0 )); then

	getbl
	echo "$CRNTBL"

elif [ "$1" = "status" ]; then

	getbl
	MODE=""
	read -r MODE 2>/dev/null < "$STATUS"
	if ! systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
		echo "Backlight $CRNTBL% (the $SERVICE isn't running, so nothing keeps it there)."
	elif [ "$MODE" = "auto" ]; then
		echo "Automatic brightness: backlight $CRNTBL% now."
	else
		echo "Fixed level ${MODE:-?}%: backlight $CRNTBL% now."
	fi

elif [ "$2" = "debug" ]; then

	if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
		echo "The $SERVICE is running, and this would fight with it:"
		echo "'sudo systemctl stop $SERVICE' first, and start it again afterwards."
		exit 1
	fi
	if (( $1 == 999 )); then
		while true; do
			conf
			auto_step debug
			pause "$INTERVAL"
		done
	else
		setbl "$1" debug
	fi

elif request "$1"; then

	:

elif (( $1 == 999 )); then

	echo "Automatic brightness needs the of-backlight service, which isn't running:"
	echo "'sudo systemctl enable --now $SERVICE' starts it, now and at every boot."
	exit 1

else

	## No service: set it here, in the background, detached from the terminal, so we
	## return at once. A fade still running from before is stopped first.
	for BLPID in $(pgrep -f -- "^([^ ]*/)?bash ([^ ]*/)?$(basename "$0")( |\$)"); do
		(( BLPID != $$ )) && kill "$BLPID" 2>/dev/null
	done
	setbl "$1" </dev/null >/dev/null 2>&1 &
	disown

fi

exit 0
