#!/usr/bin/env bash

## of-identifier v26.11.7 (10th November 2026)
##  Identifies what kind of OpenFrame device we're running on and applies some tweaks.

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

source /etc/os-release

OPENFRAME=1
KERNVER=$(uname -r)
KERNMAJVER=$(echo "$KERNVER" | awk -F. '{print $1}')

# Regenerate the SSH key files if they're not present.
[ ! -f /etc/ssh/ssh_host_rsa_key ] && DEBIAN_FRONTEND=noninteractive dpkg-reconfigure openssh-server

# We can't do anything else that's useful until the system has decided upon its MAC addresses. This relies upon of-netplan.
while [ ! -f /tmp/openframe.net ]; do sleep 1; done
sync

outputsysteminformation() {
	DESC=$(echo ${ID^} ${VERSION_CODENAME^} | awk -F' ' '{print $1 "/" $2}')
	MMRY=$(free -b | grep 'Mem:' | tr -s ' ' | cut -c6- | sed 's/ /\//g')
	DRVE=$(df -B 1 | grep '/$' | sed 's/\/dev\///g' | tr -s ' ' | rev | cut -c3- | rev | sed 's/ /\//g')
	ICPU=$(grep -Em1 "^model name.*Intel" /proc/cpuinfo | awk -F\  '{print $7}')
	echo -n "$DESC"/"${VERSION_CODENAME,,}"/"$(uname -r)"/"$MMRY"/"$DRVE" > /tmp/openframe.nfo
	echo -n "/$ICPU" >> /tmp/openframe.nfo || echo >> /tmp/openframe.nfo
	echo "/openframe" >> /tmp/openframe.nfo
}

outputsystemuid() {
	UUID=$(cat /etc/fstab | grep 'UUID' | grep ' / ' | awk -F\= '{print $2}' | awk -F\  '{print $1}')
	echo "$UUID" > /tmp/openframe.uid
}

if [ -e /boot/openframe.ver ]; then

	OPENFRAME=$(cat /boot/openframe.ver | cut -b1)
	MMCSIZE=""
	echo "Specified as OpenFrame $OPENFRAME via override file."

else

	MMC=$(ls -1 /dev/mmcblk* 2>/dev/null | grep -v "p")

	if [ "$MMC" != "" ]; then

		MMCCOUNT=$(echo "$MMC" | wc -l)

		if [ $MMCCOUNT -le 1 ];  then
			# If only one /dev/mmcblk appears, we can use it to identify the unit.

			MMCNUM=$(echo "${MMC: -1}")
			MMCSIZE=$(fdisk -l /dev/mmcblk$MMCNUM | grep -m1 mmcblk$MMCNUM: | awk -F\  {'print $5'})

			[ $MMCSIZE -gt 1028128768 ] && OPENFRAME=2 || OPENFRAME=1
			[ ! $MMCSIZE -gt 0 ] && echo "Could not identify MMC capacity. Assuming OpenFrame 1."
				
		else
			# If we get more than one, we can't guarantee which is the internal one.
			
			echo "Multiple MMC devices found. Assuming OpenFrame 1."

		fi

	else

		echo "Could not identify an MMC device. Assuming OpenFrame 1."

	fi

fi

[ ! $OPENFRAME ] || [ $OPENFRAME -lt 1 ] || [ $OPENFRAME -gt 2 ] && echo "Not a known device." && exit 1

echo $OPENFRAME > /tmp/openframe.ver

if [ ! "$OPENFRAME" -eq 1 ] && [ ! "$OPENFRAME" -eq 2 ]; then
	# We had some patches to do in earlier versions and this is where we did them.

	echo "Unable to identify this device. Is it an OpenFrame?"
	exit 1

fi

# /boot is mounted read-only, so a power cut can't corrupt it. This makes it writable
# until the script exits (/usr/lib/openframe/bootrw keeps it writable while any other
# writer still needs it, and puts it back after the last).
BOOTRW=""
boot_rw() {
	[ -z "$BOOTRW" ] || return 0
	/usr/lib/openframe/bootrw open || return 1
	BOOTRW=done
	trap '/usr/lib/openframe/bootrw close' EXIT
}

# Replaces file $2 on /boot with a copy of $1. FAT has no journal and writes its
# metadata in no particular order, so the copy is synced before it's renamed over
# the old file: a power cut leaves one or the other. The first sync puts anything
# deleted earlier on disk before its space is reused.
boot_put() {
	boot_rw
	sync
	cp "$1" "$2.new" && sync && mv -f "$2.new" "$2" && sync
}

# sed -i for a file on /boot, through boot_put.
boot_sed() {
	local NEW
	NEW=$(mktemp) || return 1
	sed "$1" "$2" > "$NEW" && boot_put "$NEW" "$2"
	rm -f "$NEW"
}

if [ -f /etc/firstboot ]; then

	boot_rw

	# Give this unit's disk identifiers nothing else shares. The same image is written
	# to sticks and to the internal memory, and with two copies attached a boot from
	# one could otherwise mount the other's root. The kernel finds root by partition
	# UUID, which comes from the disk's partition-table ID, so that gets a random one
	# and fstab and grub.cfg follow it; the labels (BOOTxxxx, ROOTxxxx) and the root
	# filesystem's UUID change too. Each step leaves the unit bootable: if the power
	# goes part way, /etc/firstboot is still there and this runs again.
	BOOTNSHDONE=""
	ROOTLOC=$(findmnt -n -o SOURCE /)
	BOOTLOC=$(findmnt -n -o SOURCE /boot)
	DISK="/dev/$(lsblk -n -o PKNAME "$ROOTLOC" 2>/dev/null | head -1)"
	NEWUUID=$(cat /proc/sys/kernel/random/uuid)
	NEWSHORT="${NEWUUID:0:4}"
	NEWSHORT="${NEWSHORT^^}"

	if [ -b "$ROOTLOC" ] && [ -b "$BOOTLOC" ] && [ -b "$DISK" ] &&
	   [ "$(lsblk -n -o PKNAME "$BOOTLOC" | head -1)" == "${DISK#/dev/}" ] &&
	   [ "$(blkid -c /dev/null -o value -s PTTYPE "$DISK")" == "dos" ]; then

		# systemd checks /boot at boot (its fsck pass) through a unit tied to the name
		# fstab mounts it by, and stopping that unit (as happens when the name goes away
		# below) unmounts /boot. So the check comes out of this boot's /boot mount until
		# the names are final. The pass number is saved in case the power goes first.
		PASSFILE="/var/lib/openframe-scripts/firstboot-bootpass"
		set_bootpass() {
			sed -i -E "/^[^#[:space:]]+[[:space:]]+\/boot[[:space:]]/ s/([[:space:]])[0-9]+[[:space:]]*\$/\1$1/" /etc/fstab
		}
		if [ ! -s "$PASSFILE" ]; then
			mkdir -p "${PASSFILE%/*}"
			awk '$1 !~ /^#/ && $2 == "/boot" { print $6 }' /etc/fstab > "$PASSFILE"
			sync
		fi
		set_bootpass 0
		systemctl daemon-reload

		# Writes disk identifier $2 (0x and 8 hex digits) into the MBR of disk $1. Our
		# images' first partition (/boot) starts at sector 1, so the disk's first 4 KB
		# holds the MBR and the start of /boot's FAT. sfdisk would write the MBR through
		# the whole disk's own cache, 4 KB at a time, and that cache can hold an old copy
		# of the FAT (/boot is written through its partition): the write puts it back
		# over the real one, losing what /boot gained since (at first boot, of-netplan's
		# network.yaml). Direct I/O reads and writes the MBR's sector alone, from and to
		# the disk, and the kernel drops the stale cached copy.
		set_disk_id() {
			local SS TMP HEX="${2#0x}" RC=1
			SS=$(blockdev --getss "$1") && TMP=$(mktemp) || return 1
			if dd if="$1" of="$TMP" bs="$SS" count=1 iflag=direct status=none &&
			   [ "$(od -An -tx1 -j510 -N2 "$TMP" | tr -d ' \n')" == "55aa" ]; then
				# Stored least significant byte first, at offset 440.
				printf "\\x${HEX:6:2}\\x${HEX:4:2}\\x${HEX:2:2}\\x${HEX:0:2}" |
					dd of="$TMP" bs=1 seek=440 conv=notrunc status=none &&
				dd if="$TMP" of="$1" bs="$SS" count=1 oflag=direct conv=notrunc status=none
				RC=$?
			fi
			rm -f "$TMP"
			return $RC
		}

		DISKID=""
		until [[ "$DISKID" =~ ^0x[0-9a-f]{8}$ ]] && [[ "$DISKID" != "0x00000000" ]]; do
			DISKID="0x$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
		done
		# The new identifier goes straight to the disk, sector 0 alone (set_disk_id). The
		# check below reads it back.
		set_disk_id "$DISK" "$DISKID"
		udevadm trigger --settle "$DISK" "$ROOTLOC" "$BOOTLOC"
		ROOTPART=$(blkid -c /dev/null -o value -s PARTUUID "$ROOTLOC")
		BOOTPART=$(blkid -c /dev/null -o value -s PARTUUID "$BOOTLOC")

		if [ "${ROOTPART%-*}" == "${DISKID#0x}" ] && [ "${BOOTPART%-*}" == "${DISKID#0x}" ]; then
			# fstab and grub.cfg name the partitions by partition UUID from now on.
			sed -i -E "s#^[^\#[:space:]]+([[:space:]]+/[[:space:]])#PARTUUID=$ROOTPART\1#; s#^[^\#[:space:]]+([[:space:]]+/boot[[:space:]])#PARTUUID=$BOOTPART\1#" /etc/fstab
			boot_sed "s#root=[^[:space:]]*#root=PARTUUID=$ROOTPART#" /boot/grub.cfg
			[ -x /usr/local/sbin/of-bootnsh ] && /usr/local/sbin/of-bootnsh stub
			BOOTNSHDONE=1

			# Nothing finds the partitions by label or filesystem UUID any more, so
			# these (and the boot volume's serial number) only need to differ from
			# other disks'.
			fatlabel "$BOOTLOC" "BOOT$NEWSHORT" >/dev/null 2>&1
			fatlabel -i "$BOOTLOC" "$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" >/dev/null 2>&1
			e2label "$ROOTLOC" "ROOT$NEWSHORT"
			tune2fs -U "$NEWUUID" "$ROOTLOC" >/dev/null
		else
			echo "The disk's new identifier didn't take ($DISKID: root $ROOTPART, boot $BOOTPART); identifiers left as they were."
		fi

		# /boot is checked at boot again from the next one.
		set_bootpass "$(cat "$PASSFILE" 2>/dev/null || echo 2)"
		sync
		rm -f "$PASSFILE"
		systemctl daemon-reload

	else
		echo "Can't find a partitioned disk holding both / and /boot; identifiers left as they were."
	fi

	# Write boot.nsh for this unit, if that wasn't done above. Images boot through
	# GRUB, which works from any disk: from here on the kernel starts directly from
	# its EFI stub, without the initrd if it can (of-bootnsh checks the running
	# system), except on the internal memory, which the firmware can't start the
	# kernel from.
	[ -z "$BOOTNSHDONE" ] && [ -x /usr/local/sbin/of-bootnsh ] && /usr/local/sbin/of-bootnsh stub

	# Set a sensible default audio level and enable auto-mute.
	amixer -c 0 sset 'Master' 50% unmute >/dev/null 2>&1
	amixer -c 0 sset 'Auto-Mute Mode' 'Line Out+Speaker'

	# Repair weird crontab permissions error.
	chown :crontab /usr/bin/crontab
	chmod 2755 /usr/bin/crontab
	chown :crontab /var/spool/cron/crontabs
	chmod 1730 /var/spool/cron/crontabs

	# Leave a temporary note for non-critical scripts that this was our first boot.
	mv /etc/firstboot /tmp/firstboot

fi

outputsystemuid
outputsysteminformation

# Init the light sensor readings.
readlightsensor &>/dev/null

exit 0
