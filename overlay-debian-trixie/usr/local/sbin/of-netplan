#!/usr/bin/env bash

## of-netplan v26.11.8 (13th November 2026)
##  Manages netplan configuration and MAC addresses on OpenFrame devices.

##  If there's a /boot/network.yaml file, we copy and use that.
##  The LAN MAC follows the WLAN card: 02 then the card MAC's last five octets.
##  If no WLAN interface is available, we generate a MAC for the LAN interface, once.
##  So we do if the card has no burned-in address of its own (a locally administered
##  one may be random and change every boot).
##
##  Two state files in /var/lib/of-netplan:
##    lan.mac   the LAN MAC we last wrote into network.yaml
##    wlan.mac  the WLAN card's MAC when we last saw one, or 'none' if we haven't
##              and generated the LAN MAC
##  A LAN MAC that is 02 then wlan.mac's last five octets was made from that card.
##  So when a different card turns up (swapped, or this stick moved to another
##  unit), a LAN MAC made from the old card, or generated, is made again from the
##  new one. Two units can then never share a LAN MAC because they once had each
##  other's cards. The kernel log (dmesg) says when that happens. A MAC typed into
##  network.yaml is left alone, and deleting it there makes one from the card again.
##
##  On BirdsLikeWires firmware the unit's MAC is kept in NVRAM (of-bootnsh has
##  BlwMac.efi store it when it isn't there): the card's own, or with no card the
##  generated LAN MAC. The firmware applies the LAN MAC before any OS starts, and
##  makes the system's UUID from it (00000000-0000-8000-8000-<MAC>), plus for a card
##  its serial number. A generated LAN MAC then belongs to the unit, not this stick:
##  with no card, if NVRAM holds a generated MAC (02...), that is the LAN MAC, so any
##  stick in this unit uses it and a stick moved to another unit takes that unit's.
##  If NVRAM holds a card's MAC but the card has gone, or holds none, a new one is
##  generated and stored: never this stick's old one, which may be another unit's,
##  and not the old card's either, which may be in another unit by now. A card that
##  turns up again takes over as before. A MAC generated for this unit and not yet
##  stored is kept in lan.pending, so it isn't generated afresh every boot while it
##  waits. Generated MACs come from /dev/urandom. On other firmware a generated LAN
##  MAC is made once and kept, as before.
##
##  Then we put the modified file back into /boot. If its Wi-Fi section is still
##  the unedited template, it's left out of the live config.
##
##  We're also responsible for /etc/issue
##
##  If /boot/network.yaml and the live config both match what we left last boot,
##  nothing has changed. Then we skip the rest, including 'netplan apply': the
##  netplan generator has already configured the network from /etc/netplan, and
##  applying again costs a daemon-reload and a second DHCP exchange on every boot.
##
##  'of-netplan --early' is run by udev (70-of-eth0-up.rules) as soon as eth0
##  appears. It sets the LAN MAC we settled on last boot and brings the link up,
##  so the PHY's ~2 s of autonegotiation is done before networkd starts rather
##  than after it.

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

source /etc/os-release

LAN="eth0"
WLAN="wlan0"
WLANTIMEOUT=15
CONFIGTIMEOUT=10
NETPLANCONFIG="network.yaml"
STATEDIR="/var/lib/of-netplan"

# Early mode, from udev: MAC first (while the link is down, so it's right from the
# first frame and networkd has nothing to change), then link up. Nothing else.
if [ "$1" = "--early" ]; then
	MAC=$(cat $STATEDIR/lan.mac 2>/dev/null)
	if [[ "$MAC" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]; then
		ip link set dev $LAN address "$MAC"
	fi
	ip link set dev $LAN up
	exit 0
fi

# Create /tmp/openframe.net as a quick network information reference.
write_netinfo() {
	MACW=$(ip link | sed -n '/wlan0/{n;p;}' | awk -F\  {'print $2'})
	MACE=$(ip link | sed -n '/eth0/{n;p;}' | awk -F\  {'print $2'})
	[[ "$MACW" == "" ]] && MACW="00:00:00:00:00:00"
	[[ "$MACE" == "" ]] && MACE="00:00:00:00:00:00"
	echo "$MACW"/"$MACE"/"$(hostname)" > /tmp/openframe.net
}

# /boot is mounted read-only, so a power cut can't corrupt it. This makes it writable
# until the script exits (/usr/lib/openframe/bootrw keeps it writable while any other
# writer still needs it, and puts it back after the last).
BOOTRW=""
boot_rw() {
	[ -z "$BOOTRW" ] || return 0
	/usr/lib/openframe/bootrw open || return 1
	BOOTRW=done
	trap '/usr/lib/openframe/bootrw close' EXIT
}

# Replaces file $2 on /boot with a copy of $1. FAT has no journal and writes its
# metadata in no particular order, so the copy is synced before it's renamed over
# the old file: a power cut leaves one or the other. The first sync puts anything
# deleted earlier on disk before its space is reused.
boot_put() {
	boot_rw
	sync
	cp "$1" "$2.new" && sync && mv -f "$2.new" "$2" && sync
}

# The WLAN card's own (burned-in) MAC, waiting up to $1 seconds for the card to appear
# (0: just look): its permanent address if the kernel shows one (something changed the
# current one), else its current one. A locally administered address (02 bit set:
# randomised, or made up by a driver for a card with none stored) isn't the card's own
# and may change from boot to boot, so it counts as no card: a LAN MAC is then
# generated once and kept.
card_mac() {
	local COUNT=0 MAC
	while [ $COUNT -lt $(($1 * 5)) ] && [ ! -e /sys/class/net/$WLAN/address ]; do
		COUNT=$((COUNT+1))
		sleep 0.2
	done
	MAC=$(ip -d link show dev $WLAN 2>/dev/null | grep -o 'permaddr [0-9a-fA-F:]*' | cut -d' ' -f2)
	[ -n "$MAC" ] || MAC=$(cat /sys/class/net/$WLAN/address 2>/dev/null)
	MAC="${MAC,,}"
	is_mac "$MAC" && [ "${MAC//[0:]/}" != "" ] && (( (16#${MAC:0:2} & 3) == 0 )) && echo "$MAC"
}

is_mac() {
	[[ "$1" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]
}

# The LAN MAC we make from a card MAC: 02 (locally administered) then its last five octets.
from_card() {
	echo "02:${1:3}"
}

# True if card $1 should replace LAN MAC $3, given wlan.mac $2: it's a different card,
# and the LAN MAC was generated ('none') or made from the old card.
card_changed() {
	[ -n "$1" ] && [ "$1" != "${2,,}" ] \
		&& { [ "$2" = "none" ] || { is_mac "$2" && [ "${3,,}" = "$(from_card ${2,,})" ]; }; }
}

# A new LAN MAC: 02 (locally administered) then five random octets.
gen_mac() {
	echo "02:$(od -An -N5 -tx1 /dev/urandom | tr -s ' ' | sed 's/^ //; s/ $//; s/ /:/g')"
}

# The MAC the firmware has in NVRAM, from the SMBIOS UUID it made from it
# (00000000-0000-8000-8000-<MAC>), lower case with colons; nothing if there is no such
# UUID (none stored, or not BirdsLikeWires firmware).
stored_mac() {
	local U
	U=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null)
	U="${U,,}"
	[[ "$U" =~ ^00000000-0000-8000-8000-([0-9a-f]{12})$ ]] || return 0
	sed -E 's/(..)(..)(..)(..)(..)(..)/\1:\2:\3:\4:\5:\6/' <<< "${BASH_REMATCH[1]}"
}

# With no card, on BirdsLikeWires firmware: sets NOCARDLAN to the LAN MAC this unit
# should have (see the notes at the top), given the LAN MAC now ($1): the generated one
# NVRAM holds; or the one generated for this unit and waiting to be stored, if that's
# the LAN MAC now; or a new one (noted in lan.pending). Empty on other firmware. Once
# per run, so a new one is only made once.
nocard_lan() {
	local STORED PENDING
	[ -z "$NOCARDDONE" ] || return 0
	NOCARDDONE=1
	NOCARDLAN=""
	[[ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" == "BirdsLikeWires" ]] || return 0
	STORED=$(stored_mac)
	if [ -n "$STORED" ] && (( (16#${STORED:0:2} & 2) != 0 )); then
		rm -f $STATEDIR/lan.pending
		NOCARDLAN="$STORED"
		return 0
	fi
	PENDING=$(cat $STATEDIR/lan.pending 2>/dev/null)
	if is_mac "$PENDING" && [ "${PENDING,,}" = "${1,,}" ]; then
		NOCARDLAN="${1,,}"
		return 0
	fi
	NOCARDLAN=$(gen_mac)
	mkdir -p $STATEDIR
	echo "$NOCARDLAN" > $STATEDIR/lan.pending
}

# Says $1 in the kernel log (dmesg) as well as our own.
klog() {
	echo "$1"
	echo "<5>of-netplan: $1" > /dev/kmsg 2>/dev/null
}

# Keep boot.nsh's BlwMac.efi line in step with wlan.mac and lan.mac. of-bootnsh only
# adds it on BirdsLikeWires firmware, and only rewrites boot.nsh when it changes.
update_bootnsh() {
	# Run as the boot service (systemd sets INVOCATION_ID), this is the boot: if NVRAM
	# needs the MAC, of-bootnsh reboots for it now, however long the card check took.
	[ -x /usr/local/sbin/of-bootnsh ] &&
		OF_BOOTNSH_AT_BOOT=${INVOCATION_ID:+1} /usr/local/sbin/of-bootnsh mac >/dev/null 2>&1
	# Done: of-mac-gate (which holds the login prompt and any UI until now) can go on.
	mkdir -p /run/of-netplan && touch /run/of-netplan/mac-decided
	return 0
}

# networkd sends its first DHCP DISCOVER within milliseconds of carrier, and on
# the OpenFrame's r8169 that first frame is lost (frames ~50 ms later get through).
# networkd then waits about 4 seconds to retry. Once carrier has settled, restart
# its DHCP client if there's still no IPv4 address: the lease then arrives in about
# half a second. 'networkctl renew' doesn't help here; 'reconfigure' does.
kick_dhcp() {
	local COUNT=0
	while [ $COUNT -lt 200 ] && [ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" != 1 ]; do
		COUNT=$((COUNT+1))
		sleep 0.05
	done
	[ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" = 1 ] || return 0
	sleep 0.3
	if ! ip -4 addr show $LAN | grep -q 'inet '; then
		echo "No IPv4 address on $LAN yet, restarting its DHCP client."
		networkctl reconfigure $LAN
	fi
}

# Remove the network information file if present.
[ -e /tmp/openframe.net ] && rm /tmp/openframe.net

# See if there's a network.yaml config file on /boot.
COUNT=0
while [ $COUNT -lt $CONFIGTIMEOUT -a ! -e /boot/$NETPLANCONFIG ]; do
	COUNT=$((COUNT+1))
 	sleep 1
done

# Configure what's shown on the text login prompt.
if [ $(grep -c 'YOURWIFINAME:' /boot/$NETPLANCONFIG) -gt 0 ]; then
	echo "${ID^} ${VERSION_CODENAME^} \n \l eth0:\4{eth0}" > /etc/issue
else
	echo "${ID^} ${VERSION_CODENAME^} \n \l wlan0:\4{wlan0} eth0:\4{eth0}" > /etc/issue
fi
echo >> /etc/issue

# Unchanged since we last ran? Then the live config is already right.
if [ -e /boot/$NETPLANCONFIG ] && [ -s $STATEDIR/lan.mac ] \
	&& cmp -s /boot/$NETPLANCONFIG $STATEDIR/boot.yaml \
	&& cmp -s /etc/netplan/$NETPLANCONFIG $STATEDIR/live.yaml; then
	echo "No changes to $NETPLANCONFIG since last boot."
	LANMAC=$(cat $STATEDIR/lan.mac)
	# The WLAN adapter may not have appeared yet. Give it up to 8 seconds; the
	# OpenFrame 2 has none, and its file is still written sooner than before.
	WLANMAC=$(card_mac 8)
	OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
	[ -n "$WLANMAC" ] || nocard_lan "$LANMAC"
	if card_changed "$WLANMAC" "$OLDWLAN" "$LANMAC" ||
	   { [ -n "$NOCARDLAN" ] && [ "$NOCARDLAN" != "${LANMAC,,}" ]; }; then
		# A different card (or a first one), or no card and this unit's LAN MAC is
		# another: carry on below and make the LAN MAC again.
		CARDCHECKED=1
	else
		# A card we haven't noted (installed before wlan.mac existed, or the LAN MAC
		# is someone else's): note it, for the serial number.
		if [ -n "$WLANMAC" ] && [ "$WLANMAC" != "${OLDWLAN,,}" ]; then
			echo "$WLANMAC" > $STATEDIR/wlan.mac
		fi
		# The MAC is settled: boot.nsh first (of-mac-gate waits for it, holding the login
		# prompt), then the network. networkd sets the LAN MAC when it starts, which may be
		# after us: wait for it (up to 20 seconds), so /tmp/openframe.net records it.
		update_bootnsh
		COUNT=0
		while [ $COUNT -lt 100 ] && [ "$(cat /sys/class/net/$LAN/address 2>/dev/null)" != "$LANMAC" ]; do
			COUNT=$((COUNT+1))
			sleep 0.2
		done
		write_netinfo
		kick_dhcp
		exit 0
	fi
fi

# If we found one, copy it into the system.
if [ -e /boot/$NETPLANCONFIG ]; then
	cp /boot/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# What network.yaml says now, what we last wrote there, and where that came from.
YAMLMAC=$(yq -r ".network.ethernets.${LAN}.macaddress // empty" /etc/netplan/$NETPLANCONFIG)
OLDLAN=$(cat $STATEDIR/lan.mac 2>/dev/null)
OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
LANMAC="$YAMLMAC"
NEWWLAN="$OLDWLAN"

if [[ -z "$YAMLMAC" ]]; then

	# No MAC yet: make one from the WLAN card if there is one.
	[ -n "$CARDCHECKED" ] || WLANMAC=$(card_mac $WLANTIMEOUT)
	if [ -n "$WLANMAC" ]; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		echo "Found $WLANMAC as $WLAN hardware address."
		echo "Applying $LANMAC to $LAN (local bit set)."
	else
		# No card with an address of its own to mirror: this unit's (from NVRAM, on
		# BirdsLikeWires firmware), else generate one.
		nocard_lan "$OLDLAN"
		if [ -n "$NOCARDLAN" ]; then LANMAC="$NOCARDLAN"; else LANMAC=$(gen_mac); fi
		NEWWLAN="none"
		echo "No burned-in $WLAN hardware address found after $WLANTIMEOUT seconds."
		echo "Applying $LANMAC to $LAN (generated, this unit's)."
	fi

elif [ -n "$OLDLAN" ] && [ "${YAMLMAC,,}" != "${OLDLAN,,}" ]; then

	# Not what we wrote last time, so someone set it. It's theirs from now on. Note the
	# card if there is one; 'none' would let a card that turns up later replace it.
	[ -n "$CARDCHECKED" ] || WLANMAC=$(card_mac 0)
	if [ -n "$WLANMAC" ]; then NEWWLAN="$WLANMAC"; elif ! is_mac "$OLDWLAN"; then NEWWLAN=""; fi
	echo "Hardware address $YAMLMAC for $LAN was set in $NETPLANCONFIG; leaving it alone."

else

	# Ours, someone else's from an earlier boot, or of unknown origin (from before
	# wlan.mac). Look for the card: wait for it if we've seen one, otherwise just
	# look, so an OpenFrame 2 isn't held up.
	if [ -z "$CARDCHECKED" ]; then
		if is_mac "$OLDWLAN"; then WLANMAC=$(card_mac $WLANTIMEOUT); else WLANMAC=$(card_mac 0); fi
	fi
	if card_changed "$WLANMAC" "$OLDWLAN" "$YAMLMAC"; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		if [ "$OLDWLAN" = "none" ]; then
			klog "Found WLAN card $WLANMAC; $LAN MAC is now $LANMAC, made from it (was generated)."
		else
			klog "Hardware MAC change detected: WLAN card $WLANMAC replaces $OLDWLAN; $LAN MAC is now $LANMAC."
		fi
	else
		[ -n "$WLANMAC" ] || nocard_lan "$YAMLMAC"
		if [ -z "$WLANMAC" ] && [ -n "$NOCARDLAN" ] && [ "$NOCARDLAN" != "${YAMLMAC,,}" ]; then
			# No card, on BirdsLikeWires firmware: the LAN MAC is this unit's (see the
			# notes at the top), whatever this stick had.
			LANMAC="$NOCARDLAN"
			NEWWLAN="none"
			klog "No WLAN card; $LAN MAC is now $LANMAC, this unit's (was ${YAMLMAC,,})."
		else
			# The LAN MAC stays as it is: made from this card, someone else's, or, from
			# before wlan.mac, of unknown origin. (Noting the card makes a MAC made from it
			# ours.)
			[ -n "$WLANMAC" ] && NEWWLAN="$WLANMAC"
			echo "Hardware address $LANMAC for $LAN is present."
		fi
	fi

fi

# Write a new LAN MAC to the config file.
if [ "$LANMAC" != "$YAMLMAC" ]; then
	yq -y --arg mac "$LANMAC" ".network.ethernets.${LAN}.macaddress = \$mac" \
		/etc/netplan/$NETPLANCONFIG > /tmp/$NETPLANCONFIG
	mv /tmp/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# Copy the updated config file back to /boot for next time, only if it differs,
# so an unchanged boot doesn't write to the FAT partition.
cmp -s /etc/netplan/$NETPLANCONFIG /boot/$NETPLANCONFIG || boot_put /etc/netplan/$NETPLANCONFIG /boot/$NETPLANCONFIG

# Record the MAC we wrote and where it came from straight away, even if 'netplan apply'
# fails below: network.yaml already holds it, and next boot must see it as ours.
mkdir -p $STATEDIR
echo "$LANMAC" > $STATEDIR/lan.mac
if [ -n "$NEWWLAN" ]; then echo "$NEWWLAN" > $STATEDIR/wlan.mac; else rm -f $STATEDIR/wlan.mac; fi

# The MAC is settled: bring boot.nsh's BlwMac.efi line into step now, before the slower
# steps below, so a reboot for NVRAM (or none) is known as early as it can be.
update_bootnsh

# An unedited template still names YOURWIFINAME. Leave Wi-Fi out of the live config
# then: netplan would start a WPA supplicant for wlan0, which waits 90 seconds for an
# adapter that may not exist (the OpenFrame 2 has none) and then fails. /boot keeps
# the full template, so Wi-Fi can still be filled in there.
if grep -q 'YOURWIFINAME:' /etc/netplan/$NETPLANCONFIG; then
	yq -y 'del(.network.wifis)' /etc/netplan/$NETPLANCONFIG > /tmp/$NETPLANCONFIG
	mv /tmp/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# Go live with the changes, then remember what we left for next boot.
if netplan apply; then
	cp /boot/$NETPLANCONFIG $STATEDIR/boot.yaml
	cp /etc/netplan/$NETPLANCONFIG $STATEDIR/live.yaml
	chmod 600 $STATEDIR/*.yaml
fi

write_netinfo

exit 0
