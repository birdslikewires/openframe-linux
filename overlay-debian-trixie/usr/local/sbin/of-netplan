#!/usr/bin/env bash

## of-netplan v26.11.16 (16th November 2026)
##  Manages the network configuration and MAC addresses on OpenFrame devices.
##
##  The settings are in the settings folder on the boot volume (OF-BOOT/settings,
##  /boot/settings here), for anyone to edit from any computer:
##    wifi.txt      name= and password=: the Wi-Fi network to join, if any; and
##                  address=, gateway=, dns= for a fixed address (empty: automatic).
##    ethernet.txt  address=, gateway=, dns= for the wired network, the same way.
##    network.yaml  only if someone puts one there, for anything more (several Wi-Fi
##                  networks, other interfaces): a netplan configuration, used as it
##                  is. The .txt files then fill in only what it doesn't set up. A MAC
##                  set in it for eth0 is used too.
##  An address is 192.168.1.50/24, or 192.168.1.50 (/24 is assumed), or with a mask,
##  192.168.1.50/255.255.255.0. DNS servers are separated by commas or spaces; with a
##  fixed address and none given, the gateway is asked (as home routers expect). DNS
##  servers given with an automatic address replace the ones the router hands out.
##  When both networks are up, the wired one carries the traffic (route metrics 100
##  and 600).
##  From those we write /etc/netplan/network.yaml, adding the LAN MAC (below). Nothing
##  we decide goes back to the boot volume. A network.yaml that can't be used (not
##  YAML, or netplan refuses it), a Wi-Fi password that can't be right, or an address
##  that isn't one, is left out, so the network still works (automatically), and the
##  login prompt says what's wrong.
##
##  Images before November 2026 had network.yaml in the root of the boot volume, and
##  we wrote the LAN MAC into it. One found there, from an older system or copied there
##  by someone, is moved into the settings folder (migrate_legacy): the template, or
##  the template with only the Wi-Fi name and password filled in, becomes wifi.txt;
##  anything else becomes settings/network.yaml, less a MAC we wrote into it.
##
##  The LAN MAC follows the WLAN card: 02 then the card MAC's last five octets.
##  If no WLAN interface is available, we generate a MAC for the LAN interface, once.
##  So we do if the card has no burned-in address of its own (a locally administered
##  one may be random and change every boot).
##
##  State files in /var/lib/of-netplan:
##    lan.mac   the LAN MAC we last settled on
##    lan.user  there if that MAC was set in settings/network.yaml
##    wlan.mac  the WLAN card's MAC when we last saw one, or 'none' if we haven't
##              and generated the LAN MAC
##    wifi.txt, ethernet.txt, user.yaml, live.yaml, issue.note  the settings we last used, the
##              config we wrote from them, and anything the login prompt must say
##  A LAN MAC that is 02 then wlan.mac's last five octets was made from that card.
##  So when a different card turns up (swapped, or this stick moved to another
##  unit), a LAN MAC made from the old card, or generated, is made again from the
##  new one. Two units can then never share a LAN MAC because they once had each
##  other's cards. The kernel log (dmesg) says when that happens. A MAC set in
##  settings/network.yaml is left alone, and taking it out of there makes one from the
##  card again.
##
##  On BirdsLikeWires firmware the unit's MAC is kept in NVRAM (of-bootnsh has
##  BlwMac.efi store it when it isn't there): the card's own, or with no card the
##  generated LAN MAC. The firmware applies the LAN MAC before any OS starts, and
##  makes the system's UUID from it (00000000-0000-8000-8000-<MAC>), plus for a card
##  its serial number. A generated LAN MAC then belongs to the unit, not this stick:
##  with no card, if NVRAM holds a generated MAC (02...), that is the LAN MAC, so any
##  stick in this unit uses it and a stick moved to another unit takes that unit's.
##  If NVRAM holds a card's MAC but the card has gone, or holds none, a new one is
##  generated and stored: never this stick's old one, which may be another unit's,
##  and not the old card's either, which may be in another unit by now. A card that
##  turns up again takes over as before. A MAC generated for this unit and not yet
##  stored is kept in lan.pending, so it isn't generated afresh every boot while it
##  waits. Generated MACs come from /dev/urandom. On other firmware (no NVRAM to ask) a
##  generated LAN MAC is made once and kept; and with no card, a LAN MAC made from a card
##  is never kept: the card may be in another unit, or this stick in another unit, whose
##  LAN would then share it. A new one is generated instead (after waiting the full
##  WLANTIMEOUT for the card, so a slow one isn't mistaken for a missing one).
##
##  We're also responsible for /etc/issue
##
##  If the settings and the live config all match what we left last boot, nothing has
##  changed. Then we skip the rest, including 'netplan apply': the netplan generator
##  has already configured the network from /etc/netplan, and applying again costs a
##  daemon-reload and a second DHCP exchange on every boot.
##
##  'of-netplan --early' is run by udev (70-of-eth0-up.rules) as soon as eth0
##  appears. It sets the LAN MAC we settled on last boot and brings the link up,
##  so the PHY's ~2 s of autonegotiation is done before networkd starts rather
##  than after it.

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

source /etc/os-release

LAN="eth0"
WLAN="wlan0"
WLANTIMEOUT=15
BOOTTIMEOUT=10
SETDIR="/boot/settings"
WIFITXT="$SETDIR/wifi.txt"
ETHTXT="$SETDIR/ethernet.txt"
USERYAML="$SETDIR/network.yaml"
LEGACYYAML="/boot/network.yaml"
# The blank wifi.txt and ethernet.txt that new images have (this package's copies).
WIFITEMPLATE="/usr/lib/openframe/settings/wifi.txt"
ETHTEMPLATE="/usr/lib/openframe/settings/ethernet.txt"
LIVE="/etc/netplan/network.yaml"
STATEDIR="/var/lib/of-netplan"
# Debian's yq (a jq wrapper; openframe-scripts depends on it), by its full path: a yq
# earlier in PATH may be another program altogether.
YQ="/usr/bin/yq"
# The configuration without settings/network.yaml. Ethernet from ethernet.txt, Wi-Fi
# from wifi.txt and the LAN MAC are added to it.
DEFAULTJSON='{"network":{"version":2,"renderer":"networkd"}}'

# Early mode, from udev: MAC first (while the link is down, so it's right from the
# first frame and networkd has nothing to change), then link up. Nothing else.
if [ "$1" = "--early" ]; then
	MAC=$(cat $STATEDIR/lan.mac 2>/dev/null)
	if [[ "$MAC" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]; then
		ip link set dev $LAN address "$MAC"
	fi
	ip link set dev $LAN up
	exit 0
fi

# Create /tmp/openframe.net as a quick network information reference.
write_netinfo() {
	MACW=$(ip link | sed -n '/wlan0/{n;p;}' | awk -F\  {'print $2'})
	MACE=$(ip link | sed -n '/eth0/{n;p;}' | awk -F\  {'print $2'})
	[[ "$MACW" == "" ]] && MACW="00:00:00:00:00:00"
	[[ "$MACE" == "" ]] && MACE="00:00:00:00:00:00"
	echo "$MACW"/"$MACE"/"$(hostname)" > /tmp/openframe.net
}

# /boot is mounted read-only, so a power cut can't corrupt it. This makes it writable
# until the script exits (/usr/lib/openframe/bootrw keeps it writable while any other
# writer still needs it, and puts it back after the last).
BOOTRW=""
boot_rw() {
	[ -z "$BOOTRW" ] || return 0
	/usr/lib/openframe/bootrw open || return 1
	BOOTRW=done
	trap '/usr/lib/openframe/bootrw close' EXIT
}

# Replaces file $2 on /boot with a copy of $1. FAT has no journal and writes its
# metadata in no particular order, so the copy is synced before it's renamed over
# the old file: a power cut leaves one or the other. The first sync puts anything
# deleted earlier on disk before its space is reused.
boot_put() {
	boot_rw
	sync
	cp "$1" "$2.new" && sync && mv -f "$2.new" "$2" && sync
}

# The WLAN card's own (burned-in) MAC, waiting up to $1 seconds for the card to appear
# (0: just look): its permanent address if the kernel shows one (something changed the
# current one), else its current one. A locally administered address (02 bit set:
# randomised, or made up by a driver for a card with none stored) isn't the card's own
# and may change from boot to boot, so it counts as no card: a LAN MAC is then
# generated once and kept.
card_mac() {
	local COUNT=0 MAC
	while [ $COUNT -lt $(($1 * 5)) ] && [ ! -e /sys/class/net/$WLAN/address ]; do
		COUNT=$((COUNT+1))
		sleep 0.2
	done
	MAC=$(ip -d link show dev $WLAN 2>/dev/null | grep -o 'permaddr [0-9a-fA-F:]*' | cut -d' ' -f2)
	[ -n "$MAC" ] || MAC=$(cat /sys/class/net/$WLAN/address 2>/dev/null)
	MAC="${MAC,,}"
	is_mac "$MAC" && [ "${MAC//[0:]/}" != "" ] && (( (16#${MAC:0:2} & 3) == 0 )) && echo "$MAC"
}

is_mac() {
	[[ "$1" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]
}

# The LAN MAC we make from a card MAC: 02 (locally administered) then its last five octets.
from_card() {
	echo "02:${1:3}"
}

# True if card $1 should replace LAN MAC $3, given wlan.mac $2: it's a different card,
# and the LAN MAC was generated ('none') or made from the old card.
card_changed() {
	[ -n "$1" ] && [ "$1" != "${2,,}" ] \
		&& { [ "$2" = "none" ] || { is_mac "$2" && [ "${3,,}" = "$(from_card ${2,,})" ]; }; }
}

# A new LAN MAC: 02 (locally administered) then five random octets.
gen_mac() {
	echo "02:$(od -An -N5 -tx1 /dev/urandom | tr -s ' ' | sed 's/^ //; s/ $//; s/ /:/g')"
}

# The MAC the firmware has in NVRAM, from the SMBIOS UUID it made from it
# (00000000-0000-8000-8000-<MAC>), lower case with colons; nothing if there is no such
# UUID (none stored, or not BirdsLikeWires firmware).
stored_mac() {
	local U
	U=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null)
	U="${U,,}"
	[[ "$U" =~ ^00000000-0000-8000-8000-([0-9a-f]{12})$ ]] || return 0
	sed -E 's/(..)(..)(..)(..)(..)(..)/\1:\2:\3:\4:\5:\6/' <<< "${BASH_REMATCH[1]}"
}

# With no card, on BirdsLikeWires firmware: sets NOCARDLAN to the LAN MAC this unit
# should have (see the notes at the top), given the LAN MAC now ($1): the generated one
# NVRAM holds; or the one generated for this unit and waiting to be stored, if that's
# the LAN MAC now; or a new one (noted in lan.pending). Empty on other firmware. Once
# per run, so a new one is only made once.
nocard_lan() {
	local STORED PENDING
	[ -z "$NOCARDDONE" ] || return 0
	NOCARDDONE=1
	NOCARDLAN=""
	[[ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" == "BirdsLikeWires" ]] || return 0
	STORED=$(stored_mac)
	if [ -n "$STORED" ] && (( (16#${STORED:0:2} & 2) != 0 )); then
		rm -f $STATEDIR/lan.pending
		NOCARDLAN="$STORED"
		return 0
	fi
	PENDING=$(cat $STATEDIR/lan.pending 2>/dev/null)
	if is_mac "$PENDING" && [ "${PENDING,,}" = "${1,,}" ]; then
		NOCARDLAN="${1,,}"
		return 0
	fi
	NOCARDLAN=$(gen_mac)
	mkdir -p $STATEDIR
	echo "$NOCARDLAN" > $STATEDIR/lan.pending
}

# True if LAN MAC $1 was made from card $2 (wlan.mac): 02 then the card's last five octets.
card_made() {
	is_mac "$2" && [ "${1,,}" = "$(from_card ${2,,})" ]
}

# True if MAC $1, found in an old network.yaml in the root of the boot volume, is one
# we wrote there rather than one someone typed: the LAN MAC we noted, made from the
# card we noted or generated; or the one NVRAM holds for this unit (made from its
# card's, or generated), for a file from an older image of this unit copied onto a
# new one.
mac_ours() {
	local M="${1,,}" L W S
	L=$(cat $STATEDIR/lan.mac 2>/dev/null)
	W=$(cat $STATEDIR/wlan.mac 2>/dev/null)
	if [ "$M" = "${L,,}" ] && { [ "$W" = "none" ] || card_made "$M" "$W"; }; then
		return 0
	fi
	S=$(stored_mac)
	[ -n "$S" ] && { [ "$M" = "$S" ] || [ "$M" = "$(from_card "$S")" ]; }
}

# The settings in file $1 (wifi.txt or ethernet.txt), in variables named $2_ and the
# setting: name, password, address, gateway and dns (empty if not set). It's read with
# bash alone, never run. Spaces around the names, the = and the values don't count,
# nor do quotes around a value, Windows line endings, or the byte-order mark some
# editors put at the start. Lines starting with # are notes.
read_txt() {
	local line k v
	for k in name password address gateway dns; do printf -v "$2_$k" '%s' ""; done
	[ -r "$1" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		line="${line#$'\xef\xbb\xbf'}"
		[[ "$line" == *=* ]] || continue
		k="${line%%=*}"
		v="${line#*=}"
		k="${k//[[:space:]]/}"
		k="${k,,}"
		v="${v#"${v%%[![:space:]]*}"}"
		v="${v%"${v##*[![:space:]]}"}"
		if (( ${#v} >= 2 )) && [[ ${v:0:1} == [\"\'] && ${v: -1} == "${v:0:1}" ]]; then
			v="${v:1:${#v}-2}"
		fi
		case "$k" in
			name|password|address|gateway|dns) printf -v "$2_$k" '%s' "$v" ;;
		esac
	done < "$1"
}

# True if $1 is an IPv4 address (four numbers 0-255 with dots).
is_ip4() {
	local IFS=. o
	[[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
	for o in $1; do (( 10#$o <= 255 )) || return 1; done
}

# Address $1 (is_ip4) with each part a plain number: 192.168.1.050 is 192.168.1.50, as
# netplan and networkd want it (written as given, they refuse it, and with it the whole
# configuration).
norm_ip4() {
	local IFS=. o out=""
	for o in $1; do out+="${out:+.}$((10#$o))"; done
	echo "$out"
}

# The prefix length for netmask $1 (255.255.255.0 is 24); false if it isn't one.
mask_prefix() {
	local IFS=. o v=0 n=0 i
	is_ip4 "$1" || return 1
	for o in $1; do (( v = v * 256 + 10#$o )); done
	for (( i = 31; i >= 0; i-- )); do (( (v >> i) & 1 )) || break; (( n++ )); done
	(( n >= 1 && (v & ((1 << (32 - n)) - 1)) == 0 )) || return 1
	echo "$n"
}

# The address settings read_txt found under prefix $1 (from file $2, $3 naming the
# network in notes), as netplan wants them: $1_ADDR (address/prefix, or empty for
# automatic), $1_GW (or empty) and $1_DNS (a JSON list). Anything that isn't right is
# left out with a note for the login prompt, and an address that isn't one leaves the
# network automatic.
static_settings() {
	local p="$1" v a g d ip pre x dns=()
	v="${p}_address"; a="${!v}"
	v="${p}_gateway"; g="${!v}"
	v="${p}_dns"; d="${!v}"
	printf -v "${p}_ADDR" '%s' ""
	printf -v "${p}_GW" '%s' ""
	printf -v "${p}_DNS" '%s' "[]"
	if [ -n "$a" ]; then
		ip="${a%%/*}"
		if [[ "$a" == */* ]]; then pre="${a#*/}"; else pre=24; fi
		[[ "$pre" == *.* ]] && { pre=$(mask_prefix "$pre") || pre=""; }
		if is_ip4 "$ip" && [[ "$pre" =~ ^[0-9]{1,2}$ ]] && (( 10#$pre >= 1 && 10#$pre <= 32 )); then
			printf -v "${p}_ADDR" '%s' "$(norm_ip4 "$ip")/$((10#$pre))"
		else
			NOTES+=("$3: the address in settings/$2 isn't one, so the address is automatic.")
			return 0
		fi
	fi
	if [ -n "$g" ]; then
		if [ -z "$a" ]; then
			NOTES+=("$3: the gateway in settings/$2 is only used with an address there.")
		elif is_ip4 "$g"; then
			printf -v "${p}_GW" '%s' "$(norm_ip4 "$g")"
		else
			NOTES+=("$3: the gateway in settings/$2 isn't an address, so there's none.")
		fi
	fi
	# Split without filename expansion (dns=* is just a mistake, not a list of files).
	local xs
	read -ra xs <<< "${d//,/ }"
	for x in "${xs[@]}"; do
		if is_ip4 "$x"; then
			dns+=("\"$(norm_ip4 "$x")\"")
		else
			NOTES+=("$3: '$x' in dns in settings/$2 isn't an address, so it's left out.")
		fi
	done
	v="${p}_GW"
	if (( ${#dns[@]} == 0 )) && [ -n "$a" ] && [ -n "${!v}" ]; then
		dns=("\"${!v}\"")
	fi
	local IFS=,
	printf -v "${p}_DNS" '[%s]' "${dns[*]}"
}

# True if WIFIPASS could be a WPA password: none (an open network), 8 to 63
# characters, or 64 hex digits (the key itself).
wifi_pass_ok() {
	[ -z "$WIFIPASS" ] || { (( ${#WIFIPASS} >= 8 && ${#WIFIPASS} <= 63 )); } ||
		[[ "$WIFIPASS" =~ ^[0-9a-fA-F]{64}$ ]]
}

# Writes wifi.txt on /boot with name $1 and password $2, from the blank one new images
# have, so its notes are the same. With it, ethernet.txt if there's none.
write_wifi() {
	local T=/tmp/of-netplan-wifi.txt line
	{
		if [ -r "$WIFITEMPLATE" ]; then
			while IFS= read -r line || [ -n "$line" ]; do
				case "$line" in
					name=*) printf 'name=%s\n' "$1" ;;
					password=*) printf 'password=%s\n' "$2" ;;
					*) printf '%s\n' "$line" ;;
				esac
			done < "$WIFITEMPLATE"
		else
			printf 'name=%s\npassword=%s\n' "$1" "$2"
		fi
	} > "$T" && boot_put "$T" "$WIFITXT"
	rm -f "$T"
	if [ ! -e "$ETHTXT" ] && [ -r "$ETHTEMPLATE" ]; then
		boot_put "$ETHTEMPLATE" "$ETHTXT"
	fi
}

# Moves an old network.yaml from the root of the boot volume into the settings folder
# (see the notes at the top). Its Wi-Fi name and password go into wifi.txt if that's
# all anyone changed in the template: any of its versions, with or without
# dhcp-identifier. Otherwise it's someone's own configuration, and goes in as
# settings/network.yaml, less a MAC we wrote into it (a MAC someone typed stays); one
# that was there already is kept as network.yaml.old. One that can't be read goes in
# as it is: it's not used until someone puts it right (see read_user_yaml), and in the
# meantime Ethernet works.
migrate_legacy() {
	local OUT=() KIND MAC NAME PASS OURS T=/tmp/of-netplan-legacy.yaml
	[ -f "$LEGACYYAML" ] || return 0
	boot_rw || return 0
	mkdir -p "$SETDIR"
	mapfile -t OUT < <("$YQ" -r --arg lan "$LAN" --arg wlan "$WLAN" '
		def plain: del(.network.ethernets[$lan]["dhcp-identifier"] | select(. == "mac"))
			| del(.network.wifis[$wlan]["dhcp-identifier"] | select(. == "mac"));
		def template($n; $p): {"network": {"version": 2, "renderer": "networkd",
			"ethernets": {($lan): {"dhcp4": true}},
			"wifis": {($wlan): {"dhcp4": true,
				"access-points": {($n): (if $p == null then {} else {"password": $p} end)}}}}};
		if (.network | type) != "object" then error("not netplan") else . end
		| (.network.ethernets[$lan].macaddress // "") as $mac
		| (if $mac == "" then . else del(.network.ethernets[$lan].macaddress) end) as $rest
		| ($rest.network.wifis[$wlan]["access-points"] // {}) as $aps
		| (if ($aps | type) == "object" and ($aps | length) == 1 then ($aps | keys[0]) else null end) as $n
		| (if $n == null then null elif ($aps[$n] | type) == "object" then $aps[$n].password else 0 end) as $p
		| if $n != null and ($p == null or ($p | type) == "string")
		     and ($rest | plain) == template($n; $p)
		  then "template", $mac, $n, ($p // "")
		  else "own", $mac end' "$LEGACYYAML" 2>/dev/null)
	KIND="${OUT[0]}" MAC="${OUT[1]}" NAME="${OUT[2]}" PASS="${OUT[3]}"
	[ -n "$MAC" ] && mac_ours "$MAC" && OURS=1 || OURS=""

	if [ "$KIND" = "template" ] && { [ -z "$MAC" ] || [ -n "$OURS" ]; }; then
		if [ "$NAME" = "YOURWIFINAME" ]; then
			[ -e "$WIFITXT" ] || write_wifi "" ""
			klog "Moved network settings into settings/wifi.txt (no Wi-Fi was set up)."
		else
			write_wifi "$NAME" "$PASS"
			klog "Moved network settings into settings/wifi.txt (Wi-Fi network '$NAME')."
		fi
	else
		boot_rw
		sync
		[ -e "$USERYAML" ] && mv -f "$USERYAML" "$USERYAML.old"
		if [ -n "$OURS" ] && "$YQ" -y --arg lan "$LAN" 'del(.network.ethernets[$lan].macaddress)' \
				"$LEGACYYAML" > "$T" 2>/dev/null && [ -s "$T" ]; then
			boot_put "$T" "$USERYAML"
		else
			boot_put "$LEGACYYAML" "$USERYAML"
		fi
		rm -f "$T"
		[ -e "$WIFITXT" ] || write_wifi "" ""
		klog "Moved network.yaml into the settings folder${OURS:+ (less the MAC we had written into it)}."
	fi
	sync
	# With the Mac's companion file (._network.yaml), if a Mac has been at it: alone
	# it's clutter.
	rm -f "$LEGACYYAML" "${LEGACYYAML%/*}/._${LEGACYYAML##*/}"
	sync
}

# Reads settings/network.yaml: false if it isn't a netplan configuration we can read.
# Sets USERMAC to the MAC it sets for eth0, if any, and USERWIFI to 'true' if it sets
# up any Wi-Fi of its own (the old template's YOURWIFINAME doesn't count: it's left out).
read_user_yaml() {
	local OUT
	USERMAC="" USERWIFI=""
	OUT=$("$YQ" -r --arg lan "$LAN" --arg wlan "$WLAN" '
		if (.network | type) != "object" then error("not netplan") else . end
		| "\(.network.ethernets[$lan].macaddress // "")|\(((.network.wifis // {}) | length) > 0
			and ((.network.wifis[$wlan]["access-points"] // {}) | has("YOURWIFINAME") | not))"' \
		"$USERYAML" 2>/dev/null) || return 1
	[[ "$OUT" == *"|"* ]] || return 1
	USERMAC="${OUT%%|*}"
	USERWIFI="${OUT##*|}"
	[ -z "$USERMAC" ] || is_mac "$USERMAC"
}

# Writes the live config: base $1 (settings/network.yaml, or - for none), with eth0's
# MAC set to $2 (none: as the base has it), Ethernet from ethernet.txt if the base
# doesn't set eth0 up, any YOURWIFINAME template left out, and the network from
# wifi.txt added if WIFIUSE says so and the base has no Wi-Fi. Only a result that is
# still a netplan config replaces it, so a yq that fails can't fill the file with its
# error message.
build_live() {
	local NAME="" T="$LIVE.new"
	[ -n "$WIFIUSE" ] && NAME="$WIFINAME"
	mkdir -p "${LIVE%/*}"
	if { if [ "$1" = "-" ]; then echo "$DEFAULTJSON"; else cat "$1"; fi; } |
	   "$YQ" -y --arg lan "$LAN" --arg wlan "$WLAN" --arg mac "$2" \
	         --arg name "$NAME" --arg pass "$WIFIPASS" \
	         --arg eaddr "$E_ADDR" --arg egw "$E_GW" --argjson edns "$E_DNS" \
	         --arg waddr "$W_ADDR" --arg wgw "$W_GW" --argjson wdns "$W_DNS" '
		def net($addr; $gw; $dns; $metric):
			(if $addr == "" then {"dhcp4": true, "dhcp-identifier": "mac",
				"dhcp4-overrides": {"route-metric": $metric}}
			 else {"dhcp4": false, "addresses": [$addr]}
				+ (if $gw != "" then {"routes": [{"to": "default", "via": $gw, "metric": $metric}]}
				   else {} end) end)
			+ (if ($dns | length) > 0 then {"nameservers": {"addresses": $dns}} else {} end)
			| (if $addr == "" and ($dns | length) > 0
			   then .["dhcp4-overrides"]["use-dns"] = false else . end);
		(if $mac != "" then .network.ethernets[$lan].macaddress = $mac else . end)
		| (if ((.network.ethernets[$lan] // {}) | del(.macaddress) | length) == 0
		   then .network.ethernets[$lan] = ((.network.ethernets[$lan] // {}) + net($eaddr; $egw; $edns; 100))
		   else . end)
		| (if ((.network.wifis[$wlan]["access-points"] // {}) | type) == "object"
		      and ((.network.wifis[$wlan]["access-points"] // {}) | has("YOURWIFINAME"))
		   then del(.network.wifis) else . end)
		| (if $name != "" and ((.network.wifis // {}) | length) == 0 then
			.network.wifis[$wlan] = (net($waddr; $wgw; $wdns; 600)
				+ {"access-points": {($name): (if $pass == "" then {} else {"password": $pass} end)}})
		   else . end)' > "$T" 2>/dev/null &&
	   [ -s "$T" ] && "$YQ" -e '.network | type == "object"' "$T" > /dev/null 2>&1; then
		chmod 600 "$T"
		mv -f "$T" "$LIVE"
		return 0
	fi
	rm -f "$T"
	klog "Could not write $LIVE with $YQ."
	return 1
}

# True if file $1 is as it was when we last used it (our copy, $2 in STATEDIR): both
# there and the same, or neither.
unchanged() {
	if [ -e "$1" ]; then cmp -s "$1" "$STATEDIR/$2"; else [ ! -e "$STATEDIR/$2" ]; fi
}

# Keeps a copy of file $1 as $2 in STATEDIR, or none if it isn't there.
remember() {
	if [ -e "$1" ]; then
		cp "$1" "$STATEDIR/$2" && chmod 600 "$STATEDIR/$2"
	else
		rm -f "$STATEDIR/$2"
	fi
}

# The text login prompt: the addresses (wlan0's only if Wi-Fi is set up, or "missing"
# if wifi.txt has a network but there's no wlan0 to join it with: no card, or this
# stick is in a unit without one), then anything about the settings that someone needs
# to put right (issue.note).
write_issue() {
	if grep -q 'wifis:' "$LIVE" 2>/dev/null; then
		echo "${ID^} ${VERSION_CODENAME^} \n \l wlan0:\4{wlan0} eth0:\4{eth0}" > /etc/issue
	elif [ -n "$WIFINAME" ] && [ ! -e /sys/class/net/$WLAN ]; then
		echo "${ID^} ${VERSION_CODENAME^} \n \l wlan0:missing eth0:\4{eth0}" > /etc/issue
	else
		echo "${ID^} ${VERSION_CODENAME^} \n \l eth0:\4{eth0}" > /etc/issue
	fi
	echo >> /etc/issue
	if [ -s $STATEDIR/issue.note ]; then
		cat $STATEDIR/issue.note >> /etc/issue
		echo >> /etc/issue
	fi
}

# Says $1 in the kernel log (dmesg) as well as our own.
klog() {
	echo "$1"
	echo "<5>of-netplan: $1" > /dev/kmsg 2>/dev/null
}

# Keep boot.nsh's BlwMac.efi line in step with wlan.mac and lan.mac. of-bootnsh only
# adds it on BirdsLikeWires firmware, and only rewrites boot.nsh when it changes.
update_bootnsh() {
	# Run as the boot service (systemd sets INVOCATION_ID), this is the boot: if NVRAM
	# needs the MAC, of-bootnsh reboots for it now, however long the card check took.
	[ -x /usr/local/sbin/of-bootnsh ] &&
		OF_BOOTNSH_AT_BOOT=${INVOCATION_ID:+1} /usr/local/sbin/of-bootnsh mac >/dev/null 2>&1
	release_gate
	return 0
}

# An interface whose config is changing this boot still has the address networkd got
# for it from last boot's config (by DHCP with last boot's MAC, say, on a stick moved
# to another unit), until 'netplan apply' brings the new one, which may well differ.
# The login prompt, which the gate lets show before that, would show the old one
# meanwhile (Andy had typed it into ssh by the time it changed). So it comes off now:
# the prompt shows nothing for that interface until its real address arrives. The
# interfaces are LAN and WLAN, the two the prompt shows; one that isn't there, or
# whose config is the same, is left alone. One yq for both (each costs most of a
# second here, and the prompt waits for this). With no config at boot (first boot)
# nothing had an address from it, so there's nothing to do.
stale_addresses() {
	local IF
	[ -s /run/of-netplan/boot.yaml ] || return 0
	for IF in $("$YQ" -r -s --arg lan "$LAN" --arg wlan "$WLAN" '
		def cfg($i): .network.ethernets[$i] // .network.wifis[$i];
		.[0] as $old | .[1] as $new
		| ($lan, $wlan) as $i | select(($old | cfg($i)) != ($new | cfg($i))) | $i' \
		/run/of-netplan/boot.yaml "$LIVE" 2>/dev/null); do
		[ -e /sys/class/net/$IF ] || continue
		ip -4 addr show dev "$IF" scope global | grep -q 'inet ' || continue
		ip -4 addr flush dev "$IF" scope global && echo "$IF's address was from last boot's settings: taken off until the new one comes."
	done
}

# Lets of-mac-gate (which holds the login prompt and any UI until the MAC is settled) go
# on. It then holds only while /run/of-bootnsh/mac-reboot says a reboot is on its way.
release_gate() {
	mkdir -p /run/of-netplan && touch /run/of-netplan/mac-decided
}

# networkd sets the LAN MAC when it starts, which may be after us: wait for it (up to
# 20 seconds), so /tmp/openframe.net records it.
wait_lan_mac() {
	local COUNT=0
	while [ $COUNT -lt 100 ] && [ "$(cat /sys/class/net/$LAN/address 2>/dev/null)" != "${1,,}" ]; do
		COUNT=$((COUNT+1))
		sleep 0.2
	done
}

# networkd sends its first DHCP DISCOVER within milliseconds of carrier, and on
# the OpenFrame's r8169 that first frame is lost (frames ~50 ms later get through).
# networkd then waits about 4 seconds to retry. Once carrier has settled, restart
# its DHCP client if there's still no IPv4 address: the lease then arrives in about
# half a second. 'networkctl renew' doesn't help here; 'reconfigure' does.
kick_dhcp() {
	local COUNT=0
	while [ $COUNT -lt 200 ] && [ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" != 1 ]; do
		COUNT=$((COUNT+1))
		sleep 0.05
	done
	[ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" = 1 ] || return 0
	sleep 0.3
	if ! ip -4 addr show $LAN | grep -q 'inet '; then
		echo "No IPv4 address on $LAN yet, restarting its DHCP client."
		networkctl reconfigure $LAN
	fi
}

# Remove the network information file if present.
[ -e /tmp/openframe.net ] && rm /tmp/openframe.net

# /boot should be mounted before we start; give it a moment if not.
COUNT=0
while [ $COUNT -lt $BOOTTIMEOUT ] && ! mountpoint -q /boot; do
	COUNT=$((COUNT+1))
	sleep 1
done

mkdir -p $STATEDIR
# Left by versions before the settings folder.
rm -f $STATEDIR/boot.yaml

migrate_legacy
read_txt "$WIFITXT" W
read_txt "$ETHTXT" E
WIFINAME="$W_name"
WIFIPASS="$W_password"

# Unchanged since we last ran? Then the live config is already right.
if [ -s $STATEDIR/lan.mac ] && unchanged "$WIFITXT" wifi.txt && unchanged "$ETHTXT" ethernet.txt \
	&& unchanged "$USERYAML" user.yaml \
	&& [ -e $STATEDIR/live.yaml ] && cmp -s "$LIVE" $STATEDIR/live.yaml; then
	echo "No changes to the network settings since last boot."
	write_issue
	LANMAC=$(cat $STATEDIR/lan.mac)
	OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
	if [ -e $STATEDIR/lan.user ]; then
		# The MAC set in settings/network.yaml: nothing to decide. Note a card that's
		# turned up, for the serial number.
		WLANMAC=$(card_mac 0)
		if [ -n "$WLANMAC" ] && [ "$WLANMAC" != "${OLDWLAN,,}" ]; then
			echo "$WLANMAC" > $STATEDIR/wlan.mac
		fi
		update_bootnsh
		wait_lan_mac "$LANMAC"
		write_netinfo
		kick_dhcp
		exit 0
	fi
	# No card noted last boot ('none', or no wlan.mac), on BirdsLikeWires firmware, and
	# NVRAM already holds this LAN MAC (so it's generated, this unit's: with a card NVRAM
	# holds the card's own 00 MAC, never the LAN's 02 one): unless a card turns up in the
	# wait below, nothing needs storing. So let of-mac-gate go now, rather than hold the
	# splash, login prompt and UI through the wait on every boot. A card fitted since
	# (the unit has been opened) still gets its MAC stored, by a reboot once the UI is up.
	if ! is_mac "$OLDWLAN" && is_mac "$LANMAC" && [ "$(stored_mac)" = "${LANMAC,,}" ] &&
	   [[ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" == "BirdsLikeWires" ]]; then
		release_gate
	# Likewise on other firmware, when last boot found no card ('none'): the LAN MAC is the
	# one generated and kept for this stick (there's no NVRAM to ask), so it stays unless a
	# card turns up in the wait below, and the address networkd has is this boot's. (A card
	# that does turn up changes the MAC, and the address, after the prompt has shown: as
	# rare as fitting one.)
	elif [ "$OLDWLAN" = "none" ] && is_mac "$LANMAC" &&
	     [[ "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)" != "BirdsLikeWires" ]]; then
		release_gate
	fi
	# The WLAN adapter may not have appeared yet. Give it up to 8 seconds; the
	# OpenFrame 2 has none, and its file is still written sooner than before.
	WLANMAC=$(card_mac 8)
	[ -n "$WLANMAC" ] || nocard_lan "$LANMAC"
	if [ -z "$WLANMAC" ] && [ -z "$NOCARDLAN" ] && card_made "$LANMAC" "$OLDWLAN"; then
		# No card, no NVRAM to ask, and a LAN MAC made from a card: carry on below, which
		# waits the full WLANTIMEOUT for the card before giving its MAC up.
		:
	elif card_changed "$WLANMAC" "$OLDWLAN" "$LANMAC" ||
	   { [ -n "$NOCARDLAN" ] && [ "$NOCARDLAN" != "${LANMAC,,}" ]; }; then
		# A different card (or a first one), or no card and this unit's LAN MAC is
		# another: carry on below and make the LAN MAC again.
		CARDCHECKED=1
	elif { grep -q 'wifis:' "$LIVE" && [ ! -e /sys/class/net/$WLAN ]; } ||
	     { [ -n "$WIFINAME" ] && ! grep -q 'wifis:' "$LIVE" && [ -e /sys/class/net/$WLAN ]; }; then
		# Wi-Fi set up with no Wi-Fi interface now (the card's gone, or this stick has
		# moved to a unit without one), or left out for want of one that's here now:
		# carry on below and make the live config again.
		CARDCHECKED=1
	else
		# A card we haven't noted (installed before wlan.mac existed, or the LAN MAC
		# is someone else's): note it, for the serial number.
		if [ -n "$WLANMAC" ] && [ "$WLANMAC" != "${OLDWLAN,,}" ]; then
			echo "$WLANMAC" > $STATEDIR/wlan.mac
		fi
		# The MAC is settled: boot.nsh first (of-mac-gate waits for it, holding the login
		# prompt), then the network.
		update_bootnsh
		wait_lan_mac "$LANMAC"
		write_netinfo
		kick_dhcp
		exit 0
	fi
fi

# What the settings say. A network.yaml that can't be read isn't used; Ethernet and
# wifi.txt still are.
NOTES=()
USEUSER=""
USERMAC=""
USERWIFI=""
if [ -e "$USERYAML" ]; then
	if read_user_yaml; then
		USEUSER=1
	else
		USERMAC="" USERWIFI=""
		klog "Could not read settings/network.yaml as a netplan configuration, so it isn't used."
		NOTES+=("settings/network.yaml can't be read, so it isn't used.")
	fi
fi
WIFIUSE=""
if [ -n "$WIFINAME" ]; then
	if [ "$USERWIFI" = "true" ]; then
		echo "wifi.txt isn't used: settings/network.yaml sets up Wi-Fi itself."
	elif ! wifi_pass_ok; then
		klog "The Wi-Fi password in wifi.txt isn't 8 to 63 characters, so Wi-Fi isn't set up."
		NOTES+=("Wi-Fi: the password in settings/wifi.txt must be 8 to 63 characters.")
	else
		WIFIUSE=1
	fi
fi
static_settings E ethernet.txt Ethernet
static_settings W wifi.txt Wi-Fi

OLDLAN=$(cat $STATEDIR/lan.mac 2>/dev/null)
OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
NEWWLAN="$OLDWLAN"

if [ -n "$USERMAC" ]; then

	# Set in settings/network.yaml, so it's theirs. Note the card if there is one;
	# 'none' would let a card that turns up later replace it.
	LANMAC="$USERMAC"
	[ -n "$CARDCHECKED" ] || WLANMAC=$(card_mac 0)
	if [ -n "$WLANMAC" ]; then NEWWLAN="$WLANMAC"; elif ! is_mac "$OLDWLAN"; then NEWWLAN=""; fi
	echo "Hardware address $USERMAC for $LAN is set in settings/network.yaml; leaving it alone."

elif ! is_mac "$OLDLAN" || [ -e $STATEDIR/lan.user ]; then

	# No MAC yet (or the one set in network.yaml has been taken out of it): make one
	# from the WLAN card if there is one.
	[ -n "$CARDCHECKED" ] || WLANMAC=$(card_mac $WLANTIMEOUT)
	if [ -n "$WLANMAC" ]; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		echo "Found $WLANMAC as $WLAN hardware address."
		echo "Applying $LANMAC to $LAN (local bit set)."
	else
		# No card with an address of its own to mirror: this unit's (from NVRAM, on
		# BirdsLikeWires firmware), else generate one.
		nocard_lan "$OLDLAN"
		if [ -n "$NOCARDLAN" ]; then LANMAC="$NOCARDLAN"; else LANMAC=$(gen_mac); fi
		NEWWLAN="none"
		echo "No burned-in $WLAN hardware address found after $WLANTIMEOUT seconds."
		echo "Applying $LANMAC to $LAN (generated, this unit's)."
	fi

else

	# Ours, someone else's from an earlier boot, or of unknown origin (from before
	# wlan.mac). Look for the card: wait for it if we've seen one, otherwise just
	# look, so an OpenFrame 2 isn't held up.
	LANMAC="$OLDLAN"
	if [ -z "$CARDCHECKED" ]; then
		if is_mac "$OLDWLAN"; then WLANMAC=$(card_mac $WLANTIMEOUT); else WLANMAC=$(card_mac 0); fi
	fi
	if card_changed "$WLANMAC" "$OLDWLAN" "$OLDLAN"; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		if [ "$OLDWLAN" = "none" ]; then
			klog "Found WLAN card $WLANMAC; $LAN MAC is now $LANMAC, made from it (was generated)."
		else
			klog "Hardware MAC change detected: WLAN card $WLANMAC replaces $OLDWLAN; $LAN MAC is now $LANMAC."
		fi
	else
		[ -n "$WLANMAC" ] || nocard_lan "$OLDLAN"
		if [ -z "$WLANMAC" ] && [ -n "$NOCARDLAN" ] && [ "$NOCARDLAN" != "${OLDLAN,,}" ]; then
			# No card, on BirdsLikeWires firmware: the LAN MAC is this unit's (see the
			# notes at the top), whatever this stick had.
			LANMAC="$NOCARDLAN"
			NEWWLAN="none"
			klog "No WLAN card; $LAN MAC is now $LANMAC, this unit's (was ${OLDLAN,,})."
		elif [ -z "$WLANMAC" ] && [ -z "$NOCARDLAN" ] && card_made "$OLDLAN" "$OLDWLAN"; then
			# No card, and no NVRAM to ask: a MAC made from a card that isn't here may be
			# another unit's now, so don't keep it.
			LANMAC=$(gen_mac)
			NEWWLAN="none"
			klog "No WLAN card; $LAN MAC is now $LANMAC, generated (was ${OLDLAN,,}, made from card ${OLDWLAN,,})."
		else
			# The LAN MAC stays as it is: made from this card, someone else's, or, from
			# before wlan.mac, of unknown origin. (Noting the card makes a MAC made from it
			# ours.)
			[ -n "$WLANMAC" ] && NEWWLAN="$WLANMAC"
			echo "Hardware address $LANMAC for $LAN is present."
		fi
	fi

fi

# Wi-Fi from wifi.txt but no Wi-Fi interface to use it (no card, or this stick has moved
# to a unit without one): left out, and the login prompt says "wlan0:missing" (see
# write_issue). Otherwise netplan's wpa_supplicant service waits
# 90 s for a wlan0 that doesn't come, then fails, on the console, at every boot.
if [ -n "$WIFIUSE" ] && [ ! -e /sys/class/net/$WLAN ]; then
	WIFIUSE=""
	echo "Wi-Fi is set in wifi.txt, but there's no $WLAN, so it isn't set up."
fi

# Record the MAC and where it came from straight away, even if 'netplan apply' fails
# below: next boot must see it as ours (or theirs).
echo "$LANMAC" > $STATEDIR/lan.mac
if [ -n "$NEWWLAN" ]; then echo "$NEWWLAN" > $STATEDIR/wlan.mac; else rm -f $STATEDIR/wlan.mac; fi
if [ -n "$USERMAC" ]; then touch $STATEDIR/lan.user; else rm -f $STATEDIR/lan.user; fi

# The config this boot's network was started with (the netplan generator made it from
# last boot's), for stale_addresses below.
mkdir -p /run/of-netplan
if [ -s "$LIVE" ]; then cp "$LIVE" /run/of-netplan/boot.yaml; else rm -f /run/of-netplan/boot.yaml; fi

# The live config, from the settings and the MAC (one set in network.yaml is already
# there). Then the login prompt, before the gate lets it show.
if [ -n "$USERMAC" ]; then LIVEMAC=""; else LIVEMAC="$LANMAC"; fi
BUILT=""
if [ -n "$USEUSER" ]; then
	build_live "$USERYAML" "$LIVEMAC" && BUILT=user
fi
if [ -z "$BUILT" ]; then
	build_live - "$LANMAC" && BUILT=default
fi
printf '%s\n' "${NOTES[@]}" | sed '/^$/d' > $STATEDIR/issue.note
write_issue
[ -n "$BUILT" ] && stale_addresses

# The MAC is settled: bring boot.nsh's BlwMac.efi line into step now, before the slower
# steps below, so a reboot for NVRAM (or none) is known as early as it can be.
update_bootnsh

# Wi-Fi set up last boot but not now: netplan's services were made at boot from last
# boot's config, before it changed, so a start of its wpa_supplicant may still be
# queued, waiting for a Wi-Fi interface that isn't there. Left alone, 'netplan apply'
# reloads systemd, the service goes, and its queued start fails ("Failed to start
# netplan-wpa-wlan0.service" on the console: seen on a flash stick moved to a unit
# with no card); or it times out after 90 s. So cancel those starts first, for any
# Wi-Fi interface the new config doesn't have.
if [ -n "$BUILT" ]; then
	systemctl list-jobs --no-legend 2>/dev/null | awk '{print $1, $2}' |
	while read -r ID UNIT; do
		case "$UNIT" in
			netplan-wpa-wl*.service) IF="${UNIT#netplan-wpa-}"; IF="${IF%.service}" ;;
			sys-subsystem-net-devices-wl*.device) IF="${UNIT#sys-subsystem-net-devices-}"; IF="${IF%.device}" ;;
			*) continue ;;
		esac
		"$YQ" -e --arg i "$IF" '.network.wifis[$i]' "$LIVE" >/dev/null 2>&1 && continue
		systemctl cancel "$ID" 2>/dev/null && echo "Cancelled the wait for $IF ($UNIT): it isn't set up now."
	done
fi

# Go live with the changes, then remember what we used for next boot. If netplan
# refuses settings/network.yaml, go without it, so Ethernet works.
APPLIED=""
if [ -n "$BUILT" ] && netplan apply; then
	APPLIED=1
elif [ "$BUILT" = "user" ]; then
	klog "netplan could not use settings/network.yaml, so it isn't used."
	NOTES+=("settings/network.yaml isn't a configuration netplan can use, so it isn't used.")
	printf '%s\n' "${NOTES[@]}" > $STATEDIR/issue.note
	build_live - "$LANMAC" && netplan apply && APPLIED=1
	write_issue
fi
if [ -n "$APPLIED" ]; then
	remember "$WIFITXT" wifi.txt
	remember "$ETHTXT" ethernet.txt
	remember "$USERYAML" user.yaml
	cp "$LIVE" $STATEDIR/live.yaml
	chmod 600 $STATEDIR/live.yaml
fi

write_netinfo

exit 0
