#!/usr/bin/env bash

## of-netplan v26.11.4 (9th November 2026)
##  Manages netplan configuration and MAC addresses on OpenFrame devices.

##  If there's a /boot/network.yaml file, we copy and use that.
##  The LAN MAC follows the WLAN card: 02 then the card MAC's last five octets.
##  If no WLAN interface is available, we generate a MAC for the LAN interface.
##
##  Two state files in /var/lib/of-netplan say where the LAN MAC came from:
##    lan.mac   the LAN MAC we last wrote into network.yaml
##    wlan.mac  the card MAC it was made from, 'none' if we generated it, or
##              absent if it's someone else's (typed into network.yaml)
##  So when a different card turns up (swapped, or this stick moved to another
##  unit), the LAN MAC is made again from the new card. Two units can then never
##  share a LAN MAC because they once had each other's cards. A MAC typed into
##  network.yaml is left alone, and deleting it there makes one from the card again.
##
##  Then we put the modified file back into /boot. If its Wi-Fi section is still
##  the unedited template, it's left out of the live config.
##
##  We're also responsible for /etc/issue
##
##  If /boot/network.yaml and the live config both match what we left last boot,
##  nothing has changed. Then we skip the rest, including 'netplan apply': the
##  netplan generator has already configured the network from /etc/netplan, and
##  applying again costs a daemon-reload and a second DHCP exchange on every boot.
##
##  'of-netplan --early' is run by udev (70-of-eth0-up.rules) as soon as eth0
##  appears. It sets the LAN MAC we settled on last boot and brings the link up,
##  so the PHY's ~2 s of autonegotiation is done before networkd starts rather
##  than after it.

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

source /etc/os-release

LAN="eth0"
WLAN="wlan0"
WLANTIMEOUT=15
CONFIGTIMEOUT=10
NETPLANCONFIG="network.yaml"
STATEDIR="/var/lib/of-netplan"

# Early mode, from udev: MAC first (while the link is down, so it's right from the
# first frame and networkd has nothing to change), then link up. Nothing else.
if [ "$1" = "--early" ]; then
	MAC=$(cat $STATEDIR/lan.mac 2>/dev/null)
	if [[ "$MAC" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]; then
		ip link set dev $LAN address "$MAC"
	fi
	ip link set dev $LAN up
	exit 0
fi

# Create /tmp/openframe.net as a quick network information reference.
write_netinfo() {
	MACW=$(ip link | sed -n '/wlan0/{n;p;}' | awk -F\  {'print $2'})
	MACE=$(ip link | sed -n '/eth0/{n;p;}' | awk -F\  {'print $2'})
	[[ "$MACW" == "" ]] && MACW="00:00:00:00:00:00"
	[[ "$MACE" == "" ]] && MACE="00:00:00:00:00:00"
	echo "$MACW"/"$MACE"/"$(hostname)" > /tmp/openframe.net
}

# The WLAN card's MAC, waiting up to $1 seconds for it to appear (0: just look).
card_mac() {
	local COUNT=0 MAC
	while [ $COUNT -lt $(($1 * 5)) ] && [ ! -e /sys/class/net/$WLAN/address ]; do
		COUNT=$((COUNT+1))
		sleep 0.2
	done
	MAC=$(cat /sys/class/net/$WLAN/address 2>/dev/null)
	is_mac "$MAC" && [ "$MAC" != "00:00:00:00:00:00" ] && echo "${MAC,,}"
}

is_mac() {
	[[ "$1" =~ ^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]
}

# The LAN MAC we make from a card MAC: 02 (locally administered) then its last five octets.
from_card() {
	echo "02:${1:3}"
}

# True if card $1 should replace the LAN MAC made from $2 (the wlan.mac contents):
# we generated it ('none'), or it came from a different card.
card_changed() {
	[ -n "$1" ] && { [ "$2" = "none" ] || { is_mac "$2" && [ "$1" != "${2,,}" ]; }; }
}

# networkd sends its first DHCP DISCOVER within milliseconds of carrier, and on
# the OpenFrame's r8169 that first frame is lost (frames ~50 ms later get through).
# networkd then waits about 4 seconds to retry. Once carrier has settled, restart
# its DHCP client if there's still no IPv4 address: the lease then arrives in about
# half a second. 'networkctl renew' doesn't help here; 'reconfigure' does.
kick_dhcp() {
	local COUNT=0
	while [ $COUNT -lt 200 ] && [ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" != 1 ]; do
		COUNT=$((COUNT+1))
		sleep 0.05
	done
	[ "$(cat /sys/class/net/$LAN/carrier 2>/dev/null)" = 1 ] || return 0
	sleep 0.3
	if ! ip -4 addr show $LAN | grep -q 'inet '; then
		echo "No IPv4 address on $LAN yet, restarting its DHCP client."
		networkctl reconfigure $LAN
	fi
}

# Remove the network information file if present.
[ -e /tmp/openframe.net ] && rm /tmp/openframe.net

# See if there's a network.yaml config file on /boot.
COUNT=0
while [ $COUNT -lt $CONFIGTIMEOUT -a ! -e /boot/$NETPLANCONFIG ]; do
	COUNT=$((COUNT+1))
 	sleep 1
done

# Configure what's shown on the text login prompt.
if [ $(grep -c 'YOURWIFINAME:' /boot/$NETPLANCONFIG) -gt 0 ]; then
	echo "${ID^} ${VERSION_CODENAME^} \n \l eth0:\4{eth0}" > /etc/issue
else
	echo "${ID^} ${VERSION_CODENAME^} \n \l wlan0:\4{wlan0} eth0:\4{eth0}" > /etc/issue
fi
echo >> /etc/issue

# Unchanged since we last ran? Then the live config is already right.
if [ -e /boot/$NETPLANCONFIG ] && [ -s $STATEDIR/lan.mac ] \
	&& cmp -s /boot/$NETPLANCONFIG $STATEDIR/boot.yaml \
	&& cmp -s /etc/netplan/$NETPLANCONFIG $STATEDIR/live.yaml; then
	echo "No changes to $NETPLANCONFIG since last boot."
	# networkd sets the LAN MAC when it starts, which may be after us. Wait for it
	# (up to 20 seconds), so /tmp/openframe.net records the right address.
	LANMAC=$(cat $STATEDIR/lan.mac)
	COUNT=0
	while [ $COUNT -lt 100 ] && [ "$(cat /sys/class/net/$LAN/address 2>/dev/null)" != "$LANMAC" ]; do
		COUNT=$((COUNT+1))
		sleep 0.2
	done
	# The WLAN adapter may not have appeared yet either. Give it up to 8 seconds;
	# the OpenFrame 2 has none, and its file is still written sooner than before.
	WLANMAC=$(card_mac 8)
	OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
	if card_changed "$WLANMAC" "$OLDWLAN"; then
		# A different card (or a first one): carry on below and make the LAN MAC again.
		CARDCHECKED=1
	else
		# Installed before wlan.mac existed, and the MAC is this card's: note the card.
		if [ -z "$OLDWLAN" ] && [ -n "$WLANMAC" ] && [ "${LANMAC,,}" = "$(from_card $WLANMAC)" ]; then
			echo "$WLANMAC" > $STATEDIR/wlan.mac
		fi
		write_netinfo
		kick_dhcp
		exit 0
	fi
fi

# If we found one, copy it into the system.
if [ -e /boot/$NETPLANCONFIG ]; then
	cp /boot/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# What network.yaml says now, what we last wrote there, and where that came from.
YAMLMAC=$(yq -r ".network.ethernets.${LAN}.macaddress // empty" /etc/netplan/$NETPLANCONFIG)
OLDLAN=$(cat $STATEDIR/lan.mac 2>/dev/null)
OLDWLAN=$(cat $STATEDIR/wlan.mac 2>/dev/null)
LANMAC="$YAMLMAC"
NEWWLAN="$OLDWLAN"

if [[ -z "$YAMLMAC" ]]; then

	# No MAC yet: make one from the WLAN card if there is one.
	[ -n "$CARDCHECKED" ] || WLANMAC=$(card_mac $WLANTIMEOUT)
	if [ -n "$WLANMAC" ]; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		echo "Found $WLANMAC as $WLAN hardware address."
		echo "Applying $LANMAC to $LAN (local bit set)."
	else
		# No WLAN to mirror, so generate one.
		LANMAC="02:`cat /proc/interrupts | md5sum | sed -r "s/(.{2})/\1:/g; s/^(.{14}).*/\1/"`"
		NEWWLAN="none"
		echo "Unable to determine $WLAN hardware address after $WLANTIMEOUT seconds."
		echo "Applying $LANMAC to $LAN (generated)."
	fi

elif [ -n "$OLDLAN" ] && [ "${YAMLMAC,,}" != "${OLDLAN,,}" ]; then

	# Not what we wrote last time, so someone set it. It's theirs from now on.
	NEWWLAN=""
	echo "Hardware address $YAMLMAC for $LAN was set in $NETPLANCONFIG; leaving it alone."

else

	# Ours (or of unknown origin, from before wlan.mac). Look for the card: wait for it
	# if the MAC came from one, otherwise just look, so an OpenFrame 2 isn't held up.
	if [ -z "$CARDCHECKED" ]; then
		if is_mac "$OLDWLAN"; then WLANMAC=$(card_mac $WLANTIMEOUT); else WLANMAC=$(card_mac 0); fi
	fi
	if card_changed "$WLANMAC" "$OLDWLAN"; then
		LANMAC=$(from_card $WLANMAC)
		NEWWLAN="$WLANMAC"
		echo "Found $WLANMAC as $WLAN hardware address (was ${OLDWLAN})."
		echo "Applying $LANMAC to $LAN (local bit set)."
	else
		# Installed before wlan.mac existed: note the card if the MAC is this card's.
		# If it isn't, we can't tell whether someone set it, so it stays as it is.
		if [ -z "$OLDWLAN" ] && [ -n "$WLANMAC" ] && [ "${YAMLMAC,,}" = "$(from_card $WLANMAC)" ]; then
			NEWWLAN="$WLANMAC"
		fi
		echo "Hardware address $LANMAC for $LAN is present."
	fi

fi

# Write a new LAN MAC to the config file.
if [ "$LANMAC" != "$YAMLMAC" ]; then
	yq -y --arg mac "$LANMAC" ".network.ethernets.${LAN}.macaddress = \$mac" \
		/etc/netplan/$NETPLANCONFIG > /tmp/$NETPLANCONFIG
	mv /tmp/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# Copy the updated config file back to /boot for next time, only if it differs,
# so an unchanged boot doesn't write to the FAT partition.
cmp -s /etc/netplan/$NETPLANCONFIG /boot/$NETPLANCONFIG || cp /etc/netplan/$NETPLANCONFIG /boot/$NETPLANCONFIG

# Record the MAC we wrote and where it came from straight away, even if 'netplan apply'
# fails below: network.yaml already holds it, and next boot must see it as ours.
mkdir -p $STATEDIR
echo "$LANMAC" > $STATEDIR/lan.mac
if [ -n "$NEWWLAN" ]; then echo "$NEWWLAN" > $STATEDIR/wlan.mac; else rm -f $STATEDIR/wlan.mac; fi

# An unedited template still names YOURWIFINAME. Leave Wi-Fi out of the live config
# then: netplan would start a WPA supplicant for wlan0, which waits 90 seconds for an
# adapter that may not exist (the OpenFrame 2 has none) and then fails. /boot keeps
# the full template, so Wi-Fi can still be filled in there.
if grep -q 'YOURWIFINAME:' /etc/netplan/$NETPLANCONFIG; then
	yq -y 'del(.network.wifis)' /etc/netplan/$NETPLANCONFIG > /tmp/$NETPLANCONFIG
	mv /tmp/$NETPLANCONFIG /etc/netplan/$NETPLANCONFIG
	chmod 600 /etc/netplan/$NETPLANCONFIG
fi

# Go live with the changes, then remember what we left for next boot.
if netplan apply; then
	cp /boot/$NETPLANCONFIG $STATEDIR/boot.yaml
	cp /etc/netplan/$NETPLANCONFIG $STATEDIR/live.yaml
	chmod 600 $STATEDIR/*.yaml
fi

write_netinfo

exit 0
