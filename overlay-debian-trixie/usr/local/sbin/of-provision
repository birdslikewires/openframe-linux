#!/usr/bin/env bash

## of-provision v26.11.8 (16th November 2026)
##  Installs a project named in setup.txt on the boot volume (in its settings folder,
##  /boot/settings, or in its root as on older images) when the system first starts:
##  downloads the project's install.sh and runs it as the normal user. Lets community
##  repos provide their own install.sh without us having to bake every combination of
##  software into an image.
##
##  setup.txt (the images ship one with nothing set):
##    project=<address>   a GitHub project (https://github.com/owner/project), at a
##                        release, tag or branch if one's given (.../tree/<ref>,
##                        .../releases/tag/<tag>; the default branch otherwise, main
##                        then master), a link straight to an install.sh (GitHub's
##                        .../blob/<ref>/install.sh too), or any other address with an
##                        install.sh at its root.
##    <name>=<value>      anything else, for the project's installer: passed to it as
##                        the environment variable SETUP_<NAME> (name=Kitchen gives
##                        SETUP_NAME=Kitchen).
##  An older setup.txt, with only the address on a line of its own, works as before.
##
##  Runs on the first start only: the service disables itself as it starts. With no
##  project set it does nothing more, and setup.txt stays as it is. A download that
##  fails (no network yet, say) is tried again at the next start, three starts in all;
##  then, or if install.sh fails, setup.txt becomes setup.txt.failed. On success it's
##  removed. Either way the unit restarts once install.sh has run. A failure is noted
##  on the login screen (/etc/issue.d/of-provision.issue) and, on a system running
##  from a stick, the log (/var/log/setup.log) is copied to settings/setup.log, where a
##  computer can read it. Run again with 'systemctl enable of-provision.service' and a
##  setup.txt with a project in it.
##
##  'of-provision --check' says (exit 0) whether there's a project to install at this
##  start: the getty on tty1 stays away for it (getty@tty1.service.d/of-provision.conf).
##
##  tty1 isn't the service's (a getty starting there would hang it up and kill us, as
##  the blank setup.txt the images ship once let it): only with a project to install,
##  while the getty is held back, does this write to tty1, and never as its terminal.
##
##  Must not act before getty@tty1 (its unit is ordered after it). On a boot where
##  the unit is about to restart to store its MAC in NVRAM, of-mac-gate holds the
##  getty, so this never starts on that boot: it stays enabled, setup.txt stays as it
##  is, and it runs on the next boot. Anything done earlier (say, from a unit ordered
##  before the getty, or before disabling itself) could be cut off by that restart.

SETUPFILE="/boot/settings/setup.txt"
[ -f "$SETUPFILE" ] || SETUPFILE="/boot/setup.txt"
LOGFILE="/var/log/setup.log"
WORKDIR="/tmp/of-provision"
STATEDIR="/var/lib/of-provision"
ISSUENOTE="/etc/issue.d/of-provision.issue"
DOWNLOADTRIES=3
OPENFRAMEUSER="of"

# setup.txt's settings: PROJECT, and SETVARS (SETUP_<NAME>=value for the rest). Comments
# and blank lines are skipped; Windows line ends, a BOM and quotes around values are
# allowed for.
read_setup() {
	local line k v
	PROJECT=""
	SETVARS=()
	[ -r "$1" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		line="${line#$'\xef\xbb\xbf'}"
		[[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
		if [[ "$line" =~ ^[[:space:]]*https?:// ]] || [[ "$line" != *=* ]]; then
			# An older setup.txt: the address on a line of its own.
			[ -z "$PROJECT" ] && PROJECT="${line//[[:space:]]/}"
			continue
		fi
		k="${line%%=*}"
		v="${line#*=}"
		k="${k//[[:space:]]/}"
		v="${v#"${v%%[![:space:]]*}"}"
		v="${v%"${v##*[![:space:]]}"}"
		if [[ "$v" =~ ^\"(.*)\"$ ]] || [[ "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
		if [ "${k,,}" = "project" ]; then
			PROJECT="${v//[[:space:]]/}"
		elif [[ "$k" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
			SETVARS+=("SETUP_${k^^}=$v")
		fi
	done < "$1"
}

# True on a flash stick (flash=yes or again in settings/flash.txt): its settings,
# setup.txt included, are for the unit it installs (/usr/lib/openframe/flash/flash), not
# for this stick.
flash_stick() {
	local M
	M=$(sed -n 's/^[[:space:]]*flash[[:space:]]*=//Ip' /boot/settings/flash.txt 2>/dev/null |
		tr -d '\r"'"'"' \t' | tr 'A-Z' 'a-z' | tail -1)
	[ "$M" = "yes" ] || [ "$M" = "again" ]
}

if [ "${1:-}" = "--check" ]; then
	flash_stick && exit 1
	read_setup "$SETUPFILE"
	[ -n "$PROJECT" ]
	exit
fi

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

log() {
	echo "$1" | tee -a "$LOGFILE"
}

# A line about what went wrong, for the login screen (agetty shows /etc/issue.d after
# /etc/issue; it reads backslashes as escapes).
note() {
	mkdir -p "${ISSUENOTE%/*}"
	{
		printf '%s\n' "$1"
		echo "The log is in $LOGFILE. ('sudo rm $ISSUENOTE' hides this.)"
		echo
	} | sed 's/\\/\\\\/g' > "$ISSUENOTE"
}

# On a system running from a stick, the log goes next to setup.txt, where a computer
# can read it. (The internal memory can't be read from a computer: the login screen's
# note is for that.)
log_to_boot() {
	[[ "$(findmnt -n -o SOURCE /)" == /dev/mmcblk* ]] && return 0
	boot_rw && cp "$LOGFILE" "${SETUPFILE%/*}/setup.log"
}

# Gives up without rebooting: the getty on tty1 stayed away for us, so bring it back
# (it starts once we've finished).
give_up() {
	systemctl start --no-block getty@tty1.service >/dev/null 2>&1
	exit "${1:-1}"
}

# /boot is mounted read-only, so a power cut can't corrupt it. This makes it writable
# until the script exits (/usr/lib/openframe/bootrw keeps it writable while any other
# writer still needs it, and puts it back after the last).
BOOTRW=""
boot_rw() {
	[ -z "$BOOTRW" ] || return 0
	/usr/lib/openframe/bootrw open || return 1
	BOOTRW=done
	trap '/usr/lib/openframe/bootrw close' EXIT
}

[ -f "$SETUPFILE" ] || exit 0

if flash_stick; then
	echo "of-provision: this is a flash stick; its setup.txt is for the unit it installs."
	give_up 0
fi

# Say we've started (for this boot only: /run is emptied at every boot) before
# disabling ourselves. The getty on tty1 stays away while we're enabled or have
# started (getty@tty1.service.d/of-provision.conf), and it may check after we've
# disabled ourselves: it's Type=idle, which can hold its check back for seconds.
mkdir -p /run/of-provision && touch /run/of-provision/started

# One-shot: disable ourselves now, before doing anything else, so we don't
# run again on next boot regardless of how this attempt turns out (a failed
# download enables us again, below, for another try).
systemctl disable of-provision.service >/dev/null 2>&1

read_setup "$SETUPFILE"
URL="$PROJECT"
if [[ -z "$URL" ]]; then
	echo "of-provision: no project in setup.txt; nothing to install."
	give_up 0
fi

# A project to install: what follows goes on tty1 (the getty stays away for it), from a
# clear screen, with no input (an installer that asks a question gets no answer rather
# than waiting for a keyboard the unit may not have).
if [ -w /dev/tty1 ]; then
	printf '\033c' > /dev/tty1
	exec < /dev/null > /dev/tty1 2>&1
fi

: > "$LOGFILE"
log "of-provision: starting at $(date -u '+%Y-%m-%d %H:%M:%S UTC')"

# The network, and the clock (HTTPS needs it right): waited for here, now that there's
# a project to install, rather than by the unit (see of-provision.service). Up to two
# minutes and one; then on regardless, as the downloads below try again anyway.
log "of-provision: waiting for the network..."
timeout 120 systemctl start network-online.target >/dev/null 2>&1 ||
	log "of-provision: the network isn't online yet; trying anyway."
timeout 60 systemctl start time-sync.target >/dev/null 2>&1 || true
if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != "yes" ]; then
	log "of-provision: warning, system clock is not NTP-synchronised; HTTPS downloads below may fail on certificate checks."
fi
log "of-provision: requested source: $URL"
[ ${#SETVARS[@]} -gt 0 ] && log "of-provision: settings for the installer: $(printf '%s ' "${SETVARS[@]%%=*}")"

GITHUB='^https?://(www\.)?github\.com/([^/]+)/([^/?#]+)(/(tree|blob|releases/tag)/([^?#]+))?/?([?#].*)?$'
if [[ "$URL" =~ $GITHUB ]]; then
	OWNER="${BASH_REMATCH[2]}"
	REPO="${BASH_REMATCH[3]%.git}"
	KIND="${BASH_REMATCH[5]}"
	REST="${BASH_REMATCH[6]%/}"
	RAW="https://raw.githubusercontent.com/${OWNER}/${REPO}"
	case "$KIND" in
		tree|releases/tag)
			# A release, tag or branch: its install.sh.
			CANDIDATES=("${RAW}/${REST}/install.sh") ;;
		blob)
			# A file on GitHub's site: the file itself.
			CANDIDATES=("${RAW}/${REST}") ;;
		*)
			# The project: install.sh on the default branch, trying 'main' then falling
			# back to the older 'master' convention.
			CANDIDATES=("${RAW}/refs/heads/main/install.sh" "${RAW}/refs/heads/master/install.sh") ;;
	esac
elif [[ "$URL" =~ install\.sh$ ]]; then
	# Direct link, use as given.
	CANDIDATES=("$URL")
else
	# Some other project URL: look for install.sh at its root.
	CANDIDATES=("${URL%/}/install.sh")
fi

mkdir -p "$WORKDIR" "$STATEDIR"
INSTALLER_PATH="${WORKDIR}/install.sh"

# network-online.target only means whatever brought it up thinks it's done;
# DHCP/DNS can still lag behind that for a few seconds, particularly over
# Wi-Fi, so retry each candidate a few times before giving up on it.
INSTALLER_URL=""
for CANDIDATE in "${CANDIDATES[@]}"; do
	log "of-provision: trying ${CANDIDATE}"
	for ATTEMPT in 1 2 3 4 5; do
		CURL_ERROR="$(curl -fSL -o "$INSTALLER_PATH" "$CANDIDATE" 2>&1 >/dev/null)" && { INSTALLER_URL="$CANDIDATE"; break; }
		log "of-provision: attempt ${ATTEMPT} failed: ${CURL_ERROR}"
		sleep 5
	done
	[ -n "$INSTALLER_URL" ] && break
done

if [ -z "$INSTALLER_URL" ]; then
	TRIES=$(cat "$STATEDIR/download-tries" 2>/dev/null)
	[[ "$TRIES" =~ ^[0-9]+$ ]] || TRIES=0
	TRIES=$((TRIES + 1))
	echo "$TRIES" > "$STATEDIR/download-tries"
	if [ "$TRIES" -lt "$DOWNLOADTRIES" ]; then
		log "of-provision: couldn't download install.sh (start $TRIES of $DOWNLOADTRIES); trying again at the next start."
		systemctl enable of-provision.service >/dev/null 2>&1
		note "Setup couldn't download the installer for $URL; it tries again at the next start."
	else
		log "of-provision: couldn't download install.sh (start $TRIES of $DOWNLOADTRIES). Aborting."
		rm -f "$STATEDIR/download-tries"
		boot_rw
		mv "$SETUPFILE" "${SETUPFILE}.failed"
		note "Setup couldn't download the installer for $URL, so it wasn't installed."
	fi
	log_to_boot
	rm -rf "$WORKDIR"
	give_up
fi
rm -f "$STATEDIR/download-tries"

log "of-provision: fetched ${INSTALLER_URL}"

chmod +x "$INSTALLER_PATH"
chown "$OPENFRAMEUSER:$OPENFRAMEUSER" "$INSTALLER_PATH"

log "of-provision: running installer as '${OPENFRAMEUSER}'..."
echo >> "$LOGFILE"

# The other settings in setup.txt go through to the installer: a login shell (su -)
# keeps only the variables it's told to.
WHITELIST=""
for V in "${SETVARS[@]}"; do
	export "$V"
	WHITELIST+="${WHITELIST:+,}${V%%=*}"
done
su --login ${WHITELIST:+--whitelist-environment="$WHITELIST"} "$OPENFRAMEUSER" -c "$INSTALLER_PATH" 2>&1 | tee -a "$LOGFILE"
INSTALLER_RESULT="${PIPESTATUS[0]}"

if [ "$INSTALLER_RESULT" -eq 0 ]; then
	echo >> "$LOGFILE"
	log "of-provision: installer completed successfully."
	rm -f "$ISSUENOTE"
	boot_rw
	rm "$SETUPFILE"
	rm -f "${SETUPFILE%/*}/setup.log"
else
	echo >> "$LOGFILE"
	log "of-provision: installer exited with an error. See above."
	note "Setup of $URL failed: its installer stopped with an error (exit $INSTALLER_RESULT)."
	boot_rw
	mv "$SETUPFILE" "${SETUPFILE}.failed"
	log_to_boot
fi

rm -rf "$WORKDIR"

log "of-provision: rebooting..."
sync
systemctl reboot

exit 0
