#!/usr/bin/env bash

## of-bootnsh v26.11.4 (10th November 2026)
##  Writes boot.nsh, the script the firmware's EFI shell runs at power-on.
##
##  In 'stub' mode the shell starts the kernel directly through its EFI stub. The
##  firmware loads the kernel and initrd about five times faster than GRUB 1.98,
##  which saves about ten seconds per boot. GRUB stays in the script as the
##  fallback: if the kernel can't be started, the shell moves on to the next line.
##
##  The firmware's shell only starts files ending in .efi, and the boot volume has
##  no room for a second copy of the kernel, so in 'stub' mode the kernel is
##  renamed to vmlinuz.efi and grub.cfg points at it too. 'grub' mode puts the
##  usual vmlinuz-<version> name back.
##
##  An empty vmlinuz-<version> is left in place of the renamed kernel. It takes no
##  space on FAT, and it lets update-initramfs and linux-version find the kernel,
##  since they look for vmlinuz-<version> files. Only a non-empty file is ever
##  treated as a kernel, so the placeholder never replaces vmlinuz.efi.
##
##  The initrd and kernel arguments are read from grub.cfg, so anything that
##  edits grub.cfg, or installs a kernel, should run this afterwards.
##
##  In 'stub' mode the kernel boots without its initrd whenever it can. It then
##  finds and mounts the root filesystem itself, which saves about three seconds
##  per boot: the firmware has no initrd to load, and nothing has to unpack it or
##  run udev inside it. The kernel needs the USB storage, SCSI disk and root
##  filesystem drivers built in (its config file in /boot is checked), and the
##  root given by partition UUID, since it can't resolve LABEL= or UUID= itself.
##  usb-storage's one-second settle delay goes too: the initrd used to hide it.
##  It only happens when writing this system's own /boot and the mounted root is
##  the device grub.cfg names, so never in an image build. Otherwise, or after
##  'of-settings initrd enable', the initrd is used as before. grub.cfg keeps its
##  initrd either way, so the GRUB fallback still works.
##
##  On BirdsLikeWires firmware, boot.nsh first runs BlwMac.efi with the WLAN card's
##  MAC (/var/lib/of-netplan/wlan.mac), or with no card the LAN MAC of-netplan
##  generated (lan.mac). It keeps that in NVRAM, writing only when it changes. On
##  every boot the firmware gives the network chip the LAN MAC (made from the card's
##  as of-netplan makes it, or the generated one), so any OS started on this unit
##  sees it, and makes a UUID from the stored MAC, plus for a card the system's
##  serial number. A LAN MAC typed into network.yaml stays Linux's business.
##  Stock firmware never uses BlwMac.efi, so the line isn't added there. If the
##  firmware can't be identified (no SMBIOS and no EFI line in the kernel log, as
##  after a kexec), lines already in boot.nsh are kept as they are. Nor when writing
##  another boot directory (an image build), since the MACs belong to the hardware
##  this runs on. A change to the line is noted in the kernel log (dmesg).
##  'of-bootnsh mac' refreshes just those lines; of-netplan runs it every boot.
##
##  boot.nsh is only rewritten when its contents change.
##
##  Usage: of-bootnsh [stub|grub] [quiet|normal] [boot directory]
##         of-bootnsh mac
##  Modes not given are kept from the existing boot.nsh.

BOOTDIR="/boot"
MODE=""
GRUBEFI=""
KERNELEFI="vmlinuz.efi"
MACONLY=0
LANMACFILE="/var/lib/of-netplan/lan.mac"
WLANMACFILE="/var/lib/of-netplan/wlan.mac"
MACEFI="/usr/lib/openframe/BlwMac.efi"
KEEPINITRD="/var/lib/openframe-scripts/keep-initrd"

for arg in "$@"; do
	case "$arg" in
		stub|grub) MODE="$arg" ;;
		quiet) GRUBEFI="grubq" ;;
		normal) GRUBEFI="grub" ;;
		mac) MACONLY=1 ;;
		-h|--help) sed -n 's/^## \{0,1\}//p' "$0"; exit 0 ;;
		*) BOOTDIR="$arg" ;;
	esac
done

GRUBCFG="$BOOTDIR/grub.cfg"
BOOTNSH="$BOOTDIR/boot.nsh"

# The MAC in file $1, in lower case, if it's unicast and not all zero.
usable_mac() {
	local MAC
	MAC=$(cat "$1" 2>/dev/null)
	MAC="${MAC,,}"
	[[ "$MAC" =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || return 0
	(( (16#${MAC:0:2} & 1) == 0 )) || return 0	# unicast
	[[ "${MAC//[0:]/}" != "" ]] || return 0		# not all zero
	echo "$MAC"
}

# True if MAC $1 is locally administered (02 bit set): generated, not a card's own.
local_mac() {
	(( (16#${1:0:2} & 2) != 0 ))
}

# The firmware's vendor: from SMBIOS, or else from the kernel's 'efi: EFI v2.0 by
# <vendor>' line (stock firmware publishes no SMBIOS). Empty if neither is there,
# as after a kexec, which hands on no firmware tables.
fw_vendor() {
	local VENDOR
	VENDOR=$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null)
	[[ "$VENDOR" != "" ]] || VENDOR=$(dmesg 2>/dev/null | sed -n 's/.*efi: EFI v[0-9.]* by \(.*\)$/\1/p' | head -1)
	echo "$VENDOR"
}

# The BlwMac.efi lines for boot.nsh (fs1 then fs0, like the kernel lines), or
# nothing. They carry the WLAN card's MAC if it's the card's own (burned-in)
# address: the firmware makes the LAN MAC, serial number and UUID from it. Failing
# that, the LAN MAC if it was generated (no card): the firmware uses it as it is,
# and for a UUID. Anything else (a typed-in LAN MAC with no card) isn't passed on,
# since the firmware would take it for a card's. Copies BlwMac.efi to the boot
# volume if it isn't there already.
mac_lines() {
	local MAC VENDOR
	[[ "$BOOTDIR" == "/boot" ]] || return 0
	VENDOR=$(fw_vendor)
	if [[ "$VENDOR" == "" ]]; then
		grep 'BlwMac\.efi' "$BOOTNSH" 2>/dev/null	# can't tell: keep what's there
		return 0
	fi
	[[ "$VENDOR" == "BirdsLikeWires" ]] || return 0
	[ -f "$MACEFI" ] || return 0
	MAC=$(usable_mac "$WLANMACFILE")
	if [[ "$MAC" == "" ]] || local_mac "$MAC"; then
		MAC=$(usable_mac "$LANMACFILE")
		[[ "$MAC" != "" ]] && local_mac "$MAC" || return 0
	fi
	cmp -s "$MACEFI" "$BOOTDIR/BlwMac.efi" || cp "$MACEFI" "$BOOTDIR/BlwMac.efi" || return 0
	printf 'fs1:\\BlwMac.efi %s\nfs0:\\BlwMac.efi %s\n' "$MAC" "$MAC"
}

# Puts boot.nsh.new in place, unless it's the same as what's there. A changed
# BlwMac.efi line goes in the kernel log: NVRAM follows at the next boot.
install_bootnsh() {
	local NEW MAC SAYS
	if cmp -s "$BOOTNSH.new" "$BOOTNSH"; then
		rm -f "$BOOTNSH.new"
		return
	fi
	NEW=$(grep -m1 'BlwMac\.efi' "$BOOTNSH.new")
	if [[ "$NEW" != "" ]] && [[ "$NEW" != "$(grep -m1 'BlwMac\.efi' "$BOOTNSH" 2>/dev/null)" ]]; then
		read -r _ MAC <<< "$NEW"
		if local_mac "$MAC"; then
			SAYS="generated LAN MAC $MAC (no serial number)"
		else
			SAYS="WLAN card MAC $MAC (LAN MAC 02:${MAC:3}, serial number $(tr -d : <<< "${MAC^^}"))"
		fi
		echo "<5>of-bootnsh: NVRAM gets $SAYS at next boot." > /dev/kmsg 2>/dev/null
	fi
	mv -f "$BOOTNSH.new" "$BOOTNSH"
	sync
}

# BlwLanMac.efi was BlwMac.efi's name before firmware 26.11.20; its lines go too.
if [[ $MACONLY -eq 1 ]]; then
	[ -f "$BOOTNSH" ] || exit 1
	{ mac_lines; grep -v -E 'Blw(Lan)?Mac\.efi' "$BOOTNSH"; } > "$BOOTNSH.new"
	install_bootnsh
	exit 0
fi

if [ ! -f "$GRUBCFG" ] || ! grep -q -E '^[[:space:]]*linux[[:space:]]' "$GRUBCFG"; then
	echo "Cannot find a 'linux' line in $GRUBCFG; boot.nsh left unchanged."
	exit 1
fi

# Keep the current modes unless told otherwise. A missing boot.nsh means stub.
if [[ "$MODE" == "" ]]; then
	if [ -f "$BOOTNSH" ] && ! grep -q 'vmlinuz' "$BOOTNSH"; then
		MODE="grub"
	else
		MODE="stub"
	fi
fi

if [[ "$GRUBEFI" == "" ]]; then
	if [ -f "$BOOTNSH" ] && grep -q 'grubq' "$BOOTNSH"; then
		GRUBEFI="grubq"
	else
		GRUBEFI="grub"
	fi
fi

read -r _ INITRD _ <<< "$(grep -m1 -E '^[[:space:]]*initrd[[:space:]]' "$GRUBCFG")"
INITRD="${INITRD#/}"

# The kernel version being booted comes from the initrd name, or, with no initrd,
# from the newest vmlinuz-<version> on the boot volume.
VERSION=""
if [[ "$INITRD" =~ ^initrd\.img-(.+)$ ]]; then
	VERSION="${BASH_REMATCH[1]}"
else
	NEWEST=$(ls -t "$BOOTDIR"/vmlinuz-* 2>/dev/null | head -1)
	[[ "$NEWEST" != "" ]] && VERSION="${NEWEST##*/vmlinuz-}"
fi

# The root partition's UUID if the kernel can boot without its initrd (see the
# notes at the top), or nothing. $1 is the kernel arguments from grub.cfg.
direct_root() {
	local CFG SPEC SRC FSTYPE
	[[ "$BOOTDIR" == "/boot" ]] || return 0
	[ -e "$KEEPINITRD" ] && return 0
	CFG="$BOOTDIR/config-$VERSION"
	[[ "$VERSION" != "" ]] && [ -f "$CFG" ] || return 0
	grep -q '^CONFIG_USB_STORAGE=y' "$CFG" && grep -q '^CONFIG_BLK_DEV_SD=y' "$CFG" || return 0
	SRC=$(findmnt -n -o SOURCE / 2>/dev/null)
	[ -b "$SRC" ] || return 0
	# The mounted root must be the device grub.cfg names (in a chroot it isn't).
	SPEC=$(sed -n 's/.*[[:space:]]root=\([^[:space:]]*\).*/\1/p' <<< " $1")
	case "$SPEC" in
		UUID=*) [[ "$(blkid -c /dev/null -s UUID -o value "$SRC")" == "${SPEC#UUID=}" ]] || return 0 ;;
		LABEL=*) [[ "$(blkid -c /dev/null -s LABEL -o value "$SRC")" == "${SPEC#LABEL=}" ]] || return 0 ;;
		PARTUUID=*) [[ "$(blkid -c /dev/null -s PARTUUID -o value "$SRC")" == "${SPEC#PARTUUID=}" ]] || return 0 ;;
		/dev/*) [[ "$(readlink -f "$SPEC")" == "$(readlink -f "$SRC")" ]] || return 0 ;;
		*) return 0 ;;
	esac
	# The kernel must have the root filesystem's driver built in.
	FSTYPE=$(findmnt -n -o FSTYPE /)
	case "$FSTYPE" in
		ext2) grep -q '^CONFIG_EXT2_FS=y' "$CFG" || { grep -q '^CONFIG_EXT4_FS=y' "$CFG" &&
			grep -q '^CONFIG_EXT4_USE_FOR_EXT2=y' "$CFG"; } || return 0 ;;
		ext3|ext4) grep -q '^CONFIG_EXT4_FS=y' "$CFG" || return 0 ;;
		btrfs) grep -q '^CONFIG_BTRFS_FS=y' "$CFG" || return 0 ;;
		*) return 0 ;;
	esac
	blkid -c /dev/null -s PARTUUID -o value "$SRC"
}

# Points the 'linux' line in grub.cfg at the given kernel file.
grub_kernel() {
	sed -i -E "s|^([[:space:]]*linux[[:space:]]+)[^[:space:]]+|\1/$1|" "$GRUBCFG"
}

if [[ "$MODE" == "stub" ]]; then

	# A freshly installed kernel replaces the previous vmlinuz.efi. -s, not -f: an
	# empty file is our placeholder, and moving it would leave nothing to boot.
	if [[ "$VERSION" != "" ]] && [ -s "$BOOTDIR/vmlinuz-$VERSION" ]; then
		mv -f "$BOOTDIR/vmlinuz-$VERSION" "$BOOTDIR/$KERNELEFI"
	fi

	if [ -s "$BOOTDIR/$KERNELEFI" ]; then
		if [[ "$VERSION" != "" ]] && [ ! -e "$BOOTDIR/vmlinuz-$VERSION" ]; then
			: > "$BOOTDIR/vmlinuz-$VERSION"
		fi
	else
		echo "Warning: no $BOOTDIR/$KERNELEFI yet; it appears when a kernel is installed."
	fi
	grub_kernel "$KERNELEFI"

	read -r _ _ ARGS <<< "$(grep -m1 -E '^[[:space:]]*linux[[:space:]]' "$GRUBCFG")"

	ROOTPART=$(direct_root "$ARGS")
	if [[ "$ROOTPART" != "" ]]; then
		# No initrd: the kernel mounts root itself, found by partition UUID.
		ARGS=$(sed -E "s#(^|[[:space:]])root=[^[:space:]]+#\1root=PARTUUID=$ROOTPART#" <<< "$ARGS")
		ARGS="$ARGS usb-storage.delay_use=0"
	elif [[ "$INITRD" != "" ]]; then
		# The EFI stub takes the initrd path from the root of the boot volume, with backslashes.
		ARGS="$ARGS initrd=\\${INITRD//\//\\}"
	fi

	{
		mac_lines
		printf 'fs1:%s %s\nfs1:%s\nfs0:%s %s\nfs0:%s\n' \
			"${KERNELEFI%.efi}" "$ARGS" "$GRUBEFI" "${KERNELEFI%.efi}" "$ARGS" "$GRUBEFI"
	} > "$BOOTNSH.new"

else

	if [ -f "$BOOTDIR/$KERNELEFI" ]; then
		[[ "$VERSION" == "" ]] && VERSION=$(uname -r)
		if [ -s "$BOOTDIR/vmlinuz-$VERSION" ]; then
			# A real kernel is already under its own name, so vmlinuz.efi is stale.
			rm -f "$BOOTDIR/$KERNELEFI"
		else
			# Replaces the placeholder, if there is one.
			mv -f "$BOOTDIR/$KERNELEFI" "$BOOTDIR/vmlinuz-$VERSION"
		fi
		grub_kernel "vmlinuz-$VERSION"
	fi

	{
		mac_lines
		printf 'fs1:%s\nfs0:%s\n' "$GRUBEFI" "$GRUBEFI"
	} > "$BOOTNSH.new"

fi

install_bootnsh
