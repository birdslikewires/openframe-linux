#!/usr/bin/env bash

## of-expand v26.11.2 (10th November 2026)
##  Expands the root partition and filesystem to fill the drive. On ext4 the
##  filesystem grows in about a second (the new inode tables are filled in later,
##  in the background), so there's no message on screen.

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

ROOTDEV=$(findmnt -n -o SOURCE /)
ROOTPARTNO="${ROOTDEV: -1}"
[[ "$ROOTDEV" =~ "mmc" ]] && DISKDEV="${ROOTDEV::-2}" || DISKDEV="${ROOTDEV::-1}"

echo "Root is on $ROOTDEV (disk: $DISKDEV, partition: $ROOTPARTNO)."

# Images built before November 2026 start /boot at sector 1, so the disk's first 4 KB
# holds the partition table and the start of /boot's FAT. growpart writes the table
# through the whole disk's own cache, 4 KB at a time, and an old copy of the FAT
# there would go back over the real one. So /boot's changes go to disk first and the
# whole disk's cached copy is dropped, making growpart read the disk afresh. (This
# runs once /boot is checked and mounted, read-only, before anything writes to it.)
sync
blockdev --flushbufs $DISKDEV

TMPDIR=/run growpart $DISKDEV $ROOTPARTNO > /dev/null
GPRET=$?
if [ $GPRET -eq 1 ]; then
	# The image already fills the disk: the 1 GB internal memory of an OpenFrame 1.
	# /tmp and apt's files stay in RAM there, to save space and wear.
	echo "Partition already at maximum size; keeping /tmp and apt's files in RAM."
	exit 0
elif [ $GPRET -ne 0 ]; then
	echo "growpart failed (exit $GPRET). Skipping filesystem resize."
	exit 1
fi

resize2fs $ROOTDEV > /dev/null

# A bigger drive has room for /tmp and apt's files on disk, so drop their tmpfs.
sed -i '/\/var\/cache\/apt/d' /etc/fstab
sed -i '/\/var\/lib\/apt\/lists/d' /etc/fstab
sed -i -E '/^[^#[:space:]]+[[:space:]]+\/tmp[[:space:]]/d' /etc/fstab

echo "Done."

exit 0
