#!/usr/bin/env bash

## of-expand v26.11.4 (15th November 2026)
##  Expands the root partition and filesystem to fill the drive. On ext4 the
##  filesystem grows in about a second (the new inode tables are filled in later,
##  in the background), so there's no message on screen.
##
##  An installer stick is the exception: started for the first time with flash=yes
##  (or again) in OF-BOOT/settings/flash.txt, and carrying the image copy to install,
##  the rest of the stick becomes OF-BACKUP instead, an exFAT partition any computer
##  can read, for the installer's backups (/usr/lib/openframe/installer). The system
##  keeps its size, with /tmp and apt's files in RAM as on the internal memory. A stick
##  first started as a system grows into that space, so it can't become one later:
##  its flash.txt is removed as it grows, and so is the one on the internal memory,
##  which can't install onto itself. ('sudo of-flash install' still works by hand.)

if [ "$(id -u)" -ne 0 ]; then
	echo "You need to run this with superuser privileges. Try 'sudo $0'."
	exit 1
fi

ROOTDEV=$(findmnt -n -o SOURCE /)
ROOTPARTNO="${ROOTDEV: -1}"
[[ "$ROOTDEV" =~ "mmc" ]] && DISKDEV="${ROOTDEV::-2}" || DISKDEV="${ROOTDEV::-1}"

echo "Root is on $ROOTDEV (disk: $DISKDEV, partition: $ROOTPARTNO)."

# flash.txt's flash= setting, lower case.
install_mode() {
	sed -n 's/^[[:space:]]*flash[[:space:]]*=//Ip' /boot/settings/flash.txt 2>/dev/null |
		tr -d '\r"'"'"' \t' | tr 'A-Z' 'a-z' | tail -1
}

# The rest of the disk as partition ROOTPARTNO+1, exFAT (FAT32 if exfatprogs is
# missing), labelled OF-BACKUP.
make_backup_partition() {
	local PART i
	PART="$DISKDEV$((ROOTPARTNO + 1))"
	sync
	blockdev --flushbufs $DISKDEV
	# After the last partition, to the end of the disk; type 7 (exFAT). The disk is in
	# use, so the kernel is told of the new partition alone (partx), not the whole table.
	echo ",,7" | sfdisk --append --no-reread --force -q $DISKDEV > /dev/null 2>&1 || return 1
	partx -a -n $((ROOTPARTNO + 1)) $DISKDEV 2>/dev/null
	udevadm settle 2>/dev/null
	for i in $(seq 1 20); do [ -b "$PART" ] && break; sleep 0.25; done
	[ -b "$PART" ] || return 1
	if command -v mkfs.exfat > /dev/null; then
		mkfs.exfat -L OF-BACKUP "$PART" > /dev/null 2>&1 || return 1
	else
		mkfs.vfat -F 32 -n OF-BACKUP "$PART" > /dev/null 2>&1 || return 1
	fi
	udevadm settle 2>/dev/null
	echo "Made $PART into OF-BACKUP for the installer's backups; the system keeps its size."
}

# Not an installer, and never will be: flash.txt goes, so it isn't offered in the
# settings folder (of-installer.service doesn't start without it, or the image copy).
remove_flash_txt() {
	[ -e /boot/settings/flash.txt ] || return 0
	/usr/lib/openframe/bootrw open &&
		rm -f /boot/settings/flash.txt /boot/settings/._flash.txt && sync
	/usr/lib/openframe/bootrw close
	echo "Removed settings/flash.txt: this system can't be an installer stick."
}

MODE=$(install_mode)
if { [ "$MODE" = "yes" ] || [ "$MODE" = "again" ]; } && [ -f /usr/lib/openframe/install/image.img.gz ] &&
   [[ "$ROOTDEV" != *mmc* ]] && [ "$ROOTPARTNO" = 2 ]; then
	echo "An installer stick: making the rest of it OF-BACKUP rather than growing the system."
	make_backup_partition && exit 0
	# Not grown either: growing would end this stick's chance of being an installer.
	echo "Couldn't make OF-BACKUP; the system is left at its size."
	exit 1
fi

# Images built before November 2026 start /boot at sector 1, so the disk's first 4 KB
# holds the partition table and the start of /boot's FAT. growpart writes the table
# through the whole disk's own cache, 4 KB at a time, and an old copy of the FAT
# there would go back over the real one. So /boot's changes go to disk first and the
# whole disk's cached copy is dropped, making growpart read the disk afresh. (This
# runs once /boot is checked and mounted, read-only, before anything writes to it.)
sync
blockdev --flushbufs $DISKDEV

TMPDIR=/run growpart $DISKDEV $ROOTPARTNO > /dev/null
GPRET=$?
if [ $GPRET -eq 1 ]; then
	# The image already fills the disk: the 1 GB internal memory of an OpenFrame 1.
	# /tmp and apt's files stay in RAM there, to save space and wear.
	echo "Partition already at maximum size; keeping /tmp and apt's files in RAM."
	remove_flash_txt
	exit 0
elif [ $GPRET -ne 0 ]; then
	echo "growpart failed (exit $GPRET). Skipping filesystem resize."
	exit 1
fi

resize2fs $ROOTDEV > /dev/null
remove_flash_txt

# A bigger drive has room for /tmp and apt's files on disk, so drop their tmpfs.
sed -i '/\/var\/cache\/apt/d' /etc/fstab
sed -i '/\/var\/lib\/apt\/lists/d' /etc/fstab
sed -i -E '/^[^#[:space:]]+[[:space:]]+\/tmp[[:space:]]/d' /etc/fstab

echo "Done."

exit 0
