#!/usr/bin/env bash

## of-update v26.11.6 (26th November 2026)
##  Keeps the OpenFrame up to date by itself: Debian's updates, and OpenBeak's (Sprite,
##  these scripts, the kernel and the firmware), worked out and installed by of-update-apt
##  (/usr/lib/openframe, through python-apt, with the settings in
##  /etc/apt/apt.conf.d/52openframe-updates). Owners never have to log in for them.
##
##    of-update run night|catchup|now
##        The lists, then what to install, then the downloads, then the installing.
##        Everything is downloaded before anything is installed, so a download that's cut
##        off costs nothing; a power cut while installing is finished by of-dpkg-recover at
##        the next start, and mend puts right anything still missing. Run by of-update@.service:
##        "night" from of-update-night.timer, at the owner's quiet time (updates.txt, below),
##        which then restarts the unit if an update needs it, now or earlier in the day;
##        "catchup" from of-update-catchup.timer, ten minutes after each start, which does
##        nothing unless the last good run was over 20 hours ago, so a unit that's only on now
##        and then still catches up, or a package is half installed (a power cut part way
##        through an update), so it's put right as the unit comes back (see mend); "now" when someone asks (Sprite's Settings), which goes
##        straight to working out what to install (state preparing) if the lists were looked
##        at in the last 15 minutes, since this start.
##    of-update schedule
##        Sets of-update-night.timer to the time in OF-BOOT/settings/updates.txt (time=, by
##        the hour, 03:00 if it's not there), within half an hour of it, a minute of the
##        unit's own (of-update-schedule.service, at each start).
##    of-update set-time HH:MM
##        Writes that time to updates.txt and sets the timer to it (Sprite's Settings).
##    of-update check
##        Fetch the package lists and count what's waiting, without installing.
##    of-update status
##        key=value lines, for Sprite's helper: state (idle, checking, preparing, downloading,
##        installing), since, kind (check or update: which this run is), percent (how far
##        this state has got, where that can be measured), last (the last good run), result
##        (ok or failed), message,
##        pending (updates waiting at the last look), checked (when that was), and
##        restart=yes when an installed update takes effect only after a restart; notice, for a
##        fortnight after apps had to be removed to finish an update (which ones). Then the
##        updates themselves, an item= line each: package, new version, its tier, 1 once
##        it's installed, and the version it replaces (none for a new package). The tiers,
##        as Sprite shows them: "firmware" (openframe-firmware), "apps" (the app shop's
##        repository, or an ofapp- package), "openframe" (the rest of OpenBeak's: Sprite,
##        these scripts, the kernel) and "debian" (everything else). firmware=pending says
##        installed firmware will be flashed at the next start. partial= is how many are
##        unpacked but not configured yet (half in), and now= the one going in. And while
##        they download, got= and size= (bytes so far, and in all).
##    of-update news
##        What's new in OpenBeak's waiting updates, for Sprite: for each, a part= line
##        (package, new version, tier), then its notes newer than the version installed, a
##        news= line each: package, version, note, tab-separated. The notes are each
##        repository's news/<package>.news, beside its pool (from commits' News: trailers),
##        fetched when updates are looked for; the kernel's repository has none.
##    of-update reboot
##        Restart if an update needs it (/run/reboot-required: a new kernel, or firmware to
##        flash at the next start) and none is being installed. (The night's run restarts by
##        itself when one's needed.)
##    of-update after reboot|poweroff
##        Wait for an update that's being installed to finish, then restart or switch off
##        (Sprite's Power buttons while one is).
##
##  /run/of-update/state is the state now (anyone may read it: Sprite shows a sign in its
##  bar while an update installs). /var/lib/of-update/status keeps the rest between starts.

set -u
export LC_ALL=C DEBIAN_FRONTEND=noninteractive

RUNDIR="/run/of-update"
LOCK="/run/of-update.lock"
VARDIR="/var/lib/of-update"
STATUS="$VARDIR/status"
LIST="$VARDIR/pending.list" # what's waiting: package, version, tier, bytes to fetch, file, old version, where from
HELD="$VARDIR/held.list"    # what can't be installed by itself: package, why
APTHELPER="${OF_UPDATE_APT:-/usr/lib/openframe/of-update-apt}"
ARCHIVES="/var/cache/apt/archives"
NEWSDIR="$VARDIR/news"
CATCHUP_AFTER=$(( 20 * 3600 ))
FRESH=$(( 15 * 60 ))       # lists this new (since this start) aren't looked at again for "now"
APTSOURCES="${OF_UPDATE_APTSOURCES:-/etc/apt}" # (unless the sources there changed since)
TIMEFILE="/boot/settings/updates.txt"
DEFAULT_TIME="03:00"
DROPIN="/etc/systemd/system/of-update-night.timer.d/time.conf"

# The owner's quiet time, from updates.txt (time=3, 03:00, 15:00...), as HH:MM, or the default.
update_time() {
	local v
	v=$(sed -n 's/^[[:space:]]*time[[:space:]]*=[[:space:]]*//Ip' "$TIMEFILE" 2>/dev/null | tr -d '\r"'"'"' ' | head -1)
	if [[ "$v" =~ ^([01]?[0-9]|2[0-3])(:([0-5][0-9]))?$ ]]; then
		printf '%02d:%s\n' "$((10#${BASH_REMATCH[1]}))" "${BASH_REMATCH[3]:-00}"
	else
		echo "$DEFAULT_TIME"
	fi
}

log() { echo "of-update: $*"; }

# The state now: idle, checking, preparing, downloading or installing, and which kind of run this is (KIND: check or update). of-update-apt adds how it's going (percent and the rest) as it works.
set_state() {
	mkdir -p "$RUNDIR" && chmod 755 "$RUNDIR"
	printf 'state=%s\nsince=%s\nkind=%s\n' "$1" "$(date +%s)" "${KIND:-update}" > "$RUNDIR/state.new" &&
		chmod 644 "$RUNDIR/state.new" && mv -f "$RUNDIR/state.new" "$RUNDIR/state"
}

get() { sed -n "s/^$1=//p" "$STATUS" 2>/dev/null | head -1; }

# Sets key=value pairs in the status file, keeping the others.
put() {
	local tmp k
	mkdir -p "$VARDIR"
	tmp=$(mktemp "$VARDIR/.status.XXXXXX") || return
	cp "$STATUS" "$tmp" 2>/dev/null
	for kv in "$@"; do
		k="${kv%%=*}"
		sed -i "/^$k=/d" "$tmp"
		printf '%s\n' "$kv" >> "$tmp"
	done
	chmod 644 "$tmp" && mv -f "$tmp" "$STATUS"
}

# Works out what's waiting ($LIST, and $HELD for what can't be installed by itself): of-update-apt plan.
write_list() {
	"$APTHELPER" plan
}

# Fetches the owners' notes for each of OpenBeak's waiting updates (news/<package>.news, beside
# the pool of the repository it comes from), so they can be read before updating. Quietly: a
# repository without them (the kernel's) just has none, and an old copy is kept if the fetch
# fails.
fetch_news() {
	local P V T url
	mkdir -p "$NEWSDIR"
	[ -s "$LIST" ] || return 0
	while IFS=$'\t' read -r P V T _ _ _ url; do
		[ "$T" = debian ] && continue
		case "$url" in */pool/*) ;; *) continue ;; esac
		if curl -fsS --max-time 20 -o "$NEWSDIR/$P.news.new" "${url%%/pool/*}/news/$P.news" 2>/dev/null; then
			mv -f "$NEWSDIR/$P.news.new" "$NEWSDIR/$P.news"
		else
			rm -f "$NEWSDIR/$P.news.new"
		fi
	done < "$LIST"
}

# Drops from $LIST what's installed now (its new version in), leaving whatever didn't go in.
# Quick: asking apt again takes half a minute on an OF1, with everything already done.
prune_list() {
	[ -s "$LIST" ] || return 0
	local -A NOW
	local tmp P V REST
	while IFS=$'\t' read -r P V _; do NOW[$P]="$V"; done < <(cut -f1 "$LIST" | xargs dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null)
	tmp=$(mktemp "$VARDIR/.list.XXXXXX") || return
	while IFS=$'\t' read -r P V REST; do
		[ "${NOW[$P]:-}" = "$V" ] || printf '%s\t%s\t%s\n' "$P" "$V" "$REST"
	done < "$LIST" > "$tmp"
	chmod 644 "$tmp" && mv -f "$tmp" "$LIST"
}

# The package lists, a few tries: the network may only just be up. The clock first, as
# OpenFrames have no clock battery, and apt refuses a repository whose Release file looks
# like it comes from the future.
lists() {
	timeout 120 systemctl start time-sync.target >/dev/null 2>&1 || true
	local out
	for try in 1 2 3; do
		# of-update-apt lists fails if any list wasn't fetched, as apt-get update --error-on=any
		# does: otherwise, offline, with the lists empty after a start (tmpfs), the run found
		# nothing waiting and called it a good update, putting the catch-up off for a day
		local rc=0
		out=$("$APTHELPER" lists 2>&1) || rc=$?
		(( rc == 0 )) && return 0
		# A test unit whose testing suites aren't all there yet (a repository makes its own at
		# its first publish to testing) still takes everything else: every error about a
		# testing suite (apt's line after any failure names none). Likewise the apps repository:
		# a fault there holds back the apps, never the system's own updates.
		# (only its own report of lists not fetched, exit 100 with E: lines: anything else, a crash, is a failure)
		if (( rc == 100 )) && grep -q '^E:' <<< "$out" && ! grep '^E:' <<< "$out" | grep -v 'Some index files failed to download' | grep -v -e '-testing' -e 'apps\.openbeak\.net' | grep -q .; then
			log "a testing suite or the apps repository not there: $(grep '^E:' <<< "$out" | head -1)"
			return 0
		fi
		(( try < 3 )) && sleep 60
	done
	return 1
}

# Whether an earlier update was left half done: dpkg's work unfinished, or a package in without
# what it needs (see mend).
half_done() {
	[ -n "$(dpkg --audit 2>/dev/null)" ] || ! apt-get check -qq -o Debug::NoLocking=1 >/dev/null 2>&1
}

# Puts right what an interrupted update left, before anything else is done: a power cut or a
# full disk part way through can leave dpkg's work unfinished, or a package in without what it
# needs (Sprite unpacked, the openframe-scripts it needs not yet), and then apt refuses to
# upgrade anything at all (a cache with broken packages), and nothing's ever updated again. dpkg's work is finished, then what's missing installed, if apt says that takes only
# installing; if it would remove anything, that's left to a person (or an erase). True if all
# is well now.
mend() {
	if [ -n "$(dpkg --audit 2>/dev/null)" ]; then
		log "an earlier update didn't finish: finishing it"
		dpkg --force-confdef --force-confold --configure -a < /dev/null >/dev/null 2>&1
	fi
	apt-get check -qq -o Debug::NoLocking=1 >/dev/null 2>&1 && return 0
	local SIM GONE
	SIM=$(apt-get -s -o Debug::NoLocking=1 -f install 2>/dev/null) || { log "a package is half installed, and apt can't say how to put it right"; return 1; }
	GONE=$(removals "$SIM")
	if ! only_apps "$GONE"; then
		log "a package is half installed, and putting it right would remove $GONE: left as it is"
		MEND_WHY="it would remove $GONE"
		return 1
	fi
	log "a package is half installed: installing what it needs, $(grep '^Inst ' <<< "$SIM" | cut -d' ' -f2 | tr '\n' ' ')${GONE:+(removing $GONE)}"
	set_state installing
	DEBIAN_FRONTEND=noninteractive apt-get -y -q -o Dpkg::Options::=--force-confold -f install >/dev/null 2>&1 &&
		apt-get check -qq >/dev/null 2>&1 || return 1
	apps_removed "$GONE"
}

# What apt would remove to do what it printed in $1 (its -s output), a word each.
removals() {
	grep '^Remv ' <<< "$1" | cut -d' ' -f2 | tr '\n' ' ' | sed 's/ $//'
}

# Whether everything in $1 (a list of packages) may be removed to finish an update: apps (the
# app shop's, ofapp-*) may, and can be installed again; the system's own packages never are.
only_apps() {
	local p
	for p in $1; do [[ $p == ofapp-* ]] || return 1; done
	return 0
}

# Apps ($1) removed to finish an update: said on Sprite's Updates tab for a fortnight (notice),
# so a tile gone from the home screen isn't a mystery.
apps_removed() {
	[ -n "$1" ] || return 0
	local names
	names=$(sed 's/ofapp-//g; s/ /, /g' <<< "$1")
	log "removed to finish an update: $1"
	put "notice=$names had to be removed to finish an update: install it again from the shop" "noticed=$(date +%s)"
}

# What of-update-apt held back ($HELD): each package, and why it can't be installed by itself (it would remove a system package). Empty if nothing is.
held_back() {
	[ -s "$HELD" ] || return 0
	awk -F'\t' '{ printf "%s%s (%s)", (NR > 1 ? ", " : ""), $1, $2 }' "$HELD"
}

# How many updates are waiting: those that can go in, and those held back.
waiting() {
	echo $(( $(wc -l < "$LIST") + $( [ -s "$HELD" ] && wc -l < "$HELD" || echo 0 ) ))
}

# Whether apt's sources have changed since time $1 (a unit made a test unit just now, say): what
# was looked at then isn't all there is to have, so "now" looks again. The folder's own time
# changes as a list comes or goes.
sources_changed() {
	local f t
	for f in "$APTSOURCES/sources.list" "$APTSOURCES/sources.list.d" "$APTSOURCES"/sources.list.d/*; do
		[ -e "$f" ] || continue
		t=$(stat -c %Y "$f" 2>/dev/null) || continue
		(( t >= $1 )) && return 0
	done
	return 1
}

# At the owner's quiet time, after the night's run (however it went), the restart an update
# needs: this night's, or one installed by hand during the day.
# The apps installed, a line each, package and version (for services_after)
app_versions() { dpkg-query -W -f '${db:Status-Abbrev} ${Package} ${Version}\n' 'ofapp-*' 2>/dev/null | awk '$1 ~ /^.i/ { print $2, $3 }' | sort; }

# Background services (the interface's kind=service apps, running as sprite-service-<id>) whose package an update changed: one switched on starts again from the new version (its files were replaced under it), through the interface's helper, which starts it as the manifest now says; one whose package went is stopped (it would otherwise be started again and again from files no longer there).
services_after() {
	local before=$1 after pkg id unit helper=/opt/sprite/libexec/sprite-helper
	after=$(app_versions)
	[ "$before" = "$after" ] && return 0
	while read -r pkg _; do
		[ -n "$pkg" ] || continue
		id=${pkg#ofapp-} unit=sprite-service-${pkg#ofapp-}.service
		[[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
		# (running, or between tries: Restart=on-failure)
		case "$(systemctl show -P ActiveState "$unit" 2>/dev/null)" in active|activating|reloading) ;; *) continue ;; esac
		if grep -q "^$pkg " <<< "$after"; then
			log "$id, a service, updated: starting it again"
			systemctl stop "$unit" 2>/dev/null
			[ -x "$helper" ] && echo "service-set $id on" | "$helper" >/dev/null 2>&1
		else
			log "$id, a service, removed: stopping it"
			systemctl stop "$unit" 2>/dev/null
		fi
	done < <(comm -23 <(echo "$before") <(echo "$after"))
}

night_restart() {
	[ -e /run/reboot-required ] || return 0
	log "restarting to finish updating ($(tr '\n' ' ' < /run/reboot-required.pkgs 2>/dev/null))"
	exec 9>&-
	systemctl reboot
}

# True if an update is being installed (another of-update holds the lock).
running() {
	! ( flock -n 8 ) 8>"$LOCK"
}

fail() {
	log "$1"
	put "result=failed" "message=$1"
	exit 1
}

case "${1:-}" in
run)
	REASON="${2:-now}"
	case "$REASON" in night|catchup|now) ;; *) echo "usage: of-update run night|catchup|now" >&2; exit 2 ;; esac
	if [ "$REASON" = catchup ]; then
		LAST=$(get last)
		if half_done; then
			log "an earlier update was left half done: putting it right"
		elif [ -n "$LAST" ] && (( $(date +%s) - LAST >= 0 && $(date +%s) - LAST < CATCHUP_AFTER )); then
			exit 0
		else
			log "the last update was $( [ -n "$LAST" ] && echo "$(( ($(date +%s) - LAST) / 3600 )) hours ago" || echo never): catching up"
		fi
	fi
	# Not while OpenFrame Flash installs from this stick (its system is the stick's, which
	# isn't grown, and the night run restarts): it's a oneshot, so "activating" as it works
	case "$(systemctl show -p ActiveState --value of-flash.service 2>/dev/null)" in
		active|activating) log "OpenFrame Flash is at work: no update now"; exit 0 ;;
	esac
	exec 9>"$LOCK"
	flock -n 9 || { log "an update is already running"; exit 0; }
	trap 'set_state idle; [ "$REASON" = night ] && night_restart' EXIT
	KIND=update
	CHECKED=$(get checked)
	UP=$(cut -d. -f1 /proc/uptime)
	if [ "$REASON" = now ] && [ -n "$CHECKED" ] && (( $(date +%s) - CHECKED >= 0 && $(date +%s) - CHECKED < FRESH && $(date +%s) - CHECKED < UP )) &&
	   ! sources_changed "$CHECKED"; then
		# looked at just now (Check now): not again, straight to what's to install
		set_state preparing
	else
		set_state checking
		lists || fail "the update servers couldn't be reached"
	fi
	set_state preparing
	MEND_WHY=""
	mend || fail "an earlier update was left half done, and can't be put right by itself${MEND_WHY:+ ($MEND_WHY)}"
	# Worked out, downloaded and installed in one go (of-update-apt upgrade writes the list as it plans, then sets the state to downloading and installing); then the notes for whatever's still waiting
	APPS_BEFORE=$(app_versions)
	"$APTHELPER" upgrade
	OK=$?
	services_after "$APPS_BEFORE"
	GONE=$(cat "$VARDIR/apps-removed" 2>/dev/null)
	apt-get clean
	prune_list
	fetch_news
	put "checked=$(date +%s)" "pending=$(waiting)"
	(( OK == 1 )) && fail "the updates couldn't all be downloaded"
	(( OK == 2 )) && fail "some updates didn't install"
	(( OK == 0 )) || fail "the updates couldn't be worked out"
	apps_removed "$GONE"
	KEPT=$(held_back)
	N=$(waiting)
	put "pending=$N"
	(( N == 0 )) || fail "$N update$( (( N > 1 )) && echo s) can't be installed by $( (( N > 1 )) && echo themselves || echo itself): ${KEPT:-$(cut -f1 "$LIST" | tr '\n' ' ')}"
	put "last=$(date +%s)" "result=ok" "message="
	log "up to date$( [ -e /run/reboot-required ] && echo ", once it restarts")"
	;;
schedule)
	T=$(update_time)
	NEW=""
	[ "$T" != "$DEFAULT_TIME" ] &&
		NEW=$(printf '# From OF-BOOT/settings/updates.txt (of-update schedule): the owner'"'"'s quiet time.\n[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00' "$T")
	if [ "$(cat "$DROPIN" 2>/dev/null)" != "$NEW" ]; then
		if [ -n "$NEW" ]; then
			mkdir -p "${DROPIN%/*}"
			printf '%s\n' "$NEW" > "$DROPIN"
		else
			rm -f "$DROPIN"
		fi
		systemctl daemon-reload
		systemctl try-restart of-update-night.timer
		log "updates at about $T"
	fi
	;;
set-time)
	[[ "${2:-}" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || { echo "usage: of-update set-time HH:MM" >&2; exit 2; }
	NEWF=$(mktemp)
	if [ -r "$TIMEFILE" ] && grep -qi '^[[:space:]]*time[[:space:]]*=' "$TIMEFILE"; then
		sed -E "s/^[[:space:]]*[Tt][Ii][Mm][Ee][[:space:]]*=.*/time=$2/" "$TIMEFILE" > "$NEWF"
	elif [ -r /usr/lib/openframe/settings/updates.txt ]; then
		sed -E "s/^time=.*/time=$2/" /usr/lib/openframe/settings/updates.txt > "$NEWF"
	else
		echo "time=$2" > "$NEWF"
	fi
	/usr/lib/openframe/bootrw open && cp "$NEWF" "$TIMEFILE.new" && sync && mv -f "$TIMEFILE.new" "$TIMEFILE" && sync
	/usr/lib/openframe/bootrw close
	rm -f "$NEWF"
	"$0" schedule
	;;
check)
	exec 9>"$LOCK"
	flock -n 9 || { log "an update is running"; exit 0; }
	KIND=check
	trap 'set_state idle' EXIT
	set_state checking
	lists || fail "the update servers couldn't be reached"
	# half installed (see mend): nothing can be worked out until it's put right, which is
	# Update now's to do (a check changes nothing); never "up to date"
	if half_done; then
		put "checked=$(date +%s)" "pending=0"
		fail "an earlier update was left half done: trying again puts it right, and the next update does by itself"
	fi
	set_state preparing
	write_list || fail "the updates couldn't be worked out"
	fetch_news
	put "checked=$(date +%s)" "pending=$(waiting)"
	;;
status)
	STATE=idle SINCE=""
	if [ -r "$RUNDIR/state" ]; then
		STATE=$(sed -n 's/^state=//p' "$RUNDIR/state")
		SINCE=$(sed -n 's/^since=//p' "$RUNDIR/state")
	fi
	# A state left behind by a run that was killed: nobody holds the lock.
	[ "$STATE" != idle ] && ! running && STATE=idle
	echo "state=${STATE:-idle}"
	echo "since=$SINCE"
	# how this state is going (of-update-apt's, and the lists'), while there's a run
	SGOT="" SSIZE="" SNOW=""
	if [ "$STATE" != idle ]; then
		echo "kind=$(sed -n 's/^kind=//p' "$RUNDIR/state")"
		P=$(sed -n 's/^percent=//p' "$RUNDIR/state"); [ -n "$P" ] && echo "percent=$P"
		SGOT=$(sed -n 's/^got=//p' "$RUNDIR/state"); SSIZE=$(sed -n 's/^size=//p' "$RUNDIR/state")
		SNOW=$(sed -n 's/^now=//p' "$RUNDIR/state")
	fi
	for k in last result message pending checked; do echo "$k=$(get $k)"; done
	# apps removed to finish an update (apps_removed), for a fortnight
	N=$(get noticed)
	[ -n "$N" ] && (( $(date +%s) - N < 14 * 86400 )) && echo "notice=$(get notice)"
	echo "restart=$( [ -e /run/reboot-required ] && echo yes || echo no)"
	echo "firmware=$(grep -qx openframe-firmware /run/reboot-required.pkgs 2>/dev/null && echo pending || echo no)"
	echo "time=$(update_time)"
	if [ -s "$LIST" ]; then
		# Each update, and whether it's in yet (its version now installed), or half in (unpacked,
		# not configured yet: partial=, so even one package shows progress).
		declare -A NOW ST
		while IFS=$'\t' read -r P V A; do NOW[$P]="$V"; ST[$P]="$A"; done < <(cut -f1 "$LIST" | xargs dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Abbrev}\n' 2>/dev/null)
		GOT=0 SIZE=0 PART=0 CURRENT=""
		while IFS=$'\t' read -r P V G B F OLD _; do
			IN=0
			if [ "${NOW[$P]:-}" = "$V" ]; then
				case "${ST[$P]:-}" in ii*) IN=1 ;; *) PART=$((PART + 1)); CURRENT=${CURRENT:-$P} ;; esac
			fi
			echo "item=$P $V $G $IN ${OLD:-none}"
			if [ "$STATE" = downloading ] && (( B > 0 )); then
				SIZE=$(( SIZE + B ))
				if [ -e "$ARCHIVES/$F" ]; then GOT=$(( GOT + B ))
				elif [ -e "$ARCHIVES/partial/$F" ]; then GOT=$(( GOT + $(stat -c %s "$ARCHIVES/partial/$F") ))
				fi
			fi
		done < "$LIST"
		# (of-update-apt's count of the bytes, if it has started)
		[ -n "$SSIZE" ] && (( SSIZE > 0 )) && GOT=$SGOT SIZE=$SSIZE
		[ "$STATE" = downloading ] && echo "got=$GOT" && echo "size=$SIZE"
		echo "partial=$PART"
		CURRENT=${SNOW:-$CURRENT}
		[ -n "$CURRENT" ] && echo "now=$CURRENT"   # the one going in now
	fi
	;;
news)
	[ -s "$LIST" ] || exit 0
	while IFS=$'\t' read -r P V T _; do
		[ "$T" = debian ] && continue
		printf 'part=%s %s %s\n' "$P" "$V" "$T"
		[ -s "$NEWSDIR/$P.news" ] || continue
		NOW=$(dpkg-query -W -f='${Version}' "$P" 2>/dev/null)
		# newest first: the notes from the waiting version back to (not including) the one in
		while IFS=$'\t' read -r NV NOTE; do
			dpkg --compare-versions "$NV" le "$V" || continue
			[ -n "$NOW" ] && dpkg --compare-versions "$NV" le "$NOW" && break
			printf 'news=%s\t%s\t%s\n' "$P" "$NV" "$NOTE"
		done < "$NEWSDIR/$P.news"
	done < "$LIST"
	;;
reboot)
	[ -e /run/reboot-required ] || exit 0
	if running; then
		log "a restart is needed, but an update is being installed: not now"
		exit 0
	fi
	log "restarting to finish updating ($(tr '\n' ' ' < /run/reboot-required.pkgs 2>/dev/null))"
	systemctl reboot
	;;
after)
	case "${2:-}" in reboot|poweroff) ;; *) echo "usage: of-update after reboot|poweroff" >&2; exit 2 ;; esac
	exec 9>"$LOCK"
	flock 9 # waits for the update being installed
	exec 9>&-
	systemctl "$2"
	;;
*)
	sed -n 's/^##//p' "$0"
	exit 2
	;;
esac
