#!/usr/bin/env bash

## ssh-settings v26.11.1 (22nd November 2026)
##  Applies OF-BOOT/settings/ssh.txt (/boot/settings/ssh.txt) at each start, before the
##  SSH server, for of-ssh-settings.service:
##    password=  set as the password of "of" (for SSH), then emptied in the file,
##               so it's never left on the boot volume, which anyone can read (FAT has no
##               permissions). Empty: the password stays as it is.
##    key=       public keys that may log in as "of", one a line. They go in a block of
##               their own in ~of/.ssh/authorized_keys, replaced each time; keys added
##               there by hand, outside it, stay.
##  Images give "of" no password: until one is set, here or in sprite's Settings, SSH
##  needs a key. They used to give every unit the same one.
##  "ssh-settings check" is ssh.service's ExecCondition (ssh.service.d/openframe.conf): the
##  SSH server starts only once someone could log in, so a new unit doesn't listen with no
##  way in. It's true (0) if root has a key, or a person's account (uid 1000 and up, with a
##  shell) has a password or a key; false (1, and systemd skips the server) if not. sprite
##  starts the server when its Settings set a password.
##  On a flash stick (one that carries the image copy, for OpenFrame Flash), the password
##  is set but stays in the file: Flash copies the stick's settings to each unit it
##  installs, and each then sets it and empties it in its own.
##  Values are read as of-netplan reads its files: the key's case and spaces around it
##  don't matter, and one pair of matching quotes is taken off.

USERNAME="of"
SETTINGS="/boot/settings/ssh.txt"
FLASHTXT="/boot/settings/flash.txt"
BEGIN="# from OF-BOOT settings/ssh.txt (ssh-settings replaces this block at each start)"
END="# end of the keys from ssh.txt"

log() { echo "ssh-settings: $*"; }

# True on a flash stick (flash=yes or again in settings/flash.txt).
# Not the image copy: every release stick carries that until its system fills up, so the
# password stayed in the file, and was set again at each start over one set since.
flash_stick() {
	local M
	M=$(sed -n 's/^[[:space:]]*flash[[:space:]]*=//Ip' "$FLASHTXT" 2>/dev/null |
		tr -d '\r"'"'"' \t' | tr 'A-Z' 'a-z' | tail -1)
	[ "$M" = "yes" ] || [ "$M" = "again" ]
}

# A key in a home's authorized_keys (or authorized_keys2), options before it or not.
has_key() {
	cat "$1/.ssh/authorized_keys" "$1/.ssh/authorized_keys2" 2>/dev/null | grep -v '^[[:space:]]*#' |
		grep -q -E '(^|[[:space:]])(ssh-(ed25519|rsa|dss)|ecdsa-sha2-nistp[0-9]+|sk-[a-z0-9-]+@openssh\.com) '
}

# Whether anyone can log in over SSH: root by key (its password isn't allowed), or a person
# by password or key.
can_log_in() {
	local name uid home shell hash
	has_key /root && return 0
	while IFS=: read -r name _ uid _ _ home shell; do
		(( uid >= 1000 && uid < 60000 )) || continue
		case "$shell" in */nologin|*/false|'') continue ;; esac
		hash=$(getent shadow "$name" | cut -d: -f2)
		case "$hash" in ''|'*'|'!'*|x) ;; *) return 0 ;; esac
		has_key "$home" && return 0
	done < <(getent passwd)
	return 1
}

if [ "${1:-}" = check ]; then
	can_log_in && exit 0
	echo "ssh-settings: nobody can log in yet (no password or key): the SSH server stays off"
	exit 1
fi

[ -r "$SETTINGS" ] || exit 0
getent passwd "$USERNAME" >/dev/null || { log "no user $USERNAME"; exit 0; }
HOMEDIR=$(getent passwd "$USERNAME" | cut -d: -f6)

PASS=""
KEYS=()
while IFS= read -r line || [ -n "$line" ]; do
	line="${line%$'\r'}"
	line="${line#$'\xef\xbb\xbf'}"
	[[ "$line" == *=* && "$line" != \#* ]] || continue
	k="${line%%=*}"
	v="${line#*=}"
	k="${k//[[:space:]]/}"
	k="${k,,}"
	v="${v#"${v%%[![:space:]]*}"}"
	v="${v%"${v##*[![:space:]]}"}"
	if (( ${#v} >= 2 )) && [[ ${v:0:1} == [\"\'] && ${v: -1} == "${v:0:1}" ]]; then
		v="${v:1:${#v}-2}"
	fi
	case "$k" in
		password) PASS="$v" ;;
		key) [ -n "$v" ] && KEYS+=("$v") ;;
	esac
done < "$SETTINGS"

# The password: set, then emptied in the file (a synced copy renamed into place, with the
# boot volume writable only while that happens).
if [ -n "$PASS" ]; then
	if [[ "$PASS" =~ [[:cntrl:]] ]]; then
		log "the password in ssh.txt has control characters in it: not set"
	elif (( ${#PASS} < 8 || ${#PASS} > 64 )); then
		# as Settings asks: SSH listens on the network once there's a password, and "of"
		# can use sudo, so not one that's guessed in a few tries
		log "the password in ssh.txt isn't 8 to 64 characters: not set"
	elif ! printf '%s:%s\n' "$USERNAME" "$PASS" | chpasswd; then
		log "chpasswd refused the password in ssh.txt"
	elif flash_stick; then
		log "password for $USERNAME set from ssh.txt; a flash stick, so it stays there, for the units it installs"
	else
		log "password for $USERNAME set from ssh.txt"
		NEW=$(mktemp) && trap 'rm -f "$NEW"' EXIT &&
		awk 'index($0, "=") {
				k = substr($0, 1, index($0, "=") - 1); gsub(/[[:space:]]/, "", k)
				if (tolower(k) == "password" && $0 !~ /^[[:space:]]*#/) { print "password="; next }
			}
			{ print }' "$SETTINGS" > "$NEW" || { log "couldn't empty the password in ssh.txt"; NEW=""; }
		if [ -n "$NEW" ] && /usr/lib/openframe/bootrw open; then
			cp "$NEW" "$SETTINGS.new" && sync && mv -f "$SETTINGS.new" "$SETTINGS" && sync ||
				log "couldn't empty the password in ssh.txt"
			/usr/lib/openframe/bootrw close
		fi
	fi
fi
unset PASS

# The keys: only lines that look like OpenSSH public keys (a type, then base64).
VALID=()
for key in "${KEYS[@]}"; do
	if [[ "$key" =~ ^(ssh-(ed25519|rsa|dss)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)\ [A-Za-z0-9+/]+=*(\ .*)?$ ]] &&
	   [[ ! "$key" =~ [[:cntrl:]] ]]; then
		VALID+=("$key")
	else
		log "ignoring a key= line that isn't an SSH public key"
	fi
done
AK="$HOMEDIR/.ssh/authorized_keys"
if (( ${#VALID[@]} )) || { [ -f "$AK" ] && grep -qxF "$BEGIN" "$AK"; }; then
	install -d -m 700 -o "$USERNAME" -g "$(id -gn "$USERNAME")" "$HOMEDIR/.ssh"
	NEWAK=$(mktemp)
	if [ -f "$AK" ]; then
		awk -v b="$BEGIN" -v e="$END" '$0 == b { skip = 1; next } skip && $0 == e { skip = 0; next } !skip' "$AK" > "$NEWAK"
	fi
	if (( ${#VALID[@]} )); then
		{ echo "$BEGIN"; printf '%s\n' "${VALID[@]}"; echo "$END"; } >> "$NEWAK"
	fi
	install -m 600 -o "$USERNAME" -g "$(id -gn "$USERNAME")" "$NEWAK" "$AK.new" && mv -f "$AK.new" "$AK"
	rm -f "$NEWAK"
	log "${#VALID[@]} key(s) from ssh.txt for $USERNAME"
fi
exit 0
