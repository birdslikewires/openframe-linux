#!/bin/sh
# light-sensor (71-of-light-sensor.rules): creates the light sensor device, openframe-als at
# 0x34, on the SMBus adapter whose /sys path udev gives in $1. The OpenFrame 1 and 2 both have
# the sensor there. The kernel driver then publishes the reading under /sys/bus/iio/devices
# (in_illuminance_raw), and readlightsensor prints it. Only with a kernel that has the driver.

A="/sys$1"
N="${A##*/i2c-}-0034"

modprobe -q openframe-als 2>/dev/null || exit 0
[ -e "$A/$N" ] && exit 0
echo openframe-als 0x34 > "$A/new_device" 2>/dev/null || exit 0

# No reply, so no sensor: take the device away again, and the address stays free.
[ -e "$A/$N/driver" ] || echo 0x34 > "$A/delete_device" 2>/dev/null
exit 0
