# OpenFrame Flash, on a flash stick (flash=yes in OF-BOOT/settings/flash.txt):
# installs this system onto an OpenFrame 1's internal memory, after backing it and the
# firmware up (/usr/lib/openframe/flash/flash). At every other start it does nothing, in
# a moment, but remove the image copy from a stick in use as a system that's short of
# room (of-expand removes such a stick's flash.txt as it grows, hence the second
# condition). Before the firmware update: the backup comes first, and it's the
# flash that says when the update may run.
[Unit]
Description=OpenFrame Flash, for the internal memory
ConditionPathExists=|/boot/settings/flash.txt
ConditionPathExists=|/usr/lib/openframe/flash/image.img.gz
After=local-fs.target systemd-udevd.service
Before=of-firmware.service of-mac-reboot.service getty@tty1.service of-provision.service
Before=systemd-user-sessions.service display-manager.service startx.service xinit.service

[Service]
Type=oneshot
ExecStart=/usr/lib/openframe/flash/flash boot
# Backing up and writing the internal memory takes minutes.
TimeoutStartSec=infinity
# A shutdown asked for while the firmware is written waits for it (the flash and
# of-firmware-update hold off the stop signal until it's done), and is never followed
# by a kill, which would stop it between blocks. At any other step the stop signal
# stops the flash at once, and the next start carries on from its last step.
TimeoutStopSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
