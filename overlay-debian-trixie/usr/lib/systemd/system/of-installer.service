# The installer on an installer stick (install=yes in OF-BOOT/settings/install.txt):
# installs this system onto an OpenFrame 1's internal memory, after backing it and the
# firmware up (/usr/lib/openframe/installer). It does nothing, in a moment, at every
# other start. Before the firmware update: the backup comes first, and it's the
# installer that says when the update may run.
[Unit]
Description=OpenFrame installer for the internal memory
ConditionPathExists=/boot/settings/install.txt
After=local-fs.target systemd-udevd.service
Before=of-firmware.service of-mac-reboot.service getty@tty1.service of-provision.service
Before=systemd-user-sessions.service display-manager.service startx.service xinit.service

[Service]
Type=oneshot
ExecStart=/usr/lib/openframe/installer boot
# Backing up and writing the internal memory takes minutes.
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
